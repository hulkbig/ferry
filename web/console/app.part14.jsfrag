`.trim().split('\n').filter(Boolean).map(line=>{const i=line.indexOf('|');return [line.slice(0,i),line.slice(i+1)]}));
const consoleOriginalText=new WeakMap();
// Match complete retained messages before splitting sentences or middle dots:
// captured identifiers, catalog versions and timestamps are opaque values.
const consoleRetainedMessagePatterns=[
 [/^Request (req[-_][\w-]+)$/,id=>'请求 '+id],
 [/^Provider Attempt #(\d*)( Failed| Succeeded)?$/,(n,status)=>'渠道尝试 #'+n+(status===' Failed'?' 失败':status===' Succeeded'?' 成功':'')],
 [/^(Conversation Route|Cache Affinity|Caller Affinity|Affinity Route) (Found|Reused|Not Reused)$/,(scope,status)=>({Found:'已找到',Reused:'已复用','Not Reused':'未复用'}[status])+({'Conversation Route':'会话路由','Cache Affinity':'缓存亲和性','Caller Affinity':'调用方亲和性','Affinity Route':'亲和路由'}[scope])],
 [/^Runtime: (Healthy|Protected|Degraded|Unavailable|Recovering|Active|Disabled|Unknown)$/,status=>'运行状态：'+translatedConsoleText(status)],
 [/^Automatically created for upstream model ([\s\S]+)$/,model=>'为上游模型自动创建：'+model],
 [/^Execution Trace of client requests\. (\d+) total match\. Exports include every matching row with exact ledger values\.$/,n=>'客户端请求的执行轨迹。共 '+n+' 条匹配记录。导出包含全部匹配记录及精确账本数值。'],
 [/^(\d+) total match\.$/,n=>'共 '+n+' 条匹配记录。'],
 [/^Page (\d+) \/ (\d+)$/,(page,total)=>'第 '+page+' / '+total+' 页'],
 [/^Cache ↓ (—|[\d,.]+) · (—|[\d.]+%)$/,(tokens,percent)=>'缓存 ↓ '+tokens+' · '+percent],
 [/^(—|[\d,.]+) req\/min$/,n=>n+' 次/分钟'],
 [/^(Scheduled updates enabled|Schedule paused) · (\d+) prices · (Cached \/ awaiting update|Current)$/,(schedule,n,status)=>translatedConsoleText(schedule)+' · '+n+' 条价格 · '+translatedConsoleText(status)],
 [/^(\d+) prices$/,n=>n+' 条价格'],
 [/^Last success (.+) · Next update (.+)$/,(last,next)=>'上次成功 '+last+' · 下次更新 '+(next==='Paused'?'已暂停':next)],
 [/^Updated (—|[\d/.,:\-\sAPM年月日上下午时分秒\u200e\u200f]+)( · Cached \/ awaiting refresh)?( · Above [\d,]+ input tokens)?$/,(date,cached,tier)=>'更新于 '+date+(cached?' · 使用缓存 / 等待刷新':'')+(tier?' · 超过 '+tier.match(/[\d,]+/)[0]+' 个输入 Token':'')],
 [/^Reference · (.+?)( · Cached)?$/,(source,cached)=>'参考 · '+source+(cached?' · 已缓存':'')],
 [/^Above ([\d,]+) input tokens$/,n=>'超过 '+n+' 个输入 Token'],
 [/^(.+) · (Active|Disabled|Revoked) · Last 30 days$/,(preview,status)=>preview+' · '+translatedConsoleText(status)+' · 近 30 天'],
 [/^Created (.+) · Last activity (.+)$/,(created,activity)=>'创建于 '+created+' · 最近活动 '+(activity==='never recorded'?'从未记录':activity.replace(/ \(key-level activity\)$/, '（密钥级活动）'))],
 [/^Models: (.*?) · Protocols: (.*?) · Expires: (.*?) · (Unlimited|[\d,.]+) RPM · Budget (Unlimited|[\d,.]+)$/,(models,protocols,expires,rpm,budget)=>'模型：'+(models==='All models'?'全部模型':models)+' · 协议：'+(protocols==='All'?'全部':protocols)+' · 到期：'+(expires==='Never'?'永不':expires)+' · '+(rpm==='Unlimited'?'不限':rpm)+' RPM · 预算 '+(budget==='Unlimited'?'不限':budget)],
];
// Lowercase wire enums are only translated inside status badges / policy cells.
const consoleBadgeMessages={received:'已接收',waiting:'排队中',active:'执行中',recovering:'恢复中',streaming:'流式传输中',delivering:'交付中',ACTIVE:'有效',GRACE:'宽限期',REVOKED:'已撤销',RETIRED:'已退役',EXPIRED:'已过期'};
// Only known product messages are translated; identifiers and server diagnostics
// keep their source text. Composite labels are assembled from the same dictionary.
const consoleMessagePatterns=[
 [/^(\d+) legacy credentials$/,n=>n+' 组旧版凭据'],
 [/^(.+) subscription usage$/,name=>name+' 订阅用量'],
 [/^(.+) used$/,label=>translatedConsoleText(label)+' 已用'],
 [/^(.*) Recovery time is not reported\.$/,reason=>reason+' 未提供恢复时间。'],
 [/^(\d+) of (\d+) reset credits listed\.$/,(returned,total)=>'已显示 '+returned+' / '+total+' 张重置券。'],
 [/^Resets (.+)$/,date=>'重置于 '+date],
 [/^(\d+)-(day|hour|minute|second) limit$/,(n,unit)=>n+' '+({day:'天',hour:'小时',minute:'分钟',second:'秒'}[unit])+'额度'],
 [/^(\d+)h remaining$/,n=>'剩余 '+n+' 小时'],
 [/^(\d+)d (\d+)h remaining$/,(d,h)=>'剩余 '+d+' 天 '+h+' 小时'],
 [/^Windows reset: (\d+)$/,n=>'已重置窗口数：'+n],
 [/^More actions for (.+)$/,name=>name+' 的更多操作'],
 [/^Disable logical model (.+)\?$/,name=>'停用逻辑模型 '+name+'？'],
 [/^Disable (.+)\?$/,name=>'停用 '+name+'？'],
 [/^Delete connection (.+)\?$/,name=>'删除连接 '+name+'？'],
 [/^Delete logical model (.+)\?$/,name=>'删除逻辑模型 '+name+'？'],
 [/^Delete provider (.+)\?$/,name=>'删除渠道 '+name+'？'],
 [/^Restore revision #(\d+)\? The server will validate, review, and apply it as a new immutable revision\.$/,n=>'恢复版本 #'+n+'？服务端将校验、审核并作为新的不可变版本应用。'],
 [/^Upstream supply: (.+)\.$/,names=>'上游模型：'+names+'。'],
 [/^(\d+) active conversation bindings may be affected\.$/,n=>n+' 个活动会话绑定可能受影响。'],
 [/^Ferry will automatically disable it and remove (\d+) route steps? and (\d+) conditional rules?\.$/,(routes,rules)=>'Ferry 将自动停用此模型，移除 '+routes+' 个路由步骤和 '+rules+' 条条件规则。'],
 [/^Ferry will automatically disable it, delete its endpoint and credential configuration, and detach it from these Logical Model routes: (.+)\.$/,names=>'Ferry 将自动停用此渠道，删除端点和凭据配置，并从以下逻辑模型路由中移除：'+names+'。'],
 [/^(\d+) configured$/,n=>n+' 个已配置'],
 [/^(\d+) converted$/,n=>n+' 个可转换'],
 [/^(\d+) fallback$/,n=>n+' 个回退'],
 [/^(\d+) discovered$/,n=>'发现 '+n+' 个'],
 [/^(\d+) added$/,n=>'新增 '+n+' 个'],
 [/^(\d+) Logical Models created$/,n=>'创建 '+n+' 个逻辑模型'],
 [/^Logical model routes affected: (.+)\.$/,names=>'受影响的逻辑模型路由：'+names+'。'],
 [/^(.+) stays first; these paths are tried only when its native path is unavailable\.$/,protocol=>protocol+' 优先，仅在其原生路径不可用时尝试这些路径。'],
 [/^Remove (.+)$/,name=>'移除 '+name],
 [/^Retry in (\d+)s$/,seconds=>seconds+' 秒后重试'],
 [/^Unlimited concurrency · FIFO wait up to (\d+)s$/,seconds=>'不限并发 · FIFO 最长等待 '+seconds+' 秒'],
 [/^Client (.+) → Ferry → Native (.+)$/, (client,native)=>'客户端 '+client+' → Ferry → 原生 '+native],
 [/^(\d+(?:\.\d+)?%) serving$/,n=>n+' 服务流量'],
 [/^Revision #(\d+) restored$/,n=>'已恢复版本 #'+n],
];
function translatedConsoleText(value){
 if(consoleLocale!=='zh-CN')return value;
 const source=value.trim(),translated=consoleMessages[source];
 if(translated)return value.replace(source,()=>translated);
 for(const [pattern,format] of consoleRetainedMessagePatterns){const match=source.match(pattern);if(match)return value.replace(source,()=>format(...match.slice(1)))}
 const sentences=value.split(/(?<=\.) (?=[A-Z0-9])/);
 if(sentences.length>1)return sentences.map(translatedConsoleText).join(' ');
 for(const [pattern,format] of consoleMessagePatterns){const match=source.match(pattern);if(match)return value.replace(source,()=>format(...match.slice(1)))}
 if(value.includes(' · '))return value.split(' · ').map(translatedConsoleText).join(' · ');
 if(source.includes('\n'))return value.split('\n').map(translatedConsoleText).join('\n');
 // Product impact paragraphs combine sentences with resource names. Split
 // only at sentence boundaries, preserving dots inside identifiers and URLs.
 return value;
}
function confirmConsole(message){return window.confirm(translatedConsoleText(message))}

// Format known timestamps from state, never parse a displayed label or touch
// Date.prototype. The browser timezone remains unchanged when locale switches.
function consoleDateTime(value,timeOnly=false){
 if(!value||String(value).startsWith('0001-'))return '—';
 const date=value instanceof Date?value:new Date(value);
 if(!Number.isFinite(date.getTime()))return '—';
 return timeOnly?date.toLocaleTimeString(consoleLocale):date.toLocaleString(consoleLocale);
}
function consoleTimestampText(source,el){
 if(el?.closest('.filter-summary')&&/^Updated /.test(source))return nt('Updated ','更新于 ')+consoleDateTime(state.requestLastUpdated,true);
 if(el?.closest('.pricing-sync-status')&&/^Last success .+ · Next update .+$/.test(source)){
  const pricing=state.settings?.pricing_sync||{};
  return nt('Last success ','上次成功 ')+consoleDateTime(pricing.last_success)+nt(' · Next update ',' · 下次更新 ')+(pricing.settings?.enabled===false?nt('Paused','已暂停'):consoleDateTime(pricing.next_update));
 }
 if(el?.closest('[data-queue-live]')&&/^(Refresh every 3s · Updated |每 3 秒刷新 · 更新于 )/.test(source)&&typeof queueData!=='undefined'&&queueData)return nt('Refresh every 3s · Updated ','每 3 秒刷新 · 更新于 ')+consoleDateTime(queueData.generated_at,true);
 const key=state.modal?.key;
 if(key&&/^Created .+ · Last activity .+$/.test(source)){
  for(const secret of key.secrets||[]){
   const activity=secret.last_used_at?new Date(secret.last_used_at).toLocaleString():secret.state==='ACTIVE'&&key.lastRequestAt?new Date(key.lastRequestAt).toLocaleString()+' (key-level activity)':'never recorded';
   if(source!=='Created '+new Date(secret.created_at).toLocaleString()+' · Last activity '+activity)continue;
   const localizedActivity=secret.last_used_at?consoleDateTime(secret.last_used_at):secret.state==='ACTIVE'&&key.lastRequestAt?consoleDateTime(key.lastRequestAt)+nt(' (key-level activity)','（密钥级活动）'):nt('never recorded','从未记录');
   return nt('Created ','创建于 ')+consoleDateTime(secret.created_at)+nt(' · Last activity ',' · 最近活动 ')+localizedActivity;
  }
 }
 return null;
}

function localizeDOM(root){
 const skipLink=document.querySelector('.skip-link');
 if(skipLink)skipLink.textContent=nt('Skip to content','跳转到内容');
 const models=[...(state.models||[]),...[...(state.modelCache?.values()||[])].map(x=>x.model).filter(Boolean)];
 const resources=[...models,...(state.providers||[]),...(state.apiKeys||[]),...(state.managementTokens||[]),state.modal?.key].filter(Boolean);
 const names=new Set([state.auth?.username,...resources.flatMap(x=>[x.id,x.name,x.preview])].filter(Boolean));
 const descriptions=new Set(resources.filter(x=>!(x.raw?.auto_generated||x.auto_generated)).map(x=>x.description).filter(Boolean));
 const skip='script,style,code,pre,kbd,textarea,[data-i18n-skip]';
 const walker=document.createTreeWalker(root,NodeFilter.SHOW_TEXT);
 while(walker.nextNode()){
  const node=walker.currentNode;if(node.parentElement?.closest(skip))continue;
  const original=consoleOriginalText.get(node)||node.nodeValue;
  if(!original.trim())continue;
  consoleOriginalText.set(node,original);
  const el=node.parentElement,source=original.trim();
  const timestamp=consoleTimestampText(source,el);
  let translated=timestamp===null?original:original.replace(source,()=>timestamp);
  if(consoleLocale==='zh-CN'&&timestamp===null){
   const pricing=state.settings?.pricing_sync;
   const policy=el?.closest('.queue-capacity-table')&&/^(global|provider|connection)( · (?:Serial recovery|串行恢复))?$/.exec(source);
   if(el?.closest('.badge')&&consoleBadgeMessages[source])translated=original.replace(source,()=>consoleBadgeMessages[source]);
   else if(el?.closest('[role="alert"],.trace-detail')){
    // The pricing alert appends product copy to an upstream diagnostic.
    if(pricing?.error&&source===pricing.error+'. The last successful cache remains available.')translated=original.replace(source,()=>pricing.error+'. 仍可使用最近一次成功更新的缓存。');
   }
   else if(descriptions.has(source)||names.has(source)){}
   else if(policy&&(el.getAttribute('data-i18n-original-data-label')||el.getAttribute('data-label'))?.match(/^(Policy \/ recovery|策略 \/ 恢复)$/))translated=original.replace(source,()=>({global:'全局',provider:'渠道',connection:'连接'}[policy[1]])+(policy[2]?' · 串行恢复':''));
   else if(el?.closest('.pricing-sync-status')&&source===(pricing?.source||pricing?.settings?.source||'litellm')+' · '+(pricing?.version||'No successful snapshot yet'))translated=original.replace(source,()=>(pricing?.source||pricing?.settings?.source||'litellm')+' · '+(pricing?.version||'暂无成功的快照'));
   else if(el?.closest('.filter-summary')&&typeof requestFilterSummary==='function'&&source===requestFilterSummary()){
    const filters=[['requestLogicalModel','精确逻辑模型'],['requestParticipatingProvider','参与渠道'],['requestAttemptStatus','尝试状态'],['requestAttemptFailureType','尝试错误'],['requestReportError','客户端错误'],['requestConversation','会话'],['requestModel','模型'],['requestProvider','渠道'],['requestApiKey','API 密钥'],['requestFailureType','失败类型'],['requestStatus','状态'],['requestRevision','版本'],['requestFrom','开始时间'],['requestTo','结束时间']];
    translated=original.replace(source,()=>filters.filter(([key])=>state[key]).map(([key,label])=>label+' '+state[key]).join(' · ')||'无额外筛选');
   }
   else translated=translatedConsoleText(original);
  }
  if(node.nodeValue!==translated)node.nodeValue=translated;
 }
 root.querySelectorAll('[placeholder],[title],[aria-label],[data-label]').forEach(el=>{
  if(el.closest(skip))return;
  for(const attr of ['placeholder','title','aria-label','data-label'])if(el.hasAttribute(attr)){
   const key='data-i18n-original-'+attr,original=el.getAttribute(key)||el.getAttribute(attr);
   el.setAttribute(key,original);el.setAttribute(attr,attr==='title'&&names.has(original)?original:translatedConsoleText(original));
  }
 });
}
