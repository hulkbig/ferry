function connectionDrawer(providerId,connectionId){
  const data=providerDataSync(providerId); const c=(data.connections||[]).find(x=>x.id===connectionId); if(!c)return '';
  const enabled=connectionIsEnabled(c), affected=providerModels(data.provider),recovery=connectionRecoveryCopy(c);
  const pending=(c.raw?.oauth_pending?`<div class="notice orange"><strong>OAuth sign-in pending</strong><span>The persisted login can be continued after a restart.</span><button class="btn small" data-action="resume-oauth" data-provider="${esc(providerId)}" data-id="${esc(connectionId)}">Continue OAuth</button></div>`:'')+
    (recovery?`<div class="notice ${recovery.tone}"><strong>${esc(recovery.title)}</strong><span>${esc(recovery.detail)}</span></div>`:'')+connectionTestResultPanel(providerId,connectionId);
  return `<div class="drawer-backdrop" data-action="close-overlay"></div><aside class="drawer"><div class="drawer-head"><div><div class="inline"><h2 style="margin:0">${esc(c.name)}</h2>${badge(enabled?c.status:'Disabled')}</div><div class="cell-sub">${esc(c.type)} · ${esc(c.account)}</div></div><button class="btn icon ghost" data-action="close-overlay">×</button></div><div class="drawer-body">${pending}<div class="notice orange"><strong>Route dependency</strong><span>This connection supplies ${affected.length?`logical model routes ${esc(affected.join(', '))}`:'its provider routes'}. Disabling or deleting it reduces eligible capacity and may trigger connection recovery or provider fallback; ${c.conversations||0} active conversation bindings may be affected.</span></div><div class="grid-equal section"><div class="summary-chip"><strong>${fmtCapacity(c.capacity)}</strong><small>Available Capacity</small></div><div class="summary-chip"><strong>${fmtPct(c.load)}</strong><small>Current Load</small></div></div><div class="divider"></div>${[['Type',c.type],['Account',c.account],['Authentication',c.auth??'—'],['Reachability',c.reachability??'—'],['Last Issue',c.lastIssue]].map(x=>`<div class="inline" style="justify-content:space-between;padding:7px 0;border-bottom:1px solid var(--line)"><span class="cell-sub">${x[0]}</span><strong>${esc(x[1])}</strong></div>`).join('')}<div class="divider"></div><div class="section-head"><div><h3>Recovery</h3></div></div><div class="model-chip-list">${(c.models||[]).map(model=>{const name=typeof model==='string'?model:model.upstream_model;return name?`<button class="btn small" data-action="reset-cooldown" data-provider="${esc(providerId)}" data-connection="${esc(connectionId)}" data-upstream="${esc(name)}">Reset ${esc(name)}</button>`:''}).join('')}</div><div class="grid-equal"><div class="summary-chip"><strong>${esc(c.requestsMoved??'—')}</strong><small>Requests moved</small></div><div class="summary-chip"><strong>${esc(c.conversations??'—')}</strong><small>Active conversation bindings</small></div></div>${c.status==='Cooling'?`<div class="notice orange" style="margin-top:12px"><strong>Cooling down</strong><span>${c.cooldownSeconds?`Expected recovery in ~${c.cooldownSeconds}s.`:'Recovery time is not reported.'} New requests use healthy connections.</span></div>`:''}</div><div class="drawer-foot wrap-actions"><button class="btn" data-action="reset-cooldown" data-provider="${esc(providerId)}" data-connection="${esc(connectionId)}">Reset Cooldowns</button><button class="btn" data-action="test-connection" data-provider="${esc(providerId)}" data-id="${esc(connectionId)}">Test</button><button class="btn" data-action="edit-connection" data-provider="${esc(providerId)}" data-id="${esc(connectionId)}">Edit</button>${c.type==='API Key / Token'?`<button class="btn" data-action="rotate-connection" data-provider="${esc(providerId)}" data-id="${esc(connectionId)}">Rotate Credential</button>`:''}<button class="btn ${enabled?'toggle-disable':'toggle-enable'}" data-action="toggle-connection" data-provider="${esc(providerId)}" data-id="${esc(connectionId)}">${enabled?'Disable Connection':'Enable Connection'}</button><button class="btn danger" data-action="delete-connection" data-provider="${esc(providerId)}" data-id="${esc(connectionId)}">Delete</button></div></aside>`;
}

function renderModal(modal){
  if(modal.type==='codex-usage-reset-confirm')return codexUsageResetModal(modal);
  if(modal.type==='request-cost')return `<div class="overlay"><div class="modal"><div class="modal-head"><div><h2>Request Cost</h2><p>${esc(modal.request.id)}</p>${requestKeySubtitle(modal.request.apiKey)}</div><button class="btn icon" data-action="close-overlay">×</button></div><div class="modal-body">${requestCostDetails(modal.request,true)}</div><div class="modal-foot"><button class="btn" data-action="close-overlay">Close</button></div></div></div>`;
  if(modal.type==='routing-review') return routingReviewModal();
  if(modal.type==='add-provider') return addProviderModal();
  if(modal.type==='add-connection') return addConnectionModal(modal.providerId);
  if(modal.type==='create-key') return createKeyModal();
  if(modal.type==='key-reveal') return keyRevealModal(modal);
  if(modal.type==='confirm-revoke') return confirmRevokeModal(modal.keyId);
  if(modal.type==='oauth-complete') return oauthCompleteModal(modal);
  if(modal.type==='oauth-device') return oauthDeviceModal(modal);
  if(modal.type==='add-model') return addModelModal();
  if(modal.type==='change-password') return changePasswordModal();
  if(modal.type==='create-management-token') return createManagementTokenModal();
  if(modal.type==='edit-management-token') return editManagementTokenModal(modal.token);
  if(modal.type==='management-token-reveal') return managementTokenRevealModal(modal);
  if(modal.type==='model-form') return modelFormModal(modal);
  if(modal.type==='override-form') return overrideFormModal(modal);
  if(modal.type==='simulation') return simulationModal(modal);
  if(modal.type==='provider-form') return providerFormModal(modal);
  if(modal.type==='connection-form') return connectionFormModal(modal);
  if(modal.type==='revision-detail') return revisionDetailModal(modal);
  if(modal.type==='api-key-detail') return apiKeyDetailModal(modal);
  if(modal.type==='key-policy') return keyPolicyModal(modal);
  return '';
}

function changePasswordModal(){return `<div class="modal-backdrop" data-action="close-overlay"><form class="modal small" data-modal-stop data-form="change-password"><div class="modal-head"><div><h2>Change administrator password</h2><div class="cell-sub">Every existing management session will be revoked.</div></div><button type="button" class="btn icon ghost" data-action="close-overlay">×</button></div><div class="modal-body stack"><div class="field"><label>Current password</label><input name="password" type="password" autocomplete="current-password" required></div><div class="field"><label>New password</label><input name="new_password" type="password" autocomplete="new-password" minlength="12" required></div><div class="field"><label>Confirm new password</label><input name="confirmation" type="password" autocomplete="new-password" minlength="12" required></div><div class="notice orange"><strong>Session revocation</strong><span>Saving signs out this browser and every other administrator session.</span></div></div><div class="modal-foot"><button type="button" class="btn" data-action="close-overlay">Cancel</button><button class="btn primary" type="submit">Change password</button></div></form></div>`}

function createManagementTokenModal(){return `<div class="modal-backdrop" data-action="close-overlay"><form class="modal small" data-modal-stop data-form="management-token-create"><div class="modal-head"><div><h2>Create Management Token</h2><div class="cell-sub">For the independent Ferry Skill or another trusted automation.</div></div><button type="button" class="btn icon ghost" data-action="close-overlay">×</button></div><div class="modal-body stack"><div class="field"><label>Name</label><input name="name" maxlength="64" autocomplete="off" placeholder="ferry-skill" required></div><div class="field"><label>Description</label><input name="description" maxlength="240" autocomplete="off" placeholder="Operator workstation Skill"></div><div class="field"><label>Expires at <span class="cell-sub">optional</span></label><input name="expires_at" type="datetime-local"></div><label class="checkbox-field"><input name="allow_high_risk" type="checkbox"><span><strong>Allow high-risk operations</strong><small>Permits activation, credential and secret changes, API key lifecycle, OAuth writes, and manual runtime overrides. This can be changed later.</small></span></label><div class="notice"><strong>Store it once</strong><span>The raw bearer token is shown once after creation. Ferry stores only its verifier hash.</span></div></div><div class="modal-foot"><button type="button" class="btn" data-action="close-overlay">Cancel</button><button class="btn primary" type="submit">Create token</button></div></form></div>`}

function editManagementTokenModal(token){return `<div class="modal-backdrop" data-action="close-overlay"><form class="modal small" data-modal-stop data-form="management-token-edit" data-id="${esc(token.id)}"><div class="modal-head"><div><h2>Edit Management Token</h2><div class="cell-sub">Metadata and expiry do not reveal or replace the token value.</div></div><button type="button" class="btn icon ghost" data-action="close-overlay">×</button></div><div class="modal-body stack"><div class="field"><label>Name</label><input name="name" maxlength="64" autocomplete="off" value="${esc(token.name)}" required></div><div class="field"><label>Description</label><input name="description" maxlength="240" autocomplete="off" value="${esc(token.description||'')}"></div><div class="field"><label>Expires at <span class="cell-sub">leave empty for no expiry</span></label><input name="expires_at" type="datetime-local" value="${esc(managementTokenLocalExpiry(token.expires_at))}"></div></div><div class="modal-foot"><button type="button" class="btn" data-action="close-overlay">Cancel</button><button class="btn primary" type="submit">Save token</button></div></form></div>`}

function managementTokenRevealModal(modal){return `<div class="modal-backdrop" data-action="close-overlay"><div class="modal small" data-modal-stop><div class="modal-head"><div><h2>${modal.rotated?'Management token rotated':'Management token created'}</h2><div class="cell-sub">${esc(modal.name||'Ferry Skill')}</div></div><button class="btn icon ghost" data-action="close-overlay">×</button></div><div class="modal-body stack"><div class="notice orange"><strong>Copy this token now</strong><span>It cannot be revealed again. Rotating a token invalidates its previous value immediately.</span></div><pre class="secret-reveal mono">${esc(modal.secret)}</pre></div><div class="modal-foot"><button class="btn" data-action="copy-management-token">${icon('copy')} Copy token</button><button class="btn primary" data-action="close-overlay">Done</button></div></div></div>`}

function routingReviewRoute(route,index,after=false){const recovery=(route.recoverOn||[]).join(', ')||'stop';return `<div class="review-node"><span class="badge ${after?'blue':''}">${index+1}</span><span class="review-node-copy"><strong>${esc(route.provider||route.id)}</strong><small>Actual model · <span class="mono">${esc(route.model||'Not selected')}</span></small><small>Advance on · ${esc(recovery)}</small></span></div>`}
function routingReviewModal(){
  const r=state.routingReview;if(!r)return'';
  const warnings=(r.warnings||[]).map(message=>`<div class="notice orange routing-review-warning"><strong>Check before applying</strong><span>${esc(message)}</span></div>`).join('');
  return `<div class="modal-backdrop" data-action="close-overlay"><div class="modal routing-review-modal" data-modal-stop><div class="modal-head"><div><h2>Review routing changes</h2><div class="cell-sub">${esc(r.modelId)} · Revision #${r.revision}</div></div><button class="btn icon ghost" data-action="close-overlay">×</button></div><div class="modal-body routing-review-body"><div class="review-grid"><div><div class="review-label">BEFORE</div><div class="review-route">${r.before.map((route,index)=>routingReviewRoute(route,index)).join('')||'<div class="review-empty">No route configured</div>'}</div></div><div class="review-arrow">→</div><div><div class="review-label">AFTER</div><div class="review-route">${r.after.map((route,index)=>routingReviewRoute(route,index,true)).join('')}</div></div></div><div class="divider"></div><div class="grid-equal review-impact-grid"><div class="summary-chip"><strong>${r.expectedTraffic} req/min</strong><small>Estimated affected traffic</small></div><div class="summary-chip"><strong>${r.activeConversations}</strong><small>Active conversations</small></div></div>${warnings}
