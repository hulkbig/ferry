
async function submitAuthForm(form){
  const values=new FormData(form),username=String(values.get('username')||'').trim(),password=String(values.get('password')||'');
  try{
    if(form.dataset.form==='management-token-create'){
      const name=String(values.get('name')||'').trim(),description=String(values.get('description')||'').trim(),expires=String(values.get('expires_at')||'');
      if(!name){showToast('Token name is required','error');return;}
      const result=await adapter.createManagementToken({name,description,allow_high_risk:values.get('allow_high_risk')==='on',...(expires?{expires_at:new Date(expires).toISOString()}:{})});
      await refreshManagementSecurity();state.modal={type:'management-token-reveal',secret:result.secret,name:result.token?.name||name,rotated:false};renderPortal();showToast('Management token created');return;
    }else if(form.dataset.form==='management-token-edit'){
      const name=String(values.get('name')||'').trim(),description=String(values.get('description')||'').trim(),expires=String(values.get('expires_at')||'');
      if(!name){showToast('Token name is required','error');return;}
      await adapter.updateManagementToken(form.dataset.id,{name,description,...(expires?{expires_at:new Date(expires).toISOString()}:{clear_expiry:true})});
      await refreshManagementSecurity();closeOverlay();render();showToast('Management token updated');return;
    }else if(form.dataset.form==='initialize'){
      if(password!==String(values.get('confirmation')||'')){showToast('Password confirmation does not match','error');return;}
      await adapter.initializeAdmin({username,password});
    }else if(form.dataset.form==='login'){
      await adapter.login({username,password});
    }else if(form.dataset.form==='change-password'){
      const next=String(values.get('new_password')||''),confirmation=String(values.get('confirmation')||'');
      if(next!==confirmation){showToast('Password confirmation does not match','error');return;}
      await adapter.changePassword({current_password:password,new_password:next});
      clearCodexUsageResetState();state.modal=null;state.auth={initialized:true,authenticated:false,username:state.auth?.username};render();showToast('Password changed. Sign in again.');return;
    }
    await boot().then(()=>pollCodexUsageResets());
  }catch(error){showToast(error.message,'error')}
}
app.addEventListener('submit',async(event)=>{const form=event.target.closest('[data-form]');if(!form)return;event.preventDefault();await submitAuthForm(form)});
portal.addEventListener('submit',async(event)=>{const form=event.target.closest('[data-form]');if(!form)return;event.preventDefault();await submitAuthForm(form)});

app.addEventListener('change',async(event)=>{
  const el=event.target;
  if(el.dataset.action?.startsWith('request-')) forgetReportLocation();
  if(el.dataset.action==='request-columns'){state.requestColumns=el.checked;render();return;}
  if(el.dataset.action==='scenario-change'){state.scenario=el.value;state.modelCache.clear();state.providerCache.clear();render();return;}
  if(el.dataset.action==='request-filter'){state.requestStatus='';state.requestReportError='';state.requestAttemptStatus='';state.requestAttemptFailureType='';state.requestFilter=el.value;state.requestOffset=0;await reloadRequests();return;}
  if(el.dataset.action==='request-window'){state.requestFrom='';state.requestTo='';state.requestWindow=el.value;state.requestOffset=0;await reloadRequests();return;}
  if(el.dataset.action==='request-model'){state.requestLogicalModel='';state.requestModel=el.value;state.requestOffset=0;await reloadRequests();return;}
  if(el.dataset.action==='request-provider'){state.requestParticipatingProvider='';state.requestAttemptStatus='';state.requestAttemptFailureType='';state.requestProvider=el.value;state.requestOffset=0;await reloadRequests();return;}
  if(el.dataset.action==='overview-window'){await changeUsageWindow('overview',el.value);return;}
  if(el.dataset.action==='model-status'){state.modelStatus=el.value;render();return;}
  if(el.dataset.action==='model-type'){state.modelType=el.value;render();return;}
  if(el.dataset.action==='request-api-key'){state.requestApiKey=el.value;state.requestOffset=0;await reloadRequests();return;}
  if(el.dataset.action==='request-connection'){state.requestConnection=el.value;state.requestOffset=0;await reloadRequests();return;}
  if(el.dataset.action==='request-failure'){state.requestFailureType=el.value;state.requestOffset=0;await reloadRequests();return;}
  if(el.dataset.action==='request-status'){state.requestStatus=el.value;state.requestOffset=0;await reloadRequests();return;}
  if(el.dataset.action==='request-revision'){state.requestRevision=el.value;state.requestOffset=0;await reloadRequests();return;}
  if(el.dataset.action==='request-from'){state.requestFrom=el.value;state.requestOffset=0;await reloadRequests();return;}
  if(el.dataset.action==='request-to'){state.requestTo=el.value;state.requestOffset=0;await reloadRequests();return;}
  if(el.dataset.action==='request-limit'){state.requestLimit=Number(el.value);state.requestOffset=0;await reloadRequests();return;}
  if(el.dataset.action==='billing-window'){await changeUsageWindow('billing',el.value);return;}
  if(el.dataset.action==='debug-capture'){try{state.settings=await adapter.updateSettings({debug_request_response:el.checked});showToast(`Request/response debug ${el.checked?'enabled':'disabled'}`);render();}catch(error){showToast(error.message,'error');render()}return;}
  if(el.dataset.action==='codex-usage-threshold'||el.dataset.action==='codex-allow-credits'){await updateCodexUsageProtectionSetting(el);return;}
  if(el.dataset.action==='auto-reset-enabled'||el.dataset.action==='auto-reset-threshold'){await updateAutomaticUsageResetSetting(el);return;}
  if(el.dataset.action==='scheduled-sync'){try{state.settings=await adapter.updateSettings({scheduled_model_sync_enabled:el.checked});showToast(`Scheduled model sync ${el.checked?'enabled':'paused'}`);render();}catch(error){showToast(error.message,'error');render()}return;}
  if(['pricing-enabled','pricing-source','pricing-interval'].includes(el.dataset.action)){
    const settings={...(state.settings?.pricing_sync?.settings||{enabled:true,source:'litellm',interval_hours:24})};
    if(el.dataset.action==='pricing-enabled')settings.enabled=el.checked;
    if(el.dataset.action==='pricing-source')settings.source=el.value;
    if(el.dataset.action==='pricing-interval'){const hours=Number(el.value);if(!Number.isInteger(hours)||hours<1||hours>168){showToast('Enter whole hours between 1 and 168','error');render();return}settings.interval_hours=hours}
    try{state.settings=await adapter.updateSettings({pricing_sync:settings});showToast('Reference price schedule saved');render()}catch(error){showToast(error.message,'error');render()}return;
  }
  if(el.dataset.action==='codex-auto-update'){state.codexAutoUpdateDraft=el.checked;render();return;}
  if(el.dataset.action==='codex-release-channel'){state.codexReleaseChannelDraft=el.value;return;}
  if(el.dataset.action==='auto-logical-limit'){
    const value=Number(el.value);
    if(el.value.trim()===''||!Number.isInteger(value)||value<0||value>10000){showToast('Enter a whole number between 0 and 10000','error');render();return;}
    try{state.settings=await adapter.updateSettings({auto_logical_model_limit:value});state.models=await adapter.getModels(state.overviewWindow);state.providerCache.clear();state.modelCache.clear();showToast('Automatic Logical Model limit saved');render();}catch(error){showToast(error.message,'error');render()}return;
  }
  if(el.dataset.action==='management-token-high-risk'){try{await adapter.updateManagementToken(el.dataset.id,{allow_high_risk:el.checked});await refreshManagementSecurity();showToast(`High-risk operations ${el.checked?'allowed':'blocked'} for this token`);render();}catch(error){showToast(error.message,'error');render()}return;}
});

app.addEventListener('input',(event)=>{
  const el=event.target;
  if(el.dataset.action==='codex-client-version'){state.codexVersionDraft=el.value;return;}
  const inputName=el.dataset.input;
  if(!inputName)return;
  if(inputName==='models-search') state.modelsSearch=el.value;
  else if(inputName==='provider-search') state.providerSearch=el.value;
  else if(inputName==='request-search'){state.requestSearch=el.value;forgetReportLocation();return;}
  else if(inputName==='key-search') state.keySearch=el.value;
  else return;
  const start=el.selectionStart ?? el.value.length;
  const end=el.selectionEnd ?? start;
  render();
  requestAnimationFrame(()=>{
    const next=app.querySelector(`[data-input="${inputName}"]`);
    if(!next)return;
    next.focus({preventScroll:true});
    try{next.setSelectionRange(start,end)}catch{}
  });
});

app.addEventListener('keydown',async(event)=>{
  const el=event.target,rowLink=el.closest?.('tr[data-action][role="link"]'),nestedControl=el!==rowLink&&el.closest?.('button,a,input,select,textarea,summary');
  if(rowLink&&!nestedControl&&(event.key==='Enter'||event.key===' ')){event.preventDefault();rowLink.click();return;}
  if(el.dataset.input!=='request-search'||event.key!=='Enter'||event.isComposing)return;
  event.preventDefault();state.requestOffset=0;await reloadRequests();
});

portal.addEventListener('click', async (event)=>{
  const el=event.target.closest('[data-action]'); if(!el)return;
  if(el.classList.contains('modal-backdrop'))return;
  const proxy=document.createElement('button'); proxy.dataset.action=el.dataset.action; for(const [k,v] of Object.entries(el.dataset))proxy.dataset[k]=v; app.appendChild(proxy); proxy.click(); proxy.remove();
});
function updateOverrideConditionState(name){const w=state.wizard.override,node=portal.querySelector(`[data-condition-state="${name}"]`);if(!w||!node)return;const required=w.required||{},configured=name==='caller'?Boolean(w.callers.trim()):name==='protocol'?Boolean(w.protocols?.length):name==='schedule'?Boolean(w.weekdays?.length||w.start||w.end):Boolean(overrideCapabilityOptions.some(([value])=>required[value])||Number(required.min_context||0)||Number(required.min_output||0));node.textContent=configured?'Configured · must match':'Not selected · group passes';node.classList.toggle('configured',configured)}
portal.addEventListener('change',async(event)=>{
  const el=event.target;
  if(el.dataset.wizard==='provider-auth-file'||el.dataset.wizard==='connection-auth-file'){
    const file=el.files?.[0]||null;if(!file)return;
    if(!String(file.name||'').toLowerCase().endsWith('.json')){showToast('Choose a .json credential file','error');el.value='';return;}
    if(file.size>128*1024){showToast('auth.json must be 128 KiB or smaller','error');el.value='';return;}
    const target=el.dataset.wizard==='provider-auth-file'?state.wizard.provider:state.wizard.connection;
    target.authFile=file;target.authFileName=file.name;renderPortal();return;
  }
  if(el.dataset.action==='routing-provider-select'){state.routingValidationErrors=null;state.wizard.routingProvider=el.value;renderPortal();return;}
  if(el.dataset.action==='routing-conversation'){state.routingValidationErrors=null;state.routingDraft.conversationStrategy=el.value;return;}
  if(el.dataset.action==='routing-recover'){const route=state.routingDraft.routes[Number(el.dataset.index)],failure=el.dataset.failure;if(!route)return;state.routingValidationErrors=null;route.recoverOn=normalizeRoutingFailures(route.recoverOn);if(el.checked&&!route.recoverOn.includes(failure))route.recoverOn.push(failure);if(!el.checked)route.recoverOn=route.recoverOn.filter(value=>value!==failure);return;}
  if(el.dataset.action==='routing-provider'){const route=state.routingDraft.routes[Number(el.dataset.index)],provider=state.providers.find(item=>item.id===el.value);if(!route||!provider)return;state.routingValidationErrors=null;Object.assign(route,{id:provider.id,provider:provider.name,model:'',status:provider.status,serving:0});renderPortal();return;}
  if(el.dataset.action==='routing-model'){const route=state.routingDraft.routes[Number(el.dataset.index)];if(!route)return;state.routingValidationErrors=null;route.model=el.value;renderPortal();return;}
  if(el.dataset.wizard==='connection-protocol'){state.wizard.connection.protocol=el.value;return;}
  if(el.dataset.wizard==='provider-protocol'){state.wizard.provider.protocol=el.value;if(providerModelDiscoveryReady(state.wizard.provider))await discoverProviderModels();return;}
  if(el.dataset.wizard==='provider-auth-type'){state.wizard.provider.authType=el.value;state.wizard.provider.models=[];state.wizard.provider.modelOptions=[];state.wizard.provider.modelsLoaded=false;state.wizard.provider.modelsError='';renderPortal();if(providerModelDiscoveryReady(state.wizard.provider))await discoverProviderModels();return;}
  if(el.dataset.wizard==='provider-model-option'){const selected=new Set(state.wizard.provider.models||[]);if(el.checked)selected.add(el.value);else selected.delete(el.value);state.wizard.provider.models=[...selected];const count=portal.querySelector('[data-provider-model-selected]');if(count)count.textContent=String(selected.size);return;}
  if(['provider-base-url','provider-secret','provider-credential-ref'].includes(el.dataset.wizard)&&providerModelDiscoveryReady(state.wizard.provider)){await discoverProviderModels();return;}
  if(el.dataset.wizard==='model-enabled')state.wizard.model.enabled=el.checked;
  if(el.dataset.wizard==='override-enabled')state.wizard.override.enabled=el.checked;
  if(el.dataset.action==='override-protocol'){const values=new Set(state.wizard.override.protocols||[]);el.checked?values.add(el.value):values.delete(el.value);state.wizard.override.protocols=[...values];updateOverrideConditionState('protocol');return;}
  if(el.dataset.action==='override-weekday'){const values=new Set(state.wizard.override.weekdays||[]);el.checked?values.add(el.value):values.delete(el.value);state.wizard.override.weekdays=[...values];updateOverrideConditionState('schedule');return;}
  if(el.dataset.action==='override-capability'){state.wizard.override.required||={};state.wizard.override.required[el.value]=el.checked;updateOverrideConditionState('requirements');return;}
  if(el.dataset.action==='override-mode'){state.wizard.override.mode=el.value;state.wizard.override.customRouteChoice='';renderPortal();return;}
  if(el.dataset.action==='override-adjust'){state.wizard.override.adjustments[Number(el.dataset.index)]=el.value;return;}
  if(el.dataset.action==='override-route-select'){state.wizard.override.customRouteChoice=el.value;renderPortal();return;}
  if(el.dataset.action==='override-route-recover'){const route=state.wizard.override.customRoutes[Number(el.dataset.index)],failure=el.dataset.failure;if(!route)return;route.recoverOn=normalizeRoutingFailures(route.recoverOn);if(el.checked&&!route.recoverOn.includes(failure))route.recoverOn.push(failure);if(!el.checked)route.recoverOn=route.recoverOn.filter(value=>value!==failure);return;}
  if(el.dataset.wizard==='simulation-protocol'){state.wizard.simulation.protocol=el.value;return;}
  if(el.dataset.wizard==='simulation-stream'){state.wizard.simulation.stream=el.checked;return;}
  if(el.dataset.action==='simulation-capability'){state.wizard.simulation.required||={};state.wizard.simulation.required[el.value]=el.checked;return;}
  if(el.dataset.wizard==='provider-edit-enabled')state.wizard.providerEdit.enabled=el.checked;
  if(el.dataset.wizard==='provider-edit-protocol'){state.wizard.providerEdit.protocol=el.value;if(providerEditModelDiscoveryReady(state.wizard.providerEdit))await discoverProviderEditModels();return;}
  if(el.dataset.wizard==='provider-edit-url'&&providerEditModelDiscoveryReady(state.wizard.providerEdit)){await discoverProviderEditModels();return;}
  if(el.dataset.wizard==='connection-edit-stream')state.wizard.connectionEdit.stream=el.checked;
  if(el.dataset.wizard==='connection-edit-tools')state.wizard.connectionEdit.tools=el.checked;
  if(el.dataset.wizard==='connection-edit-protocol')state.wizard.connectionEdit.protocol=el.value;
});
portal.addEventListener('input',(event)=>{
  const el=event.target;
  if(el.dataset.wizard==='provider-name') state.wizard.provider.name=el.value;
  if(el.dataset.wizard==='provider-base-url') state.wizard.provider.baseUrl=el.value;
  if(el.dataset.wizard==='provider-account') state.wizard.provider.account=el.value;
  if(el.dataset.wizard==='provider-model-filter'){state.wizard.provider.modelFilter=el.value;updateProviderModelFilterUI();return;}
  if(el.dataset.wizard==='provider-secret') state.wizard.provider.secret=el.value;
  if(el.dataset.wizard==='provider-credential-ref') state.wizard.provider.credentialRef=el.value;
  if(el.dataset.wizard==='connection-account') state.wizard.connection.account=el.value;
  if(el.dataset.wizard==='connection-models') state.wizard.connection.models=el.value;
  if(el.dataset.wizard==='connection-secret') state.wizard.connection.secret=el.value;
  if(el.dataset.wizard==='connection-credential-ref') state.wizard.connection.credentialRef=el.value;
