  if(el.dataset.wizard==='key-name') state.wizard.key.name=el.value;
  if(el.dataset.wizard==='key-description') state.wizard.key.description=el.value;
  if(el.dataset.wizard==='key-models') state.wizard.key.models=el.value;
  if(el.dataset.wizard==='key-protocols') state.wizard.key.protocols=el.value;
  if(el.dataset.wizard==='key-expires') state.wizard.key.expiresAt=el.value;
  if(el.dataset.wizard==='key-rate') state.wizard.key.rateLimitRPM=el.value;
  if(el.dataset.wizard==='key-budget') state.wizard.key.monthlyBudgetUSD=el.value;
  if(el.dataset.wizard==='model-id') state.wizard.model.id=el.value;
  if(el.dataset.wizard==='model-name') state.wizard.model.name=el.value;
  if(el.dataset.wizard==='model-description') state.wizard.model.description=el.value;
  if(el.dataset.wizard==='model-first-output-timeout') state.wizard.model.firstOutputTimeoutSeconds=el.value;
  if(el.dataset.wizard==='override-id') state.wizard.override.id=el.value;
  if(el.dataset.wizard==='override-name') state.wizard.override.name=el.value;
  if(el.dataset.wizard==='override-callers'){state.wizard.override.callers=el.value;updateOverrideConditionState('caller');}
  if(el.dataset.wizard==='override-timezone') state.wizard.override.timezone=el.value;
  if(el.dataset.wizard==='override-start'){state.wizard.override.start=el.value;updateOverrideConditionState('schedule');}
  if(el.dataset.wizard==='override-end'){state.wizard.override.end=el.value;updateOverrideConditionState('schedule');}
  if(el.dataset.wizard==='override-min-context'){state.wizard.override.required||={};state.wizard.override.required.min_context=el.value;updateOverrideConditionState('requirements');}
  if(el.dataset.wizard==='override-min-output'){state.wizard.override.required||={};state.wizard.override.required.min_output=el.value;updateOverrideConditionState('requirements');}
  if(el.dataset.wizard==='simulation-caller')state.wizard.simulation.caller=el.value;
  if(el.dataset.wizard==='simulation-at')state.wizard.simulation.at=el.value;
  if(el.dataset.wizard==='simulation-min-context'){state.wizard.simulation.required||={};state.wizard.simulation.required.min_context=el.value;}
  if(el.dataset.wizard==='simulation-min-output'){state.wizard.simulation.required||={};state.wizard.simulation.required.min_output=el.value;}
  if(el.dataset.wizard==='provider-edit-name') state.wizard.providerEdit.name=el.value;
  if(el.dataset.wizard==='provider-edit-url') state.wizard.providerEdit.baseUrl=el.value;
  if(el.dataset.wizard==='provider-edit-identity') state.wizard.providerEdit.identity=el.value;
  if(el.dataset.wizard==='provider-edit-model-input') state.wizard.providerEdit.modelInput=el.value;
  if(el.dataset.wizard==='provider-edit-model-filter'){state.wizard.providerEdit.modelFilter=el.value;updateProviderEditModelFilterUI();return;}
  if(el.dataset.wizard==='provider-unlisted-filter'){state.wizard.providerEdit.unlistedFilter=el.value;updateProviderUnlistedFilterUI();return;}
  if(el.dataset.wizard==='provider-unlisted-option'){const w=state.wizard.providerEdit;if(w&&w.type!=='cliproxy-codex'){const selected=new Set(w.unlistedSelected||[]);if(el.checked)selected.add(el.value);else selected.delete(el.value);w.unlistedSelected=[...selected];updateProviderUnlistedUI(w);}return;}
  if(el.dataset.wizard==='connection-edit-identity') state.wizard.connectionEdit.identity=el.value;
  if(el.dataset.wizard==='connection-edit-credential') state.wizard.connectionEdit.credentialRef=el.value;
  if(el.dataset.wizard==='connection-edit-models') state.wizard.connectionEdit.models=el.value;
  if(el.dataset.wizard==='policy-description') state.wizard.keyPolicy.description=el.value;
  if(el.dataset.wizard==='policy-models') state.wizard.keyPolicy.models=el.value;
  if(el.dataset.wizard==='policy-protocols') state.wizard.keyPolicy.protocols=el.value;
  if(el.dataset.wizard==='policy-expires') state.wizard.keyPolicy.expiresAt=el.value;
  if(el.dataset.wizard==='policy-rate') state.wizard.keyPolicy.rate=el.value;
  if(el.dataset.wizard==='policy-budget') state.wizard.keyPolicy.budget=el.value;
});
portal.addEventListener('keydown',(event)=>{
  const el=event.target;
  if(el.dataset.wizard!=='provider-edit-model-input'||event.key!=='Enter'||event.isComposing)return;
  event.preventDefault();
  const w=state.wizard.providerEdit;
  if(!String(w?.modelInput||'').trim())return;
  addProviderEditModelNames(w,w.modelInput);
  renderPortal();
});

function normalizeRoutingFailures(values){return [...new Set((values||[]).map(value=>value==='connect'?'connect_failure':value).filter(Boolean))]}
function defaultRoutingFailures(){return ['connect_failure','rate_limit','provider_5xx','quota_exhausted','ttft_timeout','stream_broken','bad_response']}
function normalizeRoutingRoutes(routes){return JSON.parse(JSON.stringify(routes||[])).map(route=>({...route,recoverOn:normalizeRoutingFailures(route.recoverOn)}))}
function routingDrawer(modelId){
  const data=modelDataSync(modelId);if(!state.routingDraft)state.routingDraft={routes:normalizeRoutingRoutes(data.routes),conversationStrategy:data.model?.conversationStrategy||'keep-existing'};
  const d=state.routingDraft,providers=state.providers;
  const failures=[['connect_failure','Connection failed'],['rate_limit','Rate limited'],['provider_5xx','Provider server error'],['quota_exhausted','Quota exhausted'],['ttft_timeout','First-token timeout'],['stream_broken','Stream interrupted'],['bad_response','Invalid provider response']];
  const routeLabels=routes=>(routes||[]).map(route=>`${esc(route.provider||route.id)} (${esc(route.model)})`).join(' → ')||'—';
  const conflict=state.routingConflict?`<div class="notice red routing-message"><strong>Revision conflict</strong><span>${esc(state.routingConflict.message)} The latest runtime was loaded. Review again before applying.</span><span><b>Your reviewed route:</b> ${routeLabels(state.routingConflict.attemptedRoutes)}</span><span><b>Latest route:</b> ${routeLabels(state.routingConflict.latestRoutes)}</span></div>`:'';
  const validationErrors=(state.routingValidationErrors||[]).filter(Boolean);
  const validation=validationErrors.length?`<div class="notice red routing-message"><strong>Cannot review this route</strong><ul>${validationErrors.map(message=>`<li>${esc(message)}</li>`).join('')}</ul></div>`:'';
  const routeCards=d.routes.map((r,i)=>{
    const provider=providers.find(p=>p.id===r.id),rawCatalog=provider?.raw?.model_catalog||[],catalog=rawCatalog.length?rawCatalog:(provider?.upstreamModels||[]).map(upstream_model=>({upstream_model})),known=catalog.some(m=>m.upstream_model===r.model),canAdvance=i<d.routes.length-1;
    const providerOptions=providers.map(item=>`<option value="${esc(item.id)}" ${item.id===r.id?'selected':''}>${esc(item.name)}</option>`).join('');
    const modelOptions=[`<option value="" ${r.model?'':'selected'} disabled>Select the actual upstream model…</option>`,...(!known&&r.model?[`<option value="${esc(r.model)}" selected>${esc(r.model)} (not in current catalog)</option>`]:[]),...catalog.map(m=>`<option value="${esc(m.upstream_model)}" ${m.upstream_model===r.model?'selected':''}>${esc(m.upstream_model)}</option>`)].join('');
    const recovery=canAdvance?`<details class="recovery-advanced"><summary>When to advance to route ${i+2} <span>Advanced</span></summary><p>Only checked operational upstream failures advance. An empty set stops operational recovery; compatibility failures detected before response commit still advance automatically. Request errors are never eligible.</p><div class="recover-grid">${failures.map(([value,label])=>`<label><input type="checkbox" data-action="routing-recover" data-index="${i}" data-failure="${value}" ${(r.recoverOn||[]).includes(value)?'checked':''}> <span>${label}</span></label>`).join('')}</div></details>`:'';
    const position=i===0?'Requests start here.':`Tried after route ${i}.`;
    return `<section class="route-editor-card ${r.model?'':'route-model-missing'}"><span class="route-priority">${i+1}</span><label class="route-editor-field"><span>Provider</span><select class="select" data-action="routing-provider" data-index="${i}">${providerOptions}</select></label><label class="route-editor-field"><span>Actual upstream model</span><select class="select" data-action="routing-model" data-index="${i}">${modelOptions}</select>${r.model?'':`<small>Select a model explicitly for route ${i+1}.</small>`}</label><div class="route-editor-actions" aria-label="Route ${i+1} actions"><button class="btn icon small" title="Move up" aria-label="Move route ${i+1} up" data-action="routing-up" data-index="${i}" ${i===0?'disabled':''}>${icon('up')}</button><button class="btn icon small" title="Move down" aria-label="Move route ${i+1} down" data-action="routing-down" data-index="${i}" ${i===d.routes.length-1?'disabled':''}>${icon('down')}</button><button class="btn icon small" title="Duplicate route" aria-label="Duplicate route ${i+1}" data-action="routing-duplicate" data-index="${i}">${icon('copy')}</button><button class="btn icon small danger" title="Remove route" aria-label="Remove route ${i+1}" data-action="routing-remove" data-index="${i}" ${d.routes.length===1?'disabled':''}>${icon('trash')}</button></div><div class="route-footnote"><span>${position}</span>${canAdvance?'':'<span class="route-final-note">Final route · no further recovery</span>'}</div>${recovery}</section>`;
  }).join('');
  const providerOptions=providers.map(provider=>`<option value="${esc(provider.id)}" ${state.wizard.routingProvider===provider.id?'selected':''}>${esc(provider.name)}</option>`).join('');
  return `<div class="modal-backdrop" data-action="close-overlay"><div class="modal routing-editor-modal" data-modal-stop><div class="modal-head"><div><h2>Edit Routing</h2><div class="cell-sub">${esc(modelId)} · routes are tried from top to bottom</div></div><button class="btn icon ghost" data-action="close-overlay">×</button></div><div class="modal-body routing-editor-body">${conflict}${validation}<div class="routing-order-explainer"><div><span>1</span>${icon('arrow')}<span>2</span>${icon('arrow')}<span>3</span></div><p>Start with route 1. Continue only for the failure types selected on that route, or when it has no eligible connection. Client request errors stop immediately.</p></div><div class="routing-section-head"><div><h3>Route order</h3><p>The same Provider may appear more than once with different upstream models.</p></div></div><div class="route-editor-list">${routeCards||'<div class="empty compact-empty"><strong>No route configured</strong>Add a route before enabling or simulating this model.</div>'}</div><div class="routing-add-row"><select class="select" data-action="routing-provider-select"><option value="">Select a Provider for the new route…</option>${providerOptions}</select><button class="btn" data-action="routing-add-route" ${providers.length&&state.wizard.routingProvider?'':'disabled'}>${icon('plus')} Add route</button></div><div class="field routing-conversation"><label>Existing conversations after this change</label><select class="select" data-action="routing-conversation"><option value="keep-existing" ${d.conversationStrategy==='keep-existing'?'selected':''}>Keep their current route while it remains eligible</option><option value="migrate" ${d.conversationStrategy==='migrate'?'selected':''}>Move to the new route on the next request</option></select><span class="hint">New conversations use the new revision. In-flight requests always finish on the revision they started with.</span></div><div class="notice routing-message"><strong>Review before apply</strong><span>The review preserves the selected failure conditions and conversation strategy. Nothing changes until Apply succeeds.</span></div></div><div class="modal-foot"><button class="btn" data-action="close-overlay">Cancel</button><button class="btn primary" data-action="routing-review" data-model="${esc(modelId)}" ${d.routes.length&&!d.routes.some(route=>!route.model)?'':'disabled'}>Review Changes</button></div></div></div>`;
}

function pageOverviewV3(){
  const o=state.overview||emptyOverview(),sv=scenarioView(),managed=demoMode?(sv.managedEvents||[]):Array.isArray(o.managedEvents)?o.managedEvents:[],alerts=(state.alerts||[]).slice(0,4),trend=demoMode?(sv.trend||[]):(o.trend||[]);
  const hasTraffic=sv.hasTraffic!==false&&o.hasTraffic!==false,failed=Number(sv.failed||0),clientStatus=o.clientStatus||(hasTraffic?(failed>0?'Degraded':'Healthy'):'No traffic');
  const successLabel=hasTraffic?`${(100-failed).toFixed(2)}%`:'—',overallStatus=demoMode?sv.system:(o.overallStatus||o.runtimeStatus||o.systemStatus||'Unknown');
  const trafficTrends=demoMode?(sv.trafficTrends||{}):(o.trafficTrends||{}),callPoints=trend.map(point=>({from:point.from,to:point.to,requests:Number(point.requests||0),succeeded:Number(point.succeeded||0),failed:Number(point.failed||0)}));
  const callRequests=callPoints.reduce((sum,point)=>sum+point.requests,0),callSucceeded=callPoints.reduce((sum,point)=>sum+point.succeeded,0);
  const callSeries=callPoints.length?[{id:'all-requests',label:'All requests',requests:callRequests,succeeded:callSucceeded,failed:callRequests-callSucceeded,successRate:callRequests?callSucceeded/callRequests*100:null,points:callPoints}]:[];
  const scaleCacheMetric=metric=>{if(!demoMode)return metric||{};const factor=sv.windowMinutes/15,value=metric||{};return {...value,requests:Number(value.requests||0)*factor,observedRequests:Number(value.observedRequests||0)*factor,eligibleInputTokens:Number(value.eligibleInputTokens||0)*factor,cacheReadTokens:Number(value.cacheReadTokens||0)*factor,cacheWriteTokens:Number(value.cacheWriteTokens||0)*factor}};
  const sourceCache=o.cacheHit||{},cacheHit={overall:scaleCacheMetric(sourceCache.overall),apiKeys:(sourceCache.apiKeys||[]).map(scaleCacheMetric),logicalModels:(sourceCache.logicalModels||[]).map(scaleCacheMetric)},overallCache={...emptyCacheHitMetric('overall'),...(cacheHit.overall||{})};
  const cacheRate=overallCache.hitRate===null||overallCache.hitRate===undefined?0:Math.max(0,Math.min(100,Number(overallCache.hitRate)));
  const keyCache=completeCacheHitDimensions(cacheHit.apiKeys,state.apiKeys,item=>item.name||item.id,item=>item.name||item.id);
  const modelCache=completeCacheHitDimensions(cacheHit.logicalModels,state.models,item=>item.id,item=>item.name||item.id);
  return `${scenarioBanner()}<div class="v3-page v3-overview-page">
    <div class="page-head v3-page-head"><div class="head-main"><div class="v3-eyebrow">${badge(overallStatus)}</div><h1>Overview</h1><p>${esc(o.statusSummary||(hasTraffic?`Client traffic is ${String(clientStatus).toLowerCase()}. Ferry recovered ${Number(sv.recoveredCount||0)} requests in the selected window.`:'No client requests were recorded in the selected window.'))}</p></div><div class="head-actions"><select class="select" aria-label="Overview time window" data-action="overview-window" ${state.usageLoading.overview?'disabled':''}><option value="15m" ${state.overviewWindow==='15m'?'selected':''}>Last 15 min</option><option value="1h" ${state.overviewWindow==='1h'?'selected':''}>Last hour</option><option value="24h" ${state.overviewWindow==='24h'?'selected':''}>Last 24 hours</option><option value="168h" ${state.overviewWindow==='168h'?'selected':''}>Last 7 days</option></select><button class="btn icon" data-action="refresh" aria-label="Refresh overview">${icon('refresh')}</button></div></div>
    <section class="card panel v3-experience-panel"><h2>Client Experience</h2><div class="v3-experience-card"><div class="v3-success-score"><strong>${successLabel}</strong><span>Client Success</span></div><div class="v3-legend"><div><i class="blue"></i><span>Direct Success</span><strong>${fmtPct(sv.direct)}</strong></div><div><i class="green"></i><span>Recovered</span><strong>${fmtPct(sv.recovered)}</strong></div><div><i class="red"></i><span>Failed</span><strong>${fmtPct(sv.failed)}</strong></div></div><div class="v3-metric-strip"><div><strong>${esc(o.activeConversations??'—')}</strong><small>Active Conversations</small></div><div><strong>${esc(demoMode?sv.requestRate:o.requestRate??'—')}</strong><small>Requests / min</small></div><div><strong>${esc(o.tokenRate??'—')}</strong><small>Tokens / min</small></div><div><strong>${esc(o.medianLatency??'—')}</strong><small>Median Latency</small></div></div></div></section>
    <section class="card v3-usage-card"><div class="v3-card-header"><div><h2>Usage & Recovery</h2><p>Usage is scoped to this Local Ferry runtime.</p></div><button class="btn small" data-action="billing-tab">Usage & Billing</button></div><div class="v3-usage-grid"><div><span>Total Requests</span><strong>${esc(demoMode?fmtCompact(sv.totalRequests):o.totalRequests)}</strong><small>Selected window</small></div><div><span>Total Tokens</span><strong>${esc(demoMode?fmtCompact(sv.totalTokens):o.totalTokens)}</strong><small>Selected window</small></div><div><span>Estimated Cost</span><strong>${esc(demoMode?sv.estimatedCost:o.estimatedCost)}</strong><small>Ledger-backed</small></div><div><span>Recovered Requests</span><strong>${fmtCompact(sv.recoveredCount||0)}</strong><small>Protected traffic</small></div></div></section>
    <section class="card panel cache-hit-overview"><div class="section-head"><div><h2>Prompt Cache Hit Rate</h2><p>Token-weighted cached input over protocol-normalized eligible input for the selected window.</p></div><span class="cache-hit-method">Final upstream protocol</span></div><div class="cache-hit-grid"><article class="cache-hit-total"><span>Overall cache hit rate</span><strong>${esc(fmtPct(overallCache.hitRate))}</strong><div class="cache-hit-meter large" role="meter" aria-label="Overall cache hit rate" aria-valuemin="0" aria-valuemax="100" ${overallCache.hitRate===null||overallCache.hitRate===undefined?'aria-valuetext="No input-token usage observed"':`aria-valuenow="${cacheRate.toFixed(2)}"`}><i style="width:${cacheRate.toFixed(2)}%"></i></div><p>${overallCache.hitRate===null||overallCache.hitRate===undefined?'No input-token usage observed.':`${esc(fmtCompact(overallCache.cacheReadTokens))} cached of ${esc(fmtCompact(overallCache.eligibleInputTokens))} eligible input tokens.`}</p><div class="cache-hit-total-meta"><div><strong>${esc(fmtCompact(overallCache.cacheWriteTokens))}</strong><small>Cache writes</small></div><div><strong>${esc(fmtCompact(overallCache.observedRequests))}</strong><small>Observed requests</small></div><div><strong>${esc(fmtCompact(overallCache.requests))}</strong><small>Total requests</small></div></div></article>${cacheHitBreakdown('By API key','Every configured key plus historical keys with traffic.',keyCache)}${cacheHitBreakdown('By logical model','Client-facing model cache efficiency.',modelCache)}</div></section>
    <section class="card panel traffic-trends"><div class="section-head"><div><h2>Traffic Trends</h2><p>Request volume and success rate across the selected window. Provider charts use the actual upstream that handled each request.</p></div></div><div class="traffic-chart-grid">${trafficTrendChart('All calls','Every client request, including requests that failed before provider selection.',callSeries)}${trafficTrendChart('Logical model calls','Client-facing model demand and each model’s success rate.',trafficTrends.logicalModels||[])}${trafficTrendChart('Actual provider calls','Final providers that accepted traffic; pre-selection failures are excluded.',trafficTrends.providers||[])}${trafficTrendChart('Actual provider / model calls','Concrete upstream provider and model pairs with their success rates.',trafficTrends.providerModels||[])}</div></section>
    <section class="card panel"><div class="section-head"><div><h2>Recent Runtime Events</h2><p>Latest alerts and automatic recovery activity.</p></div><button class="btn small" data-action="alerts-open">Open alerts</button></div><div class="v3-event-list">${alerts.map(alert=>`<div><span>${badge(alert.state)}</span><span><strong>${esc(alert.title)}</strong><small>${esc(alert.detail||'')}</small></span><button class="btn small" data-action="alert-open-resource" data-kind="${esc(alert.resource_kind)}" data-id="${esc(alert.resource_id)}">Open</button></div>`).join('')||managed.slice(0,3).map(event=>`<div><span>${badge('Recovered')}</span><span><strong>${esc(event.title)}</strong><small>${esc(event.detail)}</small></span></div>`).join('')||'<div class="empty compact-empty">No recent runtime events.</div>'}</div></section>
  </div>`;
}

function requestFilterSummary(){const values=[state.requestLogicalModel&&`Exact logical model ${state.requestLogicalModel}`,state.requestParticipatingProvider&&`Participating provider ${state.requestParticipatingProvider}`,state.requestAttemptStatus&&`Attempt status ${state.requestAttemptStatus}`,state.requestAttemptFailureType&&`Attempt error ${state.requestAttemptFailureType}`,state.requestReportError&&`Client error ${state.requestReportError}`,state.requestConversation&&`Conversation ${state.requestConversation}`,state.requestModel&&`Model ${state.requestModel}`,state.requestProvider&&`Provider ${state.requestProvider}`,state.requestApiKey&&`API Key ${state.requestApiKey}`,state.requestFailureType&&`Failure ${state.requestFailureType}`,state.requestStatus&&`Status ${state.requestStatus}`,state.requestRevision&&`Revision ${state.requestRevision}`,state.requestFrom&&`From ${state.requestFrom}`,state.requestTo&&`To ${state.requestTo}`].filter(Boolean);return values.length?values.join(' · '):'No additional filters';}
function capabilityNames(capabilities){return [['text','text'],['images','images'],['stream','stream'],['tools','tools'],['parallel_tools','parallel tools'],['reasoning','reasoning'],['structured_output','structured output'],['vision','vision'],['priority','Fast (priority)']].filter(([key])=>capabilities?.[key]).map(([,label])=>label)}
function candidateExclusionDetail(exclusion,required){const offered=exclusion.capabilities||{},missing=capabilityNames(Object.fromEntries(Object.entries(required||{}).filter(([key,value])=>value&&!offered[key])));if(Number(required?.min_context||0)>0&&Number(offered.context_window||0)>0&&Number(offered.context_window)<Number(required.min_context))missing.push(`context ${offered.context_window} < ${required.min_context}`);if(Number(required?.min_output||0)>0&&Number(offered.max_output||0)>0&&Number(offered.max_output)<Number(required.min_output))missing.push(`max output ${offered.max_output} < ${required.min_output}`);return [exclusion.reason,missing.length?`Missing: ${missing.join(', ')}`:''].filter(Boolean).join(' · ')}
function pageRequestDetail(id){
  const r=requestDataSync(id);
  if(!r){queueMicrotask(()=>loadAndRenderRequest(id));return `<div class="empty"><strong>Loading request…</strong></div>`}
  if(!state.requestCache.has(id)||!r.trace)queueMicrotask(()=>loadAndRenderRequest(id));
  queueMicrotask(()=>decorateRequestConversationTrigger(r));
  const trace=r.trace||[],routePath=r.routePath||[],exclusions=r.raw?.exclusions||[],debug=r.debug,usageValue=value=>r.usageObserved?fmtCompact(value):'—';
  const traceMarkup=trace.map((t,index)=>`<details class="trace-event ${esc(t.kind)}" ${index<2||t.kind==='error'?'open':''}><summary><time>${esc(t.time)}</time><strong>${esc(t.title)}</strong><span class="trace-duration">${esc(t.latency)}</span></summary><div class="trace-detail ${esc(t.kind)}">${esc(t.sub)}</div></details>`).join('')||'<div class="empty compact-empty"><strong>No trace events recorded</strong></div>';
  return `<div class="page-head"><div class="head-main"><div class="head-line"><button class="btn icon" data-action="requests-page">←</button><h1 class="long-id">Request ${esc(r.id)}</h1>${badge(r.live?r.result:r.canceled?'Canceled':r.failed?'Failed':r.recovered?'Success (Recovered)':'Success')}</div>${requestKeySubtitle(r.apiKey)}</div></div><div class="model-summary request-model-summary"><div class="summary-chip"><strong>${esc(r.logicalModel||r.model)}</strong><small>Logical Model</small></div><div class="summary-chip request-provider-model"><strong>${esc(r.provider||r.providerId||'—')}</strong><small>Provider</small><div><strong>${esc(r.upstreamModel||'—')}</strong><small>Upstream Model</small><strong>${esc(r.responseModel||'—')}</strong><small>Returned Model</small></div></div><div class="summary-chip"><strong>${esc(r.streamMode||'—')}</strong><small>Response Mode</small></div><div class="summary-chip"><strong>${esc(r.ttft||'—')}</strong><small>First Frame / TTFT</small></div><div class="summary-chip"><strong>${esc(r.live?r.elapsedDuration||'—':r.totalDuration||r.latency)}</strong><small>${r.live?nt('Elapsed','已耗时'):nt('Complete Response','完成耗时')}</small></div><div class="summary-chip"><strong>${esc(r.tokenSummary||r.tokens)}</strong><small>Input / Output Tokens</small></div><div class="summary-chip"><strong>${Number.isFinite(r.tokensPerSecond)?r.tokensPerSecond.toFixed(1):'—'}</strong><small>tokens/s</small></div><div class="summary-chip cache-summary-chip"><strong>${esc(r.cacheSummary||'—')}</strong><small>Prompt Cache</small></div><div class="summary-chip request-conversation-summary"><strong class="mono">${esc(r.conversation)}</strong><small>Conversation</small></div><div class="summary-chip"><strong>${esc(r.apiKey)}</strong><small>API Key</small></div></div><div class="grid-2"><section class="card panel"><div class="section-head"><div><h2>Execution Trace</h2><p>Events are ordered by recorded time. Expand a row for evidence.</p></div></div><div class="trace collapsible-trace">${traceMarkup}</div></section><div class="stack"><section class="card panel"><h2>Cost & Pricing</h2>${requestCostDetails(r)}<p class="cell-sub">Historical attempts preserve pricing versions. Exact unit rates are not retained on old attempt records.</p></section><section class="card panel"><h2>Attempt Path</h2>${routePath.map((step,index)=>`<details class="attempt-event" ${step.status==='Failed'?'open':''}><summary>${badge(step.status)}<span>${esc(step.provider||'Unknown Provider')} · ${esc(step.model||'Unknown model')}</span></summary><div class="trace-detail"><div>${step.failure?esc(step.failure):nt('Attempt','尝试')} ${index?`· ${routePath[index-1].provider===step.provider?nt('Provider retry','渠道内重试'):nt('Provider fallback','渠道回退')}`:''}</div><div class="attempt-metrics"><span>${nt('Returned Model:','返回模型：')} ${esc(step.responseModel||'—')}</span><span>${nt('Requested service tier:','请求服务等级：')} ${esc(step.serviceTier||'—')}</span><span>${nt('Returned service tier:','返回服务等级：')} ${esc(step.responseServiceTier||'—')}</span><span>${esc(step.protocol||'—')}</span><span>${nt('First frame','首帧')} ${esc(step.ttft||'—')}</span><span>${nt('Complete','完成耗时')} ${esc(step.latency||'—')}</span><span>${nt('Tokens','Token')} ${esc(step.tokenSummary||step.tokens||'—')}</span><span>${nt('Cache','缓存')} ${esc(step.cacheSummary||'—')}</span><span>${nt('Plan','套餐')} ${esc(step.planKind||'—')}</span><span>${nt('Pricing version','计价版本')} ${esc(step.rateCardVersion||'—')}</span></div></div></details>`).join('')||'<div class="empty compact-empty">No attempt path recorded.</div>'}</section><section class="card panel"><h2>Candidate Exclusions</h2>${exclusions.map((x,index)=>`<div class="split-event"><div><strong>${esc(x.provider_id||`Provider candidate ${index+1}`)} · ${esc(x.upstream_model||'Unknown model')}</strong><div class="cell-sub">${esc(x.connection_id||'Unknown connection')}</div></div><span>${esc(candidateExclusionDetail(x,r.requiredCapabilities))}</span></div>`).join('')||'<div class="empty compact-empty">No candidates were excluded.</div>'}</section><section class="card panel"><h2>Structured Runtime</h2>${[['Result',r.result],['Requested service tier',r.serviceTier||'—'],['Returned service tier',r.responseServiceTier||'—'],['Response mode',r.streamMode||'—'],['Required capabilities',capabilityNames(r.requiredCapabilities).map(name=>({'text':nt('text','文本'),'images':nt('images','图像'),'stream':nt('stream','流式'),'tools':nt('tools','工具调用'),'parallel tools':nt('parallel tools','并行工具调用'),'reasoning':nt('reasoning','推理'),'structured output':nt('structured output','结构化输出'),'vision':nt('vision','视觉')})[name]||name).join(', ')||nt('text','文本')],['First frame / TTFT',r.ttft||'—'],[r.live?nt('Elapsed','已耗时'):'Complete response',r.live?r.elapsedDuration||'—':r.totalDuration||r.latency],['Input tokens',usageValue(r.inputTokens)],['Output tokens',usageValue(r.outputTokens)],['Cache read tokens',usageValue(r.cacheReadTokens)],['Cache write tokens',usageValue(r.cacheWriteTokens)],['Reasoning tokens',usageValue(r.reasoningTokens)],['Attempts',r.attempts],['Provider fallbacks',r.providerFallbacks??'—'],['Conversation rebind',r.conversationRebind==='Yes'?nt('Yes','是'):r.conversationRebind==='No'?nt('No','否'):r.conversationRebind??'—'],['Recovery overhead',r.recoveryOverhead??'—'],['Runtime revision',r.runtimeRevision??'—'],['Protocol',r.raw?.protocol||'—'],['Continuity',r.raw?.continuity_mode||'—'],['Failure type',r.raw?.failure_type||'—'],['Failure message',r.failureMessage||'—']].map(x=>`<div class="inline request-runtime-row"><span class="cell-sub">${x[0]}</span><strong>${esc(x[1])}</strong></div>`).join('')}</section></div></div>${debug?`<div class="grid-2 section"><section class="card panel debug-panel"><div class="section-head"><div><h2>Debug Request</h2><p>${debug.request_truncated?'Truncated at 256 KB':'Captured when the request began'}</p></div><button class="btn small" data-action="copy-debug" data-side="request" data-id="${esc(r.id)}">Copy</button></div><pre>${esc(prettyDebug(debug.request))}</pre></section><section class="card panel debug-panel"><div class="section-head"><div><h2>Debug Response</h2><p>${debug.response_truncated?'Truncated at 256 KB':'Aggregated final response'}</p></div><button class="btn small" data-action="copy-debug" data-side="response" data-id="${esc(r.id)}">Copy</button></div><pre>${esc(prettyDebug(debug.response))}</pre></section></div>`:`<div class="notice section"><strong>No debug payload was recorded</strong><span>Enable Request Debug in Settings before sending a request. The setting applies only to new requests.</span></div>`}`
}
function requestKeySubtitle(name){return name&&name!=="—"?`<small class="cell-sub request-key-subtitle">${nt('API Key','API 密钥')} · ${esc(name)}</small>`:''}
function requestMoney(value){return Number.isFinite(Number(value))?new Intl.NumberFormat('en-US',{style:'currency',currency:'USD',minimumFractionDigits:4,maximumFractionDigits:6}).format(Number(value)):'—'}
function requestPricingLabel(ref){return ({catalog_unavailable:'Waiting for price sync',model_not_found:'Model not in catalog',ambiguous_model:'Multiple catalog providers',usage_unavailable:'Usage unavailable',cache_price_missing:'Cache rate not listed'})[ref?.status]||'Price unavailable'}
function requestReferenceDetails(ref){
  if(!ref)return '<p>No reference catalog snapshot available.</p>';
  const rate=value=>value==null?'Not listed':esc(requestMoney(value)),rates=ref.rates;
  return `<div class="request-reference-details"><h3>Current reference price</h3><p>Standard text-token estimate in USD, excluding tools, media, service-tier adjustments and recovery attempts. It is not the subscription charge or the historical bill.</p>${rates?`${[['Input / 1M',rates.input_per_m],['Output / 1M',rates.output_per_m],['Cache read / 1M',rates.cache_read_per_m],['Cache write / 1M',rates.cache_write_per_m]].map(([label,value])=>`<span><small>${label}</small><b>${rate(value)}</b></span>`).join('')}<span><small>Reference estimate</small><b>${ref.cost==null?esc(requestPricingLabel(ref)):esc(requestMoney(ref.cost))}</b></span>`:`<p>${esc(requestPricingLabel(ref))}</p>`}<p>${esc(ref.source||'Catalog')} · ${esc(ref.provider||'—')} · ${esc(ref.model||'—')}<br>${esc(ref.version||'No snapshot')}<br>Updated ${ref.updated_at&&!ref.updated_at.startsWith('0001-')?esc(new Date(ref.updated_at).toLocaleString()):'—'}${ref.stale?' · Cached / awaiting refresh':''}${ref.tier_above_input_tokens?` · Above ${Number(ref.tier_above_input_tokens).toLocaleString('en-US')} input tokens`:''}</p></div>`;
}
function requestCostDetails(r,expanded=false){
  const raw=r.raw||{},observed=raw.cost_observed===true;
  return `<details ${expanded?'open':''} class="request-cost-details" data-action="request-cost-details"><summary>USD · Cost & pricing</summary><div><p>Recorded estimates in USD. Missing prices do not mean free usage.</p>${[['Total',observed?raw.total_cost:null],['PAYG estimate',observed?raw.estimated_cash_cost:null],['Subscription allocation',observed?raw.allocated_sub_cost:null],['Serving',observed?raw.serving_cost:null],['Recovery overhead',observed?raw.recovery_overhead_cost:null],['Recorded reference token value',raw.shadow_cost||null]].map(([label,value])=>`<span><small>${label}</small><b>${value==null?'—':esc(requestMoney(value))}</b></span>`).join('')}<p>Total includes serving and recovery, with the legacy cash fallback. Subscription allocation is included in those amounts.</p>${requestReferenceDetails(raw.reference_pricing)}<a href="#/requests/${encodeURIComponent(r.id)}">View attempts and pricing versions →</a></div></details>`;
}
// Visual speed bands: TTFT uses 5/10s; total uses 30/15 tokens per second
// for at least 100 output tokens, otherwise 10/30s. Each metric is independent.
function requestTimingTone(milliseconds,outputTokens,firstToken=false){
  const seconds=Number(milliseconds)/1000;
  if(!Number.isFinite(seconds)||seconds<=0)return 'unknown';
  if(firstToken)return seconds<5?'fast':seconds<10?'moderate':'slow';
  if(Number(outputTokens)>=100){const tps=Number(outputTokens)/seconds;return tps>=30?'fast':tps>=15?'moderate':'slow'}
  return seconds<10?'fast':seconds<30?'moderate':'slow';
}
function requestAccountingCells(r){
  const count=value=>r.usageObserved?Number(value||0).toLocaleString('en-US'):'—',raw=r.raw||{},ref=raw.reference_pricing;
  const eligible=Number(raw.cache_eligible_input_tokens),read=Math.max(0,Number(r.cacheReadTokens)||0),percent=r.usageObserved&&eligible>0?`${Math.min(100,read/eligible*100).toFixed(1)}%`:'—';
  const firstTone=requestTimingTone(raw.ttft_ms,r.outputTokens,true),totalTone=r.live?'':requestTimingTone(raw.duration_ms,r.outputTokens);
  const observed=raw.cost_observed===true,estimated=!observed&&ref?.cost!=null,rates=ref?.rates;
  const priceLabel=rates?`$${Number(rates.input_per_m).toLocaleString('en-US')} / $${Number(rates.output_per_m).toLocaleString('en-US')} / 1M`:requestPricingLabel(ref);
  return `<td class="request-token-cell"><strong class="mono">${count(r.inputTokens)} / ${count(r.outputTokens)}</strong><small>Cache ↓ ${count(r.cacheReadTokens)} · ${percent}</small><small>${Number.isFinite(r.tokensPerSecond)?r.tokensPerSecond.toFixed(1):'—'} tokens/s</small></td><td class="request-money-cell"><span class="request-cost-pill">${observed?esc(requestMoney(raw.total_cost)):estimated?`≈ ${esc(requestMoney(ref.cost))}`:'—'}</span><small class="cell-sub">${observed?'Recorded':estimated?'Reference estimate':'No recorded cost'}</small></td><td class="request-timing-cell"><div class="request-timing-metric ${firstTone}"><small>First token</small><strong>${esc(r.ttft||'—')}</strong></div><div class="request-timing-metric ${totalTone}"><small>${r.live?nt('Elapsed','已耗时'):nt('Total','总计')}</small><strong>${esc(r.live?r.elapsedDuration||'—':r.totalDuration||r.latency||'—')}</strong></div></td><td class="request-price-cell request-optional"><button class="btn small" data-action="show-request-cost" data-id="${esc(r.id)}">${esc(priceLabel)}</button><small class="cell-sub">${rates?`Reference · ${esc(ref.source)}${ref.stale?' · Cached':''}`:'Cost details'}</small></td>`;
}
function pageRequests(){
  const list=state.requests,pages=Math.max(1,Math.ceil(state.requestTotal/state.requestLimit)),page=Math.floor(state.requestOffset/state.requestLimit)+1;
  const advancedActive=Boolean(state.requestFrom||state.requestTo||state.requestApiKey||state.requestFailureType||state.requestStatus||state.requestRevision);
  queueMicrotask(decorateRequestWindowOptions);
  return `<div class="page-head requests-page-head"><div class="head-main"><h1>Requests</h1>${state.reportOrigin?`<button class="btn small" data-next="report-return">${nt('Back to report','返回报表')}</button>`:''}<p>${esc(state.requestTotal)} ${nt('matching requests','条匹配请求')}</p></div><div class="head-actions"><button class="btn" data-action="request-export" data-format="json" ${state.requestExporting?'disabled':''}>${state.requestExporting?'Exporting…':'Export all JSON'}</button><button class="btn" data-action="request-export" data-format="csv" ${state.requestExporting?'disabled':''}>${state.requestExporting?'Exporting…':'Export all CSV'}</button></div></div><section class="card request-filter-card"><div class="request-primary-filters"><select class="select" aria-label="Time window" data-action="request-window"><option value="15m" ${state.requestWindow==='15m'?'selected':''}>15 min</option><option value="1h" ${state.requestWindow==='1h'?'selected':''}>1 hour</option><option value="24h" ${state.requestWindow==='24h'?'selected':''}>24 hours</option></select><select class="select" aria-label="Logical model" data-action="request-model"><option value="">All Models</option>${state.models.map(x=>`<option value="${esc(x.id)}" ${state.requestModel===x.id?'selected':''}>${esc(x.id)}</option>`).join('')}</select><select class="select" aria-label="Provider" data-action="request-provider"><option value="">All Providers</option>${state.providers.map(x=>`<option value="${esc(x.id)}" ${state.requestProvider===x.id?'selected':''}>${esc(x.name)}</option>`).join('')}</select><select class="select" aria-label="Outcome" data-action="request-filter"><option value="all" ${state.requestFilter==='all'?'selected':''}>All Outcomes</option><option value="recovered" ${state.requestFilter==='recovered'?'selected':''}>Recovered</option><option value="received" ${state.requestFilter==='received'?'selected':''}>Received</option><option value="waiting" ${state.requestFilter==='waiting'?'selected':''}>Waiting</option><option value="active" ${state.requestFilter==='active'?'selected':''}>Active</option><option value="recovering" ${state.requestFilter==='recovering'?'selected':''}>Recovering</option><option value="streaming" ${state.requestFilter==='streaming'?'selected':''}>Streaming</option><option value="delivering" ${state.requestFilter==='delivering'?'selected':''}>Delivering</option><option value="direct" ${state.requestFilter==='direct'?'selected':''}>Direct</option><option value="failed" ${state.requestFilter==='failed'?'selected':''}>Failed</option><option value="canceled" ${state.requestFilter==='canceled'?'selected':''}>Canceled</option></select><input class="input request-search" aria-label="Search requests" data-input="request-search" value="${esc(state.requestSearch)}" placeholder="Request / conversation / API key"><button class="btn" data-action="request-clear">Clear filters</button><button class="btn primary request-search-submit" data-action="request-search-submit">${icon('search')} Search</button></div><details class="request-advanced" ${advancedActive?'open':''}><summary><span>Advanced filters</span><span class="cell-sub">Exact time, API key, failure and revision</span></summary><div class="request-toolbar"><label class="filter-field"><span>From</span><input class="input" type="datetime-local" data-action="request-from" step="0.001" value="${esc(requestLocalTime(state.requestFrom))}"></label><label class="filter-field"><span>To</span><input class="input" type="datetime-local" data-action="request-to" step="0.001" value="${esc(requestLocalTime(state.requestTo))}"></label><label class="filter-field"><span>API Key</span><select class="select" data-action="request-api-key"><option value="">All API Keys</option>${state.apiKeys.map(x=>`<option value="${esc(x.name)}" ${state.requestApiKey===x.name?'selected':''}>${esc(x.name)}</option>`).join('')}</select></label><label class="filter-field"><span>Failure type</span><input class="input" data-action="request-failure" value="${esc(state.requestFailureType)}" placeholder="Any failure"></label><label class="filter-field"><span>Status</span><input class="input" data-action="request-status" value="${esc(state.requestStatus)}" placeholder="Any status"></label><label class="filter-field"><span>Runtime revision</span><input class="input" inputmode="numeric" data-action="request-revision" value="${esc(state.requestRevision)}" placeholder="Any revision"></label></div></details></section><div class="filter-summary"><span>${esc(requestFilterSummary())}</span><label class="auto-refresh"><input type="checkbox" data-action="request-columns" ${state.requestColumns?'checked':''}> ${nt('Extra columns','更多列')}</label><label class="auto-refresh"><input type="checkbox" data-action="request-auto" ${state.requestAutoRefresh?'checked':''}> Auto refresh · 3s</label><span role="status">${state.requestLoading?'Updating requests…':`Updated ${esc(state.requestLastUpdated?state.requestLastUpdated.toLocaleTimeString():'—')}`}</span></div><section class="card table-wrap fade-edge" aria-busy="${state.requestLoading}"><table class="table requests-table ${state.requestColumns?'':'request-compact'}"><thead><tr><th>Time</th><th>Request ID</th><th>Logical Model</th><th class="request-optional">Conversation</th><th>Provider / Upstream Model</th><th>Result</th><th class="request-optional">Mode</th><th>Tokens · In / Out</th><th>Cost · USD</th><th>Timing</th><th class="request-optional">Details</th></tr></thead><tbody>${list.map(r=>`<tr class="clickable" tabindex="0" role="link" data-action="open-request" data-id="${esc(r.id)}"><td>${esc(r.time)}</td><td class="link mono long-id" title="${esc(r.id)}">${esc(r.id.length>16?r.id.slice(0,8)+'…'+r.id.slice(-5):r.id)}${requestKeySubtitle(r.apiKey)}</td><td>${esc(r.model)}</td><td class="mono long-id request-optional">${esc(r.conversation)}</td><td><div class="cell-title">${esc(r.providerId||r.provider||r.route||'—')}</div><div class="cell-sub">${esc(r.upstreamModel||'—')}</div></td><td>${badge(r.live?r.result:r.canceled?'Canceled':r.failed?'Failed':r.recovered?'Recovered':r.raw?.outcome==='DIRECT_SUCCESS'?'Direct':'Success')}</td><td class="request-optional">${esc(r.streamMode||'—')}</td>${requestAccountingCells(r)}</tr>`).join('')||'<tr><td colspan="11"><div class="empty compact-empty"><strong>No matching requests</strong>Clear filters or widen the window.</div></td></tr>'}</tbody></table></section><div class="pagination"><button class="btn" data-action="request-page" data-offset="${Math.max(0,state.requestOffset-state.requestLimit)}" ${page<=1||state.requestLoading?'disabled':''}>Previous</button><span>Page ${page} / ${pages}</span><select class="select" aria-label="Requests per page" data-action="request-limit" ${state.requestLoading?'disabled':''}>${[25,50,100].map(x=>`<option ${state.requestLimit===x?'selected':''}>${x}</option>`).join('')}</select><button class="btn" data-action="request-page" data-offset="${state.requestOffset+state.requestLimit}" ${page>=pages||state.requestLoading?'disabled':''}>Next page</button></div>`;
}

function pageApiKeys(){
  const q=state.keySearch.toLowerCase(),list=state.apiKeys.filter(k=>!q||k.name.toLowerCase().includes(q)||k.scope.toLowerCase().includes(q));
  const rows=list.map(k=>{const canUse=k.status!=='Revoked',revealTitle=k.revealable?'Reveal full API key':'Legacy hash-only key; change it once to enable reveal';return `<tr><td class="api-key-name" data-label="Name"><button class="link-button cell-title" data-action="open-key" data-id="${esc(k.id)}">${esc(k.name)}</button></td><td class="api-key-secret" data-label="Secret"><div class="api-key-secret-cell"><span class="mono">${esc(k.preview)}</span>${canUse?`<span class="api-key-secret-actions"><button class="btn small ${k.revealable?'':'legacy-secret'}" title="${esc(revealTitle)}" data-action="reveal-key" data-id="${esc(k.id)}">Reveal</button><button class="btn small ${k.revealable?'':'legacy-secret'}" title="${esc(revealTitle)}" data-action="copy-stored-key" data-id="${esc(k.id)}">Copy</button></span>`:''}</div></td><td class="api-key-status" data-label="Status">${badge(k.status)}</td><td class="api-key-access" data-label="Access">${esc(k.scope)}</td><td class="api-key-usage" data-label="Usage">${k.usage==='—'||k.usage==null?nt('Unavailable','暂不可用'):esc(k.usage)+' '+nt('req/min','次/分钟')}</td><td class="api-key-created" data-label="Created">${esc(k.createdAt?new Date(k.createdAt).toLocaleDateString(consoleLocale):k.created)}</td><td class="api-key-actions" data-label="Actions"><div class="api-key-actions"><button class="btn small" data-action="open-key" data-id="${esc(k.id)}">Details</button><details class="v3-more-menu api-key-more"><summary class="btn small">More ${icon('down')}</summary><div class="v3-more-popover">${canUse?`<button data-action="edit-key-policy" data-id="${esc(k.id)}">Access & Limits</button><button data-action="rotate-key" data-id="${esc(k.id)}">Change Key</button><button class="${k.status==='Active'?'toggle-disable':'toggle-enable'}" data-action="toggle-key" data-id="${esc(k.id)}" data-enabled="${k.status!=='Active'}">${k.status==='Active'?'Disable':'Enable'}</button><button class="danger" data-action="revoke-key" data-id="${esc(k.id)}">Revoke permanently</button>`:`<button class="danger" data-action="delete-key" data-id="${esc(k.id)}">Delete metadata</button>`}</div></details></div></td></tr>`}).join('');
  return `<div class="page-head"><div class="head-main"><h1>API Keys</h1></div><button class="btn primary" data-action="create-key">${icon('plus')} Create API Key</button></div><div class="toolbar"><input class="input" data-input="key-search" value="${esc(state.keySearch)}" placeholder="Search API keys…"></div><section class="card table-wrap api-keys-wrap"><table class="table api-keys-table"><thead><tr><th>Name</th><th>Secret</th><th>Status</th><th>Access</th><th>Usage</th><th>Created</th><th>Actions</th></tr></thead><tbody>${rows||'<tr class="api-key-empty-row"><td colspan="7"><div class="empty"><strong>No API keys</strong>Create a least-privilege client key.</div></td></tr>'}</tbody></table></section>`
}

function apiKeySecretActivity(key,secret){if(secret.last_used_at)return new Date(secret.last_used_at).toLocaleString();if(secret.state==='ACTIVE'&&key.lastRequestAt)return `${new Date(key.lastRequestAt).toLocaleString()} (key-level activity)`;return 'never recorded'}
function apiKeyDetailModal(modal){const k=modal.key,usage=k.usageSummary||{},recent=k.recentRequests||[],canReveal=k.status!=='Revoked';return `<div class="modal-backdrop" data-action="close-overlay"><div class="modal" data-modal-stop><div class="modal-head"><div><h2>${esc(k.name)}</h2><div class="cell-sub">${esc(k.preview)} · ${esc(k.status)} · Last 30 days</div></div><button class="btn icon ghost" data-action="close-overlay">×</button></div><div class="modal-body"><div class="grid-equal"><div class="summary-chip"><strong>${esc(usage.requests??'—')}</strong><small>Requests</small></div><div class="summary-chip"><strong>${esc(usage.failed??'—')}</strong><small>Failures</small></div><div class="summary-chip"><strong>${esc(usage.tokens_observed||usage.requests===0?Number(usage.input_tokens||0)+Number(usage.output_tokens||0):nt('Unavailable','暂不可用'))}</strong><small>Tokens</small></div><div class="summary-chip"><strong>${esc(usage.cost_observed?usage.total_cost:usage.requests===0?0:nt('Not recorded','未记录'))}</strong><small>Cost</small></div></div><div class="section"><h3>Credential lifecycle</h3>${k.secrets.map(s=>`<div class="split-event"><div><strong class="mono">${esc(s.preview)}</strong><div class="cell-sub">Created ${esc(new Date(s.created_at).toLocaleString())} · Last activity ${esc(apiKeySecretActivity(k,s))}</div></div>${badge(s.state)}${s.state==='GRACE'?`<button class="btn small danger" data-action="retire-key-secret" data-key="${esc(k.id)}" data-id="${esc(s.id)}">Retire</button>`:''}</div>`).join('')||'<div class="empty">No secret metadata.</div>'}</div><div class="section"><h3>Recent requests</h3>${recent.map(r=>`<button class="revision-row revision-button" data-action="open-request" data-id="${esc(r.id)}"><span class="mono long-id">${esc(r.id)}</span><strong>${esc(r.logical_model_id||r.model||'—')}</strong>${badge(r.outcome||r.status)}</button>`).join('')||'<div class="empty">No requests in the last 30 days.</div>'}</div><div class="notice"><strong>Access & limits</strong><span>Models: ${esc(k.scope)} · Protocols: ${esc((k.identity.scope_protocols||[]).join(', ')||'All')} · Expires: ${esc(k.identity.expires_at||'Never')} · ${esc(k.identity.rate_limit_rpm||'Unlimited')} RPM · Budget ${esc(k.identity.monthly_budget_usd||'Unlimited')}</span></div></div><div class="modal-foot api-key-detail-actions"><button class="btn" data-action="api-key-requests" data-id="${esc(k.name)}">View requests</button>${canReveal?`<button class="btn" data-action="reveal-key" data-id="${esc(k.id)}">Reveal</button><button class="btn" data-action="copy-stored-key" data-id="${esc(k.id)}">Copy</button>`:''}<button class="btn primary" data-action="close-overlay">Done</button></div></div></div>`}

function settingsRevisions(){return `<section class="card panel"><div class="section-head"><div><h2>Audit & Revisions</h2><p>Open a revision for its actor, source, resources, and before/after diff.</p></div></div>${state.revisions.map(r=>`<button class="revision-row revision-button" data-action="revision-detail" data-id="${r.id}"><span class="badge blue">#${r.id}</span><div><div class="cell-title">${esc(r.summary)}</div><div class="cell-sub">${esc(r.time)} · ${esc(r.actor)} · ${esc(r.source||'system')}</div></div><strong>${esc(r.scope)}</strong>${badge(r.status)}</button>`).join('')||'<div class="empty"><strong>No runtime revisions are available</strong></div>'}</section>`}
function billingUsageTable(rows, dimension) {
  if (!rows.length) return '<div class="empty">No requests recorded in this window.</div>';
  return `<div class="table-wrap billing-table-wrap"><table class="table billing-table"><thead><tr><th>${dimension}</th><th>Requests</th><th>Tokens</th><th>Recorded cost</th></tr></thead><tbody>${rows.map(row=>`<tr><td><strong>${esc(row.name)}</strong><small>${fmtCompact(row.failed)} failed · ${fmtCompact(row.canceled)} canceled</small></td><td>${fmtCompact(row.requests)}</td><td>${fmtCompact(row.tokens)}</td><td><span class="request-cost-pill">${esc(row.amount)}</span></td></tr>`).join('')}</tbody></table></div>`;
}

function settingsBilling(){
  const b=state.billing, points=(b.trend||[]).map(x=>Number(x.total_cost||0)), loading=state.usageLoading.billing;
  return `${settingsPricingSync()}<div class="page-head compact"><div><h2>Usage & Billing</h2><p>Costs are recorded estimates. Unobserved cost is shown as —; unknown prices do not imply free usage.</p></div><div class="head-actions"><select class="select" aria-label="Billing time window" data-action="billing-window" ${loading?'disabled':''}><option value="24h" ${state.billingWindow==='24h'?'selected':''}>24 hours</option><option value="168h" ${state.billingWindow==='168h'?'selected':''}>7 days</option><option value="720h" ${state.billingWindow==='720h'?'selected':''}>30 days</option></select><button class="btn" data-action="billing-export" ${loading||!b.reconciliation?'disabled':''}>Export reconciliation JSON</button>${loading?'<span role="status">Updating usage…</span>':''}</div></div>
    <div class="metrics"><div class="card metric"><div class="metric-label">Recorded Cost</div><div class="metric-value">${esc(b.totalCost)}</div><div class="metric-trend">${b.costObserved?sparkline(points):'No monetary cost observed'}</div></div><div class="card metric"><div class="metric-label">Requests</div><div class="metric-value">${esc(b.totalRequests)}</div><div class="metric-note">${b.recoveredRequests??'—'} recovered · ${b.failedRequests??'—'} failed · ${b.canceledRequests??'—'} canceled</div></div><div class="card metric"><div class="metric-label">Tokens</div><div class="metric-value">${esc(b.totalTokens)}</div></div><div class="card metric"><div class="metric-label">Avg / 1K Tokens</div><div class="metric-value">${esc(b.avgCost)}</div></div></div>
    <div class="billing-details"><section class="card panel"><h2>Provider detail</h2><p class="cell-sub">Requests without an upstream selection remain in the totals.</p>${billingUsageTable(b.providers,'Provider')}</section><section class="card panel"><h2>Model detail</h2>${billingUsageTable(b.models,'Logical model')}</section></div>
    <div class="notice"><strong>Reconciliation</strong><span>Export includes exact counts, token and cost dimensions, and UTC window boundaries. Cancellations are separate above and count as unsuccessful in client success rates. Costs cover recorded amounts only.</span></div>
    <div class="notice"><strong>Budgets and warnings</strong><span>Per-key monthly budgets are enforced against recorded cost. Missing prices can undercount budget consumption. Runtime quota/cooling and key spikes produce persistent in-app alerts.</span></div>`;
}

window.addEventListener('hashchange',()=>{queueTargetLocation='';providerQuotaView='';state.mobileNav=false;state.insightsOpen=false;state.drawer=null;if(!state.modal?.busy)state.modal=null;if(applyReportLocation()){reloadRequests();return;}render();});
if(!location.hash) location.hash='#/overview';
boot().then(()=>pollCodexUsageResets());
// Poll only the local intent journal; never dispatch upstream operations.
setInterval(()=>{void pollCodexUsageResets()},15000);
window.addEventListener('focus',()=>{void pollCodexUsageResets()});
