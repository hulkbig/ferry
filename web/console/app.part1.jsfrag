setInterval(()=>{
  const connections=[...(state.providers||[]).flatMap(provider=>provider.connectionItems||[]),
    ...[...state.providerCache.values()].flatMap(entry=>entry.connections||[])];
  if([...state.connectionTests.values()].some(test=>test.loading)||connections.some(connection=>(connection?.retryAt&&Date.parse(connection.retryAt)>Date.now())||connection?.recoveryState==='probing'))render();
},1000);

const esc = value => String(value ?? '').replace(/[&<>'"]/g, ch => ({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[ch]));
const fmtPct = value => value === null || value === undefined || Number.isNaN(Number(value)) ? '—' : `${Number(value).toFixed(Number(value) < 10 ? 2 : 1)}%`;
const fmtCompact = value => value === null || value === undefined || Number.isNaN(Number(value)) ? '—' : new Intl.NumberFormat('en',{notation:'compact',maximumFractionDigits:2}).format(Number(value));
const fmtCapacity = value => value === null || value === undefined ? '—' : `${Math.round(Number(value))}%`;
const emptyOverview = () => ({
  systemStatus:'Unavailable', requestRate:'—', tokenRate:'—', activeConversations:'—', medianLatency:'—', recoveryOverhead:'—', hasTraffic:false,
  directSuccessPct:0, recoveredPct:0, failedPct:0, recoveredCount:0, providerFallbacks:null, needsAttention:0,
  totalRequests:'—', totalTokens:'—', estimatedCost:'—', managedEvents:[], trend:[], trafficTrends:{logicalModels:[],providers:[],providerModels:[]},
  cacheHit:{overall:{hitRate:null,requests:0,observedRequests:0,eligibleInputTokens:0,cacheReadTokens:0,cacheWriteTokens:0},apiKeys:[],logicalModels:[]},
});
const statusTone = status => {
  const s = String(status || '').toLowerCase();
  if (['healthy','active','serving','applied','success','protected','available','route available','recorded'].includes(s)) return 'green';
  if (['recovering','cooling','warning','standby','attention','needs attention','route degraded'].includes(s)) return 'orange';
  if (['unavailable','route unavailable','exhausted','degraded','revoked','disabled','failed','error'].includes(s)) return 'red';
  return 'blue';
};
const badge = status => `<span class="badge ${statusTone(status)}"><span class="status-dot ${statusTone(status)}"></span>${esc(status)}</span>`;
const routeAvailabilityLabel = status => {
  const value = String(status || '').toLowerCase();
  if (['healthy','serving','standby','available','route available'].includes(value)) return 'Route available';
  if (['recovering','cooling','warning','degraded','route degraded'].includes(value)) return 'Route degraded';
  return 'Route unavailable';
};
const icon = (name) => {
  const paths = {
    overview:'<path d="M4 13h6V4H4v9Zm10 7h6v-9h-6v9ZM4 20h6v-3H4v3Zm10-13h6V4h-6v3Z"/>',
    models:'<circle cx="6" cy="6" r="2"/><circle cx="18" cy="6" r="2"/><circle cx="12" cy="18" r="2"/><path d="m8 7 3 8m5-8-3 8M8 6h8"/>',
    providers:'<rect x="4" y="4" width="16" height="6" rx="2"/><rect x="4" y="14" width="16" height="6" rx="2"/><path d="M8 7h.01M8 17h.01M12 7h5M12 17h5"/>',
    requests:'<path d="M7 3h8l4 4v14H7z"/><path d="M15 3v5h5M10 12h6M10 16h6"/>',
    keys:'<circle cx="8" cy="15" r="4"/><path d="m11 12 8-8m-3 3 2 2m-5 1 2 2"/>',
    settings:'<circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.9l.1.1-2.8 2.8-.1-.1a1.7 1.7 0 0 0-1.9-.3 1.7 1.7 0 0 0-1 1.6v.2h-4V21a1.7 1.7 0 0 0-1-1.6 1.7 1.7 0 0 0-1.9.3l-.1.1L4.2 17l.1-.1a1.7 1.7 0 0 0 .3-1.9A1.7 1.7 0 0 0 3 14H2.8v-4H3a1.7 1.7 0 0 0 1.6-1 1.7 1.7 0 0 0-.3-1.9L4.2 7 7 4.2l.1.1a1.7 1.7 0 0 0 1.9.3A1.7 1.7 0 0 0 10 3V2.8h4V3a1.7 1.7 0 0 0 1 1.6 1.7 1.7 0 0 0 1.9-.3l.1-.1L19.8 7l-.1.1a1.7 1.7 0 0 0-.3 1.9 1.7 1.7 0 0 0 1.6 1h.2v4H21a1.7 1.7 0 0 0-1.6 1Z"/>',
    menu:'<path d="M4 7h16M4 12h16M4 17h16"/>',
    plus:'<path d="M12 5v14M5 12h14"/>',
    refresh:'<path d="M20 11a8 8 0 1 0-2.34 5.66M20 4v7h-7"/>',
    search:'<circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/>',
    arrow:'<path d="M5 12h14m-5-5 5 5-5 5"/>',
    check:'<path d="m5 12 4 4L19 6"/>',
    alert:'<path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9M10 21h4"/>',
    spark:'<path d="m12 3 1.3 4.2L17 9l-3.7 1.8L12 15l-1.3-4.2L7 9l3.7-1.8L12 3ZM5 15l.8 2.2L8 18l-2.2.8L5 21l-.8-2.2L2 18l2.2-.8L5 15Zm14-2 .7 1.8 1.8.7-1.8.7L19 18l-.7-1.8-1.8-.7 1.8-.7L19 13Z"/>',
    logout:'<path d="M10 5H5v14h5M14 8l4 4-4 4m-6-4h10"/>',
    more:'<circle cx="5" cy="12" r="1"/><circle cx="12" cy="12" r="1"/><circle cx="19" cy="12" r="1"/>',
    close:'<path d="m6 6 12 12M18 6 6 18"/>',
    back:'<path d="m15 18-6-6 6-6"/>',
    up:'<path d="m7 14 5-5 5 5"/>',
    down:'<path d="m7 10 5 5 5-5"/>',
    edit:'<path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L8 18l-4 1 1-4Z"/>',
    play:'<path d="m8 5 11 7-11 7Z"/>',
    route:'<circle cx="6" cy="6" r="2"/><circle cx="18" cy="18" r="2"/><path d="M8 6h4a4 4 0 0 1 4 4v6"/>',
    copy:'<rect x="8" y="8" width="11" height="11" rx="2"/><path d="M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2"/>',
    trash:'<path d="M4 7h16M10 11v6m4-6v6M9 7V4h6v3m3 0-1 14H7L6 7"/>',
  };
  if (!paths[name]) return ({warn:'!'}[name] || '•');
  return `<svg class="ui-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">${paths[name]}</svg>`;
};

const resourceHash = (section,id) => `#/${section}/${encodeURIComponent(String(id ?? ''))}`;
function currentRoute() {
  const raw = location.hash.split('?')[0].replace(/^#\/?/, '') || 'overview';
  const parts = raw.split('/').filter(Boolean);
  let id = parts.length > 1 ? parts.slice(1).join('/') : null;
  if(id){try{id=decodeURIComponent(id)}catch{}}
  return { raw, section: parts[0] || 'overview', id };
}

async function boot() {
  clearCodexUsageResetState();
  state.analyticsCache.clear(); state.analyticsTo=new Date().toISOString(); applyReportLocation();
  providerQuotaView=''; invalidateProviderCodexUsage(); state.providerCache.clear(); state.modelCache.clear();
  state.loading = true; state.error = null; state.partialErrors = [];
  try {
    state.auth = await adapter.getAuthStatus();
  } catch (error) {
    state.loading = false; state.error = error; render(); return;
  }
  if (!state.auth.initialized || !state.auth.authenticated) {
    state.loading = false; render(); return;
  }
  const entries = [
    ['overview', adapter.getOverview(state.overviewWindow)], ['models', adapter.getModels(state.overviewWindow)], ['providers', adapter.getProviders()],
    ['requests', adapter.getRequests(requestFilters())], ['apiKeys', adapter.getApiKeys()],
    ['revisions', adapter.getRevisions()], ['billing', adapter.getBilling(state.billingWindow)], ['securityEvents', adapter.getSecurityEvents()],
    ['managementTokens', adapter.getManagementTokens()],
    ['alertEnvelope', adapter.getAlerts()], ['settings', adapter.getSettings()],
  ];
  const settled = await Promise.allSettled(entries.map(([, promise]) => promise));
  let successes = 0;
  settled.forEach((result, index) => {
    const key = entries[index][0];
    if (result.status === 'fulfilled') { state[key] = result.value; successes++; }
    else state.partialErrors.push({ key, error:result.reason });
  });
  state.overview ||= emptyOverview(); state.models ||= []; state.providers ||= []; state.requests ||= [];
  state.apiKeys ||= []; state.revisions ||= []; state.securityEvents ||= []; state.managementTokens ||= [];
  if(state.alertEnvelope){state.alerts=state.alertEnvelope.alerts||[];state.alertUnread=Number(state.alertEnvelope.unread||0)}
  if(Array.isArray(state.requests)){state.requestTotal=Number(state.requests.total||state.requests.length);state.requestLastUpdated=new Date()}
  state.billing ||= { totalCost:'—',totalRequests:'—',totalTokens:'—',avgCost:'—',providers:[],models:[] };
  state.loading = false;
  if (!successes) state.error = state.partialErrors[0]?.error || new Error('Every console API failed.');
  render();
}

async function changeUsageWindow(kind, window) {
  if (state.usageLoading[kind]) return;
  state.usageLoading[kind] = true;
  render();
  try {
    if (kind === 'overview') {
      const [overview, models] = await Promise.all([adapter.getOverview(window), adapter.getModels(window)]);
      Object.assign(state, { overview, models, overviewWindow:window });
    } else {
      const billing = await adapter.getBilling(window);
      Object.assign(state, { billing, billingWindow:window });
    }
  } catch (error) {
    showToast(`Unable to update ${kind}: ${error.message}`, 'error');
  } finally {
    state.usageLoading[kind] = false;
    render();
  }
}

async function ensureModel(id) {
  if (!state.modelCache.has(id)) state.modelCache.set(id, await adapter.getModel(id));
  return state.modelCache.get(id);
}
async function ensureProvider(id) {
  if (!state.providerCache.has(id)) state.providerCache.set(id, await adapter.getProvider(id));
  return state.providerCache.get(id);
}
