  {id:'anthropic',label:'Anthropic',path:'/messages',convertible:true},
  {id:'openai-images',label:'OpenAI Images',path:'/images/generations',secondaryPath:'/images/edits',convertible:false},
];
const providerChannelConversionProfiles={
  'all-text':providerProtocolMeta.filter(item=>item.convertible).map(item=>item.id),
};
