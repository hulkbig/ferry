];
function providerChannelPreset(id){return providerChannelPresets.find(item=>item.id===id)||providerChannelPresets[0]}
function providerChannelConversionProtocols(preset){return [...(providerChannelConversionProfiles[preset?.conversion]||[])]}
function providerChannelPresetOptions(selected){const groups=[...new Set(providerChannelPresets.map(item=>item.group))];return groups.map(group=>`<optgroup label="${esc(group)}">${providerChannelPresets.filter(item=>item.group===group).map(item=>`<option value="${esc(item.id)}" ${item.id===selected?'selected':''}>${esc(item.label)}</option>`).join('')}</optgroup>`).join('')}
function providerChannelPresetSettings(w){const preset=providerChannelPreset(w.channelPreset),endpoint=preset.baseUrl||'Enter your own compatible Base URL',primary=providerProtocolMeta.find(item=>item.id===preset.protocol),clientProtocols=providerChannelConversionProtocols(preset).map(id=>providerProtocolMeta.find(item=>item.id===id)?.label||id);return `<section class="provider-channel-preset"><div class="provider-channel-preset-head"><div><span class="protocol-kicker">QUICK START</span><h3>Channel preset</h3><p>Choose a known channel to prefill the editable endpoint and Ferry text conversion policy. Credentials are never supplied by a preset.</p></div><div class="field"><label for="provider-channel-preset">Channel</label><select id="provider-channel-preset" data-wizard="provider-channel-preset">${providerChannelPresetOptions(preset.id)}</select></div></div><div class="provider-channel-preset-summary"><span><strong>${esc(preset.label)}</strong><small>${esc(preset.kind)}</small></span><code>${esc(endpoint)}</code></div><div class="provider-channel-conversion"><span><small>STARTING NATIVE PROBE</small><strong>${esc(primary?.label||preset.protocol)}</strong></span><span><small>TEXT CLIENT ACCESS</small><strong>${esc(clientProtocols.join(' · '))}</strong></span><span><small>ROUTING</small><strong>Native first · lossless conversion fallback</strong></span></div><p class="provider-channel-preset-note">${esc(preset.description)} The preset enables all three text client protocols; <strong>OpenAI Images remains native-only</strong>. Models and native protocol capabilities still come from <strong>Detect native support</strong>, not a stale preset list. A request with native-only features is rejected from an incompatible bridge instead of being silently downgraded. Choosing another named channel clears the current credential and detected supply.</p></section>`}
function applyProviderChannelPreset(w,id){const next=providerChannelPreset(id),previous=providerChannelPreset(w.channelPreset);if(next.id===previous.id)return;if(next.id==='custom'){w.channelPreset=next.id;return}const replaceName=!String(w.name||'').trim()||String(w.name||'').trim()===previous.name,conversionProtocols=new Set(providerChannelConversionProtocols(next));w.channelPreset=next.id;w.baseUrl=next.baseUrl;w.activeProtocol=next.protocol;if(replaceName)w.name=next.name;w.secret='';w.credentialRef='';w.catalog=[];w.probeError='';w.modelSync=null;w.modelSyncDirty=true;w.modelSyncRunning=false;w.modelSyncCatalogMode='provider';w.modelSyncCatalog=next.modelSyncCatalogPlan?{type:'volcengine-plan',plan:next.modelSyncCatalogPlan,credentialRef:''}:null;w.modelSyncCatalogReplace=false;w.modelSyncCatalogCredential={accessKeyId:'',secretAccessKey:'',sessionToken:''};w.probeGeneration=(w.probeGeneration||0)+1;w.probing=false;w.probeCompleted=0;w.probeTotal=0;w.scheduledMessage.enabled=false;w.scheduledMessage.upstreamModel='';for(const protocol of w.protocols){const meta=providerProtocolMeta.find(item=>item.id===protocol.protocol);protocol.connectionId='';protocol.connectionIdentity='';protocol.connectionEnabled=true;protocol.connectionConcurrency=null;protocol.baseUrl=next.protocolBaseUrls?.[protocol.protocol]||'';protocol.overrideUrl=Boolean(protocol.baseUrl);protocol.urlMode='base';protocol.fullUrl='';protocol.secret='';protocol.credentialRef='';protocol.overrideKey=false;protocol.models=[];protocol.manualModels=[];protocol.modelSpecs={};protocol.modelResults=[];protocol.autoConvert=meta?.convertible!==false&&conversionProtocols.has(protocol.protocol);protocol.status='idle';protocol.error='';protocol.probeStartedAt=0;protocol.probeElapsedMs=null;protocol.modelInput=''}}
const providerCapabilityMeta=[['text','Text'],['images','Image generation / edit'],['stream','Streaming'],['tools','Tools'],['parallel_tools','Parallel tools'],['reasoning','Reasoning'],['structured_output','Structured output'],['vision','Vision input'],['priority','Fast (priority)']];
function providerDefaultModelCapabilities(protocol){const images=protocol==='openai-images';return {text:!images,images,stream:false,tools:false,parallel_tools:false,reasoning:false,structured_output:false,vision:false,priority:false,context_window:0,max_output:0}}
function providerNormalizedModelCapabilities(protocol,model,declared={}){return {...providerDefaultModelCapabilities(protocol),...declared}}
function providerProtocolModelSpec(protocol,model){protocol.modelSpecs||={};if(!protocol.modelSpecs[model])protocol.modelSpecs[model]={capabilities:providerNormalizedModelCapabilities(protocol.protocol,model)};const spec=protocol.modelSpecs[model];spec.capabilities=providerNormalizedModelCapabilities(protocol.protocol,model,spec.capabilities);return spec}
function providerModelCapabilitySettings(protocol){const models=protocol.models||[];if(!models.length)return '';const rows=models.map(model=>{const spec=providerProtocolModelSpec(protocol,model),caps=spec.capabilities,enabled=providerCapabilityMeta.filter(([key])=>caps[key]).map(([,label])=>label);return `<details class="provider-model-capability"><summary><span><strong class="mono">${esc(model)}</strong><small>${esc(enabled.join(' · ')||'No declared capabilities')}</small></span><b>Capabilities</b></summary><div class="provider-model-capability-grid"><div class="provider-model-capability-checks">${providerCapabilityMeta.map(([key,label])=>`<label><input type="checkbox" data-wizard="provider-model-capability" data-model="${esc(model)}" data-capability="${key}" ${caps[key]?'checked':''}> ${label}</label>`).join('')}</div><div class="field"><label>Context window</label><input type="number" min="0" step="1" data-wizard="provider-model-context" data-model="${esc(model)}" value="${esc(caps.context_window||0)}"><span class="hint">Tokens; 0 means unknown.</span></div><div class="field"><label>Maximum output</label><input type="number" min="0" step="1" data-wizard="provider-model-max-output" data-model="${esc(model)}" value="${esc(caps.max_output||0)}"><span class="hint">Tokens; 0 means unknown.</span></div></div></details>`}).join('');return `<section class="provider-model-capabilities"><header><div><span class="protocol-kicker">SCHEDULER CONTRACT</span><h4>Model capabilities</h4><p>Combines saved declarations with cached endpoint evidence for this Provider, model and native protocol.</p></div><span class="provider-capability-policy">Strict fallback · no silent downgrade</span></header><p class="provider-capability-note">Verification can record Text, Streaming, Images, Tools, Parallel tools, Reasoning, native Structured output, and Vision. A complete cache hit sends no inference request; only Management API refresh=true forces re-verification. Fast (priority), Context window and Maximum output require an authoritative catalog or operator declaration. Fast applies to OpenAI Chat / Responses; accepting a parameter or a short response time does not prove priority processing.</p>${rows}</section>`}
function newProviderProtocol(id){const meta=providerProtocolMeta.find(item=>item.id===id);return {protocol:id,connectionId:'',connectionIdentity:'',connectionEnabled:true,connectionConcurrency:null,baseUrl:'',fullUrl:'',urlMode:'base',overrideUrl:false,secret:'',credentialRef:'',overrideKey:false,models:[],manualModels:[],modelSpecs:{},autoConvert:meta?.convertible!==false,status:'idle',error:'',modelInput:'',modelResults:[],probeStartedAt:0,probeElapsedMs:null}}
function providerConcurrencyDefaults(){return {maxConcurrent:0,maxQueue:256,maxWaitSeconds:120,queueWhenFull:true,queueOnThrottle:true}}
function newProviderEditor(){return {providerId:'',type:'custom',channelPreset:'custom',name:'',baseUrl:'',secret:'',credentialRef:'',enabled:true,activeProtocol:'openai-chat',protocols:providerProtocolMeta.map(item=>newProviderProtocol(item.id)),catalog:[],probing:false,probeCompleted:0,probeTotal:0,probeGeneration:0,probeError:'',modelSyncInterval:'1h',modelSync:null,modelSyncDirty:false,modelSyncRunning:false,modelSyncCatalogMode:'provider',modelSyncCatalog:null,modelSyncCatalogReplace:false,modelSyncCatalogCredential:{accessKeyId:'',secretAccessKey:'',sessionToken:''},scheduledMessage:{enabled:false,upstreamModel:'',message:''},concurrencyOverride:false,concurrency:providerConcurrencyDefaults()}}
function providerEditorEvidenceID(w){return w.providerId||''}
function applyProviderProbeEvidence(protocol,result){if(!result?.model)return;const caps=providerProtocolModelSpec(protocol,result.model).capabilities,evidence=Array.isArray(result.capability_evidence)?result.capability_evidence:[];if(evidence.length){for(const item of evidence){if(!providerCapabilityMeta.some(([key])=>key===item.capability))continue;if(item.status==='supported')caps[item.capability]=true;else if(item.status==='unsupported')caps[item.capability]=false}return}if(result.status!=='verified')return;if(protocol.protocol==='openai-images'){caps.text=false;caps.images=true;caps.stream=false;caps.vision=false}else{caps.text=true;caps.stream=true}}
function newCodexProviderEditor(){return {step:2,type:'cliproxy-codex',name:'Codex',baseUrl:'https://chatgpt.com/backend-api/codex',authType:'OAuth',authMethod:'OAuth',authFile:null,authFileName:'',account:'personal',models:['gpt-5.6-sol'],modelOptions:[],modelFilter:'',modelsLoading:false,modelsLoaded:false,modelsError:'',protocol:'openai-responses',secret:'',credentialRef:'',modelSyncInterval:'1h',modelSync:null,modelSyncDirty:false,modelSyncRunning:false,scheduledMessage:{enabled:false,upstreamModel:'',message:''},concurrencyOverride:false,concurrency:providerConcurrencyDefaults()}}
function providerEntrySwitch(active){const chooser=active==='custom'&&!state.wizard.provider?.nativeOAuth?providerChannelPresetSettings(state.wizard.provider):'';return `<div class="provider-entry-switch" role="tablist" aria-label="Provider setup method"><button type="button" role="tab" aria-selected="${active==='custom'}" class="provider-entry-option ${active==='custom'?'active':''}" data-action="provider-config-mode"><strong>API Configuration</strong><small>Endpoint, key, protocols, and native models</small></button><button type="button" role="tab" aria-selected="${active==='cliproxy-codex'}" class="provider-entry-option ${active==='cliproxy-codex'?'active':''}" data-action="provider-oauth-mode"><strong>Codex OAuth</strong><small>Sign in with a ChatGPT/Codex subscription account</small></button></div>${chooser}`}
function providerConcurrencyPayload(w){if(!w?.concurrencyOverride)return null;const c=w.concurrency||providerConcurrencyDefaults();return {max_concurrent:Number(c.maxConcurrent||0),max_queue:Number(c.maxQueue||0),max_wait_seconds:Number(c.maxWaitSeconds||0),queue_when_full:Boolean(c.queueWhenFull),queue_on_throttle:Boolean(c.queueOnThrottle)}}
function validateProviderConcurrency(w){if(!w?.concurrencyOverride)return '';const c=w.concurrency||providerConcurrencyDefaults();if(!Number.isInteger(Number(c.maxConcurrent))||Number(c.maxConcurrent)<0)return 'Max concurrent requests must be a non-negative integer.';if(!Number.isInteger(Number(c.maxQueue))||Number(c.maxQueue)<0)return 'Maximum queued requests must be a non-negative integer.';if(!Number.isInteger(Number(c.maxWaitSeconds))||Number(c.maxWaitSeconds)<0||Number(c.maxWaitSeconds)>1800)return 'Queue wait timeout must be an integer from 0 to 1800 seconds.';return ''}
function providerAdmissionSettings(w){const c=w.concurrency||providerConcurrencyDefaults(),queue=Boolean(c.queueWhenFull),usesQueue=queue||Boolean(c.queueOnThrottle);return `<section class="provider-admission-override"><div class="provider-admission-head"><div><span class="protocol-kicker">RUNTIME LIMITS</span><h3>Admission override</h3><p>Inherit the global runtime defaults, or set limits for every connection in this Provider.</p></div><label class="provider-admission-switch"><span><strong>Override global defaults</strong><small>${w.concurrencyOverride?'Custom policy enabled':'See Queue for current global defaults'}</small></span><input type="checkbox" data-wizard="provider-concurrency-override" ${w.concurrencyOverride?'checked':''}><i></i></label></div>${w.concurrencyOverride?`<div class="provider-admission-grid"><div class="field"><label>Max concurrent requests</label><input type="number" min="0" step="1" data-wizard="provider-max-concurrent" value="${esc(c.maxConcurrent)}"><span class="hint">Per connection. 0 keeps concurrency unlimited.</span></div><div class="field"><label>When the limit is reached</label><select data-wizard="provider-limit-behavior"><option value="wait" ${queue?'selected':''}>Block and wait (FIFO)</option><option value="fail" ${queue?'':'selected'}>Fail immediately (429)</option></select></div>${usesQueue?`<div class="field"><label>Maximum queued requests</label><input type="number" min="0" step="1" data-wizard="provider-max-queue" value="${esc(c.maxQueue)}"><span class="hint">Shared by concurrency and upstream-throttle waiters. 0 uses 256.</span></div><div class="field"><label>Queue wait timeout</label><div class="provider-duration-input"><input type="number" min="0" max="1800" step="1" data-wizard="provider-max-wait" value="${esc(c.maxWaitSeconds)}"><span>seconds</span></div><span class="hint">Shared wait deadline; 0 uses 120 seconds, maximum 1800.</span></div>`:''}<div class="field full"><label>After an upstream 429</label><select data-wizard="provider-throttle-behavior"><option value="wait" ${c.queueOnThrottle?'selected':''}>Hold requests through Retry-After, then drain serially</option><option value="fail" ${c.queueOnThrottle?'':'selected'}>Fail this connection immediately and let routing recover</option></select></div></div>`:''}</section>`}
function providerModelSyncInterval(value){return ['off','30m','1h'].includes(value)?value:'1h'}
function providerModelSyncState(value){
  const raw=value||{},allowed=['idle','running','succeeded','failed','unsupported','disabled'],status=allowed.includes(raw.status)?raw.status:'idle';
  return {...raw,status,discovered_models:Math.max(0,Number(raw.discovered_models||0)),added_models:Math.max(0,Number(raw.added_models||0)),created_logical_models:Math.max(0,Number(raw.created_logical_models||0)),revision:Number(raw.revision||0)};
}
function providerModelSyncTime(value,fallback='Not yet'){if(!value)return fallback;const date=new Date(value);return Number.isNaN(date.getTime())?fallback:date.toLocaleString()}
function providerUsesControlPlaneCatalog(w){return w?.type!=='cliproxy-codex'&&w?.modelSyncCatalogMode==='volcengine-plan'}
function providerModelSyncCatalogPayload(w){
  if(!providerUsesControlPlaneCatalog(w))return null;
  const catalog=w.modelSyncCatalog||{};
  return {type:'volcengine-plan',plan:catalog.plan==='coding'?'coding':'agent',credentialRef:String(catalog.credentialRef||'')};
}
function providerModelSyncCatalogCredentialPayload(w){
  if(!providerUsesControlPlaneCatalog(w))return null;
  const catalog=w.modelSyncCatalog||{},credential=w.modelSyncCatalogCredential||{};
  if(catalog.credentialRef&&!w.modelSyncCatalogReplace)return null;
  const sessionToken=String(credential.sessionToken||'').trim();
  return {access_key_id:String(credential.accessKeyId||'').trim(),secret_access_key:String(credential.secretAccessKey||'').trim(),...(sessionToken?{session_token:sessionToken}:{})};
}
function validateProviderModelSyncCatalog(w){
  if(!providerUsesControlPlaneCatalog(w))return '';
  const catalog=providerModelSyncCatalogPayload(w),credential=providerModelSyncCatalogCredentialPayload(w);
  if(!['agent','coding'].includes(catalog.plan))return 'Choose an Agent Plan or Coding Plan catalog.';
  if(catalog.credentialRef&&!credential)return '';
  if(!credential?.access_key_id)return 'Volcengine Access Key ID is required for the Plan catalog.';
  if(!credential.secret_access_key)return 'Volcengine Secret Access Key is required for the Plan catalog.';
  return '';
}
function providerModelSyncCatalogSettings(w){
  const configured=providerUsesControlPlaneCatalog(w),catalog=w.modelSyncCatalog||{type:'volcengine-plan',plan:'agent',credentialRef:''},credential=w.modelSyncCatalogCredential||{},hasRef=Boolean(catalog.credentialRef),editing=configured&&(!hasRef||w.modelSyncCatalogReplace);
  const credentialStatus=hasRef?`<span class="provider-catalog-credential-state configured"><strong>Configured</strong><small class="mono">${esc(catalog.credentialRef)}</small></span>`:'<span class="provider-catalog-credential-state"><strong>Credential required</strong><small>Stored securely when you save.</small></span>';
  const credentialFields=editing?`<div class="provider-catalog-credential-fields"><div class="field"><label for="provider-catalog-access-key">Access Key ID</label><input id="provider-catalog-access-key" type="password" autocomplete="new-password" data-wizard="provider-catalog-access-key" value="${esc(credential.accessKeyId||'')}" placeholder="Enter control-plane Access Key ID"></div><div class="field"><label for="provider-catalog-secret-key">Secret Access Key</label><input id="provider-catalog-secret-key" type="password" autocomplete="new-password" data-wizard="provider-catalog-secret-key" value="${esc(credential.secretAccessKey||'')}" placeholder="Enter control-plane Secret Access Key"></div><div class="field full"><label for="provider-catalog-session-token">Session token <span>Required for STS; leave blank for long-lived AK/SK</span></label><input id="provider-catalog-session-token" type="password" autocomplete="new-password" data-wizard="provider-catalog-session-token" value="${esc(credential.sessionToken||'')}" placeholder="Enter temporary session token"></div></div>`:'';
  return `<div class="provider-model-sync-catalog"><div class="provider-catalog-source-grid"><div class="field"><label for="provider-model-sync-catalog-source">Catalog source</label><select id="provider-model-sync-catalog-source" data-wizard="provider-model-sync-catalog-source"><option value="provider" ${configured?'':'selected'}>Channel model catalog</option><option value="volcengine-plan" ${configured?'selected':''}>Volcengine Plan control plane</option></select></div>${configured?`<div class="field"><label for="provider-model-sync-plan">Plan</label><select id="provider-model-sync-plan" data-wizard="provider-model-sync-plan"><option value="agent" ${catalog.plan==='coding'?'':'selected'}>Agent Plan</option><option value="coding" ${catalog.plan==='coding'?'selected':''}>Coding Plan</option></select></div>`:''}</div>${configured?`<div class="provider-catalog-credential-head"><div>${credentialStatus}</div>${hasRef?`<button type="button" class="btn small" data-action="provider-model-sync-catalog-${w.modelSyncCatalogReplace?'keep':'replace'}">${w.modelSyncCatalogReplace?'Keep configured credential':'Replace credential'}</button>`:''}</div>${credentialFields}<p class="provider-model-sync-note">Ferry uses this separate credential only to list models for the selected Plan. It is never replaced with the Provider API key and never used for inference or capability probes.</p>`:'<p class="provider-model-sync-note">Use the channel’s supported authenticated model catalog. The Provider API key remains scoped to that channel.</p>'}</div>`;
}
function providerModelSyncSettings(w){
  const interval=providerModelSyncInterval(w.modelSyncInterval),sync=providerModelSyncState(w.modelSync),existing=Boolean(w.providerId),dirty=existing&&providerModelSyncHasDraft(w),running=Boolean(w.modelSyncRunning)||sync.status==='running',unsupported=sync.status==='unsupported'&&!providerUsesControlPlaneCatalog(w),canRun=existing&&w.enabled&&!unsupported&&!running&&!dirty;
  const labels={idle:'Waiting',running:'Syncing',succeeded:'Succeeded',failed:'Failed',unsupported:'Unsupported',disabled:'Disabled'},details={idle:'Waiting for the first scheduled catalog read.',running:'Reading the Provider model catalog now.',succeeded:'The last catalog read completed.',failed:'The last catalog read could not finish.',unsupported:'No supported authenticated model catalog is available.',disabled:w.enabled?'Scheduled sync is off. Manual sync remains available.':'Enable this Provider before syncing.'},savedLabel=labels[sync.status];
  const savedNext=interval==='off'?'Schedule off':providerModelSyncTime(sync.next_run_at,'Pending schedule'),next=dirty?'Updates after save':savedNext;
  const status=existing?`<div class="provider-model-sync-status status-${esc(sync.status)}" aria-live="polite"><div><span class="provider-model-sync-badge" data-model-sync-badge data-saved-label="${esc(savedLabel)}">${dirty?'Pending save':esc(savedLabel)}</span><strong>${esc(details[sync.status])}</strong><small>${sync.revision?`Revision #${esc(sync.revision)} · `:''}${esc(sync.discovered_models)} discovered · ${esc(sync.added_models)} added · ${esc(sync.created_logical_models)} Logical Models created</small><small data-model-sync-save-note ${dirty?'':'hidden'}>Save Provider changes before syncing now.</small></div><button type="button" class="btn small" data-action="provider-model-sync-now" data-id="${esc(w.providerId)}" ${canRun?'':'disabled'} title="${dirty?'Save Provider changes before syncing now.':''}">${running?'Syncing…':'Sync now'}</button></div><div class="provider-model-sync-times"><span><small>Last successful sync</small><strong>${esc(providerModelSyncTime(sync.last_success_at))}</strong></span><span><small>Next scheduled sync</small><strong data-model-sync-next data-saved-value="${esc(savedNext)}">${esc(next)}</strong></span></div>`:`<div class="provider-model-sync-status status-idle"><div><span class="provider-model-sync-badge">Starts after creation</span><strong>First catalog read will follow this schedule.</strong><small>The Provider must be enabled and expose a supported catalog.</small></div></div>`;
  const warning=sync.status==='failed'?`<div class="notice red"><strong>Last model sync failed${sync.last_error_code?` · ${esc(sync.last_error_code)}`:''}</strong><span>${esc(sync.last_error||'Retry after checking the Provider catalog and credential.')}</span></div>`:unsupported?'<div class="notice orange"><strong>Scheduled catalog sync is unavailable</strong><span>This Provider has no supported authenticated model catalog. Ferry will not substitute capability probes or inference requests.</span></div>':'';
  return `<section class="provider-model-sync"><div class="provider-admission-head"><div><span class="protocol-kicker">MODEL CATALOG</span><h3>Automatic model sync</h3><p>Read this channel’s model catalog independently from capability verification.</p></div><div class="field provider-model-sync-select"><label for="provider-model-sync-interval">Catalog refresh</label><select id="provider-model-sync-interval" data-wizard="provider-model-sync-interval"><option value="off" ${interval==='off'?'selected':''}>Off</option><option value="30m" ${interval==='30m'?'selected':''}>Every 30 minutes</option><option value="1h" ${interval==='1h'?'selected':''}>Every hour</option></select></div></div>${w.type==='cliproxy-codex'?'':providerModelSyncCatalogSettings(w)}${status}${warning}<p class="provider-model-sync-note">New upstream models are added without removing configured models. Missing same-name Logical Models are created automatically with this Provider route; existing custom models and routes are preserved. Catalog sync does not run inference or capability probes.</p></section>`;
}
function providerScheduledMessageModels(w){const models=w.type==='cliproxy-codex'?[...(w.codexConnections||[]).flatMap(connection=>connection.modelNames||[]),...(w.models||[])]:w.protocols.flatMap(protocol=>protocol.protocol==='openai-images'?[]:(protocol.models||[]).filter(model=>providerProtocolModelSpec(protocol,model).capabilities.text));return [...new Set(models.map(model=>String(model).trim()).filter(model=>model&&model.toLowerCase()!=='gpt-image-2'))].sort((a,b)=>a.localeCompare(b))}
function providerScheduledMessagePayload(w){const message=w?.scheduledMessage||{};return {enabled:Boolean(message.enabled),upstream_model:String(message.upstreamModel||'').trim(),message:String(message.message||'')}}
function validateProviderScheduledMessage(w){const message=w?.scheduledMessage||{};if(new TextEncoder().encode(String(message.message||'')).length>16384)return 'Automatic message must be 16 KiB or smaller.';if(!message.enabled)return '';if(!String(message.message||'').trim())return 'Enter the automatic message for this Provider.';if(!String(message.upstreamModel||'').trim())return 'Select the upstream text model for the automatic message.';if(!providerScheduledMessageModels(w).includes(String(message.upstreamModel).trim()))return 'The automatic message model must be a text-capable model on this Provider.';return ''}
function providerScheduledMessageSettings(w){const message=w.scheduledMessage||={enabled:false,upstreamModel:'',message:''},models=providerScheduledMessageModels(w),selected=models.includes(message.upstreamModel);return `<section class="provider-scheduled-message"><div class="provider-admission-head"><div><span class="protocol-kicker">AUTOMATIC MESSAGE</span><h3>Every 5 hours</h3><p>Send this Provider a canonical user message through its selected text model. Each Provider is configured independently.</p></div><label class="provider-admission-switch"><span><strong>Enable automatic message</strong><small>${message.enabled?'Runs every 5 hours':'Disabled for this Provider'}</small></span><input type="checkbox" data-wizard="provider-scheduled-enabled" ${message.enabled?'checked':''}><i></i></label></div>${message.enabled?`<div class="provider-scheduled-message-fields"><div class="field"><label>Upstream text model</label><select data-wizard="provider-scheduled-model"><option value="">Select a text model…</option>${!selected&&message.upstreamModel?`<option value="${esc(message.upstreamModel)}" selected>${esc(message.upstreamModel)} (unavailable)</option>`:''}${models.map(model=>`<option value="${esc(model)}" ${model===message.upstreamModel?'selected':''}>${esc(model)}</option>`).join('')}</select><span class="hint">Image-only models cannot receive messages.</span></div><div class="field full"><label>Custom message</label><textarea data-wizard="provider-scheduled-message" maxlength="16384" placeholder="Enter the message sent every 5 hours">${esc(message.message)}</textarea><span class="hint">Maximum 16 KiB. Responses are used only for runtime health and quota accounting.</span></div></div>`:''}</section>`}
function providerEditorProtocol(w,id=w.activeProtocol){return w.protocols.find(item=>item.protocol===id)||w.protocols[0]}
function providerEditorConversionModels(w,protocol){const meta=providerProtocolMeta.find(item=>item.id===protocol.protocol);if(meta?.convertible===false)return [];const native=new Set(protocol.models||[]),models=new Map();for(const source of w.protocols){if(source.protocol===protocol.protocol||providerProtocolMeta.find(item=>item.id===source.protocol)?.convertible===false)continue;for(const model of source.models||[]){if(!models.has(model))models.set(model,{model,sources:[],fallback:native.has(model)});models.get(model).sources.push(source.protocol)}}return [...models.values()].sort((a,b)=>a.model.localeCompare(b.model))}
function providerProtocolStatus(w,protocol){const native=(protocol.models||[]).length,coverage=protocol.autoConvert?providerEditorConversionModels(w,protocol):[],converted=coverage.filter(item=>!item.fallback).length,fallback=coverage.filter(item=>item.fallback).length;if(native&&(converted||fallback))return {label:'Native + automatic conversion',native,converted,fallback};if(native)return {label:'Native',native,converted:0,fallback:0};if(converted)return {label:'Automatic conversion',native:0,converted,fallback:0};return {label:'Not configured',native:0,converted:0,fallback:0}}
function providerProbeDuration(ms){if(!Number.isFinite(ms)||ms<0)return '';if(ms<1000)return `${Math.round(ms)} ms`;return `${(ms/1000).toFixed(ms<10000?1:0)} s`}
function providerProtocolProbeState(w,protocol){const elapsed=protocol.status==='probing'&&protocol.probeStartedAt?Date.now()-protocol.probeStartedAt:protocol.probeElapsedMs,duration=providerProbeDuration(elapsed);if(protocol.status==='probing'||w.probing&&protocol.status==='idle')return {key:'probing',label:'Verifying…',duration};if(protocol.status==='verified')return {key:'native',label:'Verified',duration};if(protocol.status==='partial')return {key:'failed',label:'Partial',duration};if(protocol.status==='failed'||protocol.status==='error')return {key:'failed',label:'Failed',duration};if(protocol.status==='unconfigured')return {key:'idle',label:'Not verified',duration};return {key:'idle',label:'Not tested',duration:''}}
function providerProtocolEndpoint(w,protocol){const meta=providerProtocolMeta.find(item=>item.id===protocol.protocol);if(protocol.overrideUrl&&protocol.urlMode==='full')return protocol.fullUrl||'Enter the complete request URL';const base=String(protocol.overrideUrl?protocol.baseUrl:w.baseUrl||'').replace(/\/$/,'');if(!base||!meta)return 'Complete the Base URL to preview this endpoint';return meta.secondaryPath?`${base+meta.path} · ${base+meta.secondaryPath}`:base+meta.path}
function providerModelChips(models,action,readonly=false){return (models||[]).map(model=>`<span class="protocol-model-chip ${readonly?'readonly':''}"><span>${esc(model)}</span>${readonly?'':`<button type="button" data-action="${action}" data-model="${esc(model)}" aria-label="Remove ${esc(model)}">×</button>`}</span>`).join('')}
function nativeProviderFields(n,info){
  if(info?.id==='vertex')return `<div class="form-grid"><div class="field full"><label>Service account JSON</label><textarea data-native-field="service_account" autocomplete="off" spellcheck="false" aria-label="Service account JSON"></textarea><span class="hint">Sensitive credentials are cleared on submission.</span></div><div class="field"><label>Location</label><input data-native-field="location" value="${esc(n.fields?.location||'us-central1')}" autocomplete="off"></div></div>`;
  if(info?.id==='antigravity')return `<div class="form-grid"><div class="field"><label>OAuth client ID</label><input data-native-field="client_id" autocomplete="off"></div><div class="field"><label>OAuth client secret</label><input type="password" data-native-field="client_secret" autocomplete="new-password"></div><p class="hint">Use your authorized matching OAuth client. Credentials are not imported from the environment.</p></div>`;
  return '';
}
function nativeProviderPanel(w){
  const n=w.nativeOAuth;
  const mode=`<div class="provider-auth-methods"><button type="button" class="choice ${n?'':'active'}" data-action="provider-signin-api"><strong>API key configuration</strong></button><button type="button" class="choice ${n?'active':''}" data-action="provider-signin-native"><strong>Native provider sign-in</strong></button></div>`;
  if(!n)return mode;
  prepareNativeProvider(w);
  const info=nativeProviderInfo(w),view=n.view,status=({connected:'Signed in',pending:'Waiting for sign-in',key_pending:'Authorization received; finish account setup',relogin_required:'Sign in again',expired:'Sign-in expired',disconnected:'Not signed in'})[view?.status]||'Not signed in',disabled=n.busy||n.loading;
  return `<section class="provider-channel-preset">${mode}<p>Sign-in saves account credentials only. Save the Provider separately to apply configuration.</p>${demoMode?'<div class="notice">Native sign-in is unavailable in demo mode.</div>':`<div class="form-grid"><div class="field"><label>Native provider</label><select data-wizard="provider-signin-driver" ${n.loading?'disabled':''}><option value="">Select a provider</option>${n.drivers.map(d=>`<option value="${esc(d.id)}" ${d.id===n.driver?'selected':''}>${esc(d.name)}</option>`).join('')}</select></div><div class="field"><label>Local account label</label><input data-wizard="provider-signin-account" maxlength="96" value="${esc(n.account)}" autocomplete="off"><span class="hint">Letters, numbers, dots, underscores and hyphens.</span></div></div><p>${esc(status)}</p>${n.loading?'<p>Loading sign-in options…</p>':''}${nativeProviderFields(n,info)}${['antigravity','devin','vertex'].includes(info?.id)?'<p class="hint">Enter explicit model IDs for this account. Automatic catalog sync is off; verify configured models to establish capabilities.</p>':''}${info?.mode==='import'&&info.id!=='vertex'?'<div class="notice">This provider requires a managed credential import. Check status after importing the account.</div>':''}<div class="provider-auth-methods">${info&&(info.mode!=='import'||info.id==='vertex')?`<button type="button" class="btn" data-action="provider-signin-begin" ${disabled?'disabled':''}>${info.mode==='import'?'Import account':'Start sign-in'}</button>`:''}<button type="button" class="btn" data-action="provider-signin-status" ${!info||disabled?'disabled':''}>Refresh sign-in status</button><button type="button" class="btn" data-action="provider-signin-reload" ${disabled?'disabled':''}>Reload providers</button>${view?`<button type="button" class="btn" data-action="provider-signin-disconnect" ${disabled?'disabled':''}>Disconnect account</button>`:''}</div>${view?.status==='key_pending'?`<button type="button" class="btn" data-action="provider-signin-complete" ${disabled?'disabled':''}>Finish account setup</button>`:''}${view?.status==='pending'?`<div class="notice">${view.url?`<a class="btn" href="${esc(view.url)}" target="_blank" rel="noopener noreferrer">Open sign-in page</a>`:''}${view.user_code?`<p><span>Sign-in code</span> <code>${esc(view.user_code)}</code></p>`:''}</div>${info?.mode==='browser'?`<div class="field"><label>Browser callback</label><textarea data-wizard="provider-signin-callback" autocomplete="off" spellcheck="false" placeholder="Paste the full callback URL or code#state"></textarea><button type="button" class="btn" data-action="provider-signin-complete" ${disabled?'disabled':''}>Complete sign-in</button></div>`:['device','import'].includes(info?.mode)?`<button type="button" class="btn" data-action="provider-signin-complete" ${disabled?'disabled':''}>${info.mode==='import'?'Complete import':'Check sign-in'}</button>`:''}`:''}`}${n.error?`<div class="notice red">${esc(n.error)}</div>`:''}</section>`;
}
function providerEditorModal(w,modal){
  const native=Boolean(w.nativeOAuth),nativeInfo=nativeProviderInfo(w),nativeEditable=!native||w.activeProtocol===nativeInfo?.protocol;
  const active=providerEditorProtocol(w),activeMeta=providerProtocolMeta.find(item=>item.id===active.protocol),selected=new Set(active.models||[]),coverage=providerEditorConversionModels(w,active),convertedAccess=coverage.filter(item=>!item.fallback),nativeFallback=coverage.filter(item=>item.fallback),status=providerProtocolStatus(w,active);
  const available=(w.catalog||[]).filter(model=>!selected.has(model)).map(model=>`<button type="button" class="protocol-catalog-model" data-action="provider-native-toggle" data-model="${esc(model)}"><span>＋</span>${esc(model)}</button>`).join('');
  const nativeModels=providerModelChips(active.models,'provider-native-remove')||'<span class="protocol-empty">No native models detected. Type a model and press Enter to add it manually.</span>';
  const renderBridgeModels=(items,mode)=>items.map(item=>{const sources=item.sources.map(id=>providerProtocolMeta.find(meta=>meta.id===id)?.label||id);return `<article class="protocol-bridge-cluster ${mode}"><div class="protocol-bridge-model-head"><strong class="mono">${esc(item.model)}</strong><span>${mode==='fallback'?'Native fallback':'Converted access'}</span></div><div class="protocol-bridge-route"><strong>Client ${esc(activeMeta.label)}</strong><span>→</span><b>Ferry</b><span>→</span><strong>Native ${esc(sources.join(' / '))}</strong></div></article>`}).join('');
  const converted=activeMeta.convertible!==false&&active.autoConvert?`<section class="protocol-supply protocol-converted"><div class="protocol-supply-head"><div><span class="protocol-kicker">FERRY BRIDGES</span><h3>Automatic conversion</h3><p>Requests prefer a healthy native path for their client protocol. Other native protocols remain available as conversion fallback.</p></div><span class="protocol-count">${status.converted} converted${status.fallback?` · ${status.fallback} fallback`:''}</span></div><div class="protocol-bridge-sections">${convertedAccess.length?`<section><header><strong>Converted access</strong><small>No ${esc(activeMeta.label)} native path; conversion is the primary path.</small></header><div class="protocol-bridge-groups">${renderBridgeModels(convertedAccess,'converted-access')}</div></section>`:''}${nativeFallback.length?`<section><header><strong>Native fallback</strong><small>${esc(activeMeta.label)} stays first; these paths are tried only when its native path is unavailable.</small></header><div class="protocol-bridge-groups">${renderBridgeModels(nativeFallback,'fallback')}</div></section>`:''}${!coverage.length?'<div class="protocol-empty">Add native models in another protocol tab to create conversion coverage.</div>':''}</div></section>`:'';
  const overrideFields=active.overrideUrl||active.overrideKey?`<div class="protocol-overrides">${active.overrideUrl?`<div class="field"><label>Endpoint format</label><select data-wizard="provider-protocol-url-mode"><option value="base" ${active.urlMode==='full'?'':'selected'}>Base URL · append protocol path</option><option value="full" ${active.urlMode==='full'?'selected':''}>Full URL · use exactly</option></select><span class="hint">Choose whether Ferry appends the standard protocol path or uses one exact request URL.</span></div><div class="field"><label>${active.urlMode==='full'?'Full request URL':'Protocol Base URL'}</label><input data-wizard="provider-protocol-url" value="${esc(active.urlMode==='full'?active.fullUrl:active.baseUrl)}" placeholder="${esc(active.urlMode==='full'?providerProtocolEndpoint({...w,baseUrl:''},{...active,fullUrl:''}):w.baseUrl)}"><span class="hint">${active.urlMode==='full'?'Ferry sends requests to this exact URL without appending a path.':'Ferry appends the standard path for this protocol.'}</span></div>`:''}${active.overrideKey?`<div class="field"><label>Protocol Key</label><input type="password" autocomplete="new-password" data-wizard="provider-protocol-secret" value="${esc(active.secret)}" placeholder="${active.credentialRef?'Leave blank to keep current key':'Required for this override'}"></div>`:''}</div>`:'';
  const conversionControl=activeMeta.convertible===false?'<div class="protocol-native-only"><strong>Native image API</strong><small>Generation and edit requests stay on their matching Images endpoint; text protocol conversion is disabled.</small></div>':`<label class="protocol-conversion-switch"><span><strong>Protocol automatic conversion</strong><small>Allow this client protocol to use models native in other text protocol tabs.</small></span><input type="checkbox" data-wizard="provider-protocol-conversion" ${active.autoConvert?'checked':''}><i></i></label>`;
  return `<div class="modal-backdrop provider-editor-backdrop" data-action="close-overlay"><div class="modal provider-protocol-modal" data-modal-stop><div class="modal-head"><div><h2>${modal.type==='add-provider'?'Add Provider':'Edit Provider'}</h2><div class="cell-sub">One endpoint configuration with native protocol supply and explicit Ferry conversion coverage.</div></div><button class="btn icon ghost" data-action="close-overlay">×</button></div><div class="modal-body provider-protocol-body">${modal.type==='add-provider'?providerEntrySwitch('custom'):''}${nativeProviderPanel(w)}<section class="provider-defaults"><div class="field"><label>Name</label><input data-wizard="provider-editor-name" value="${esc(w.name)}" placeholder="e.g. OpenCode Go"></div><div class="field provider-default-url"><label>Base URL</label><input data-wizard="provider-editor-url" ${native?'readonly':''} value="${esc(w.baseUrl)}" placeholder="https://opencode.ai/zen/go/v1"></div>${native?'':`<div class="field"><label>API Key</label><input type="password" autocomplete="new-password" data-wizard="provider-editor-secret" value="${esc(w.secret)}" placeholder="${w.credentialRef?'Leave blank to keep current key':'Enter key'}"></div>`}<button type="button" class="btn provider-probe-btn" data-action="provider-protocol-detect" ${w.probing||native&&!providerEditorCanProbe(w)?'disabled':''}>${w.probing?`Verifying ${w.probeCompleted}/${w.probeTotal}`:'Refresh catalog & verify configured'}</button></section><div class="notice"><strong>Fresh verification evidence is reused</strong><span>Catalog discovery is read-only. Only uncached Provider / endpoint / model / protocol combinations send a minimal, potentially billable request; the whole catalog is never probed. Forced refresh remains available through the management API.</span></div>${w.probeError?`<div class="notice red"><strong>Verification could not finish</strong><span>${esc(w.probeError)} You can still override URL, key and models in each protocol.</span></div>`:''}<div class="provider-protocol-tabs" role="tablist">${w.protocols.map(protocol=>{const meta=providerProtocolMeta.find(item=>item.id===protocol.protocol),tabStatus=providerProtocolStatus(w,protocol),probeState=providerProtocolProbeState(w,protocol);return `<button type="button" role="tab" class="provider-protocol-tab status-${probeState.key} ${protocol.protocol===w.activeProtocol?'active':''}" data-action="provider-protocol-tab" data-protocol="${esc(protocol.protocol)}"><i class="protocol-tab-indicator" aria-hidden="true"></i><span>${esc(meta.label)}</span><small><span>${esc(probeState.label)} · ${esc(tabStatus.label)}</span><em data-probe-duration="${esc(protocol.protocol)}">${esc(probeState.duration)}</em></small><b>${tabStatus.native} configured${tabStatus.converted?` · ${tabStatus.converted} converted`:''}${tabStatus.fallback?` · ${tabStatus.fallback} fallback`:''}</b></button>`}).join('')}</div><section class="protocol-tab-panel"><header class="protocol-panel-head"><div><span class="protocol-kicker">${esc(activeMeta.label.toUpperCase())}</span><h3>${esc(status.label)}</h3><p class="mono">${esc(providerProtocolEndpoint(w,active))}</p></div>${conversionControl}</header>${native?'':`<div class="protocol-override-actions"><label><input type="checkbox" data-wizard="provider-protocol-override-url" ${active.overrideUrl?'checked':''}> Override endpoint</label><label><input type="checkbox" data-wizard="provider-protocol-override-key" ${active.overrideKey?'checked':''}> Override key</label></div>${overrideFields}`}${nativeEditable?`<section class="protocol-supply protocol-native"><div class="protocol-supply-head"><div><span class="protocol-kicker">UPSTREAM SUPPLY</span><h3>Configured native models</h3><p>Models explicitly assigned to this protocol endpoint. Catalog entries are suggestions until selected and verified.</p></div><span class="protocol-count">${(active.models||[]).length} configured</span></div><div class="protocol-model-box"><input aria-label="Upstream model name" data-wizard="provider-native-input" value="${esc(active.modelInput||'')}" placeholder="Enter a model name, then press Enter"><div class="protocol-model-chips">${nativeModels}</div>${w.catalog?.length?`<div class="protocol-catalog"><span>Discovered catalog · not capability evidence</span><div>${available||'<small>Every catalog model is already configured for this protocol.</small>'}</div></div>`:''}</div>${providerModelCapabilitySettings(active)}${active.error&&['error','failed','partial','unconfigured'].includes(active.status)?`<p class="protocol-probe-error">${esc(active.error)}</p>`:''}</section>`:'<div class="notice">Native supply uses the selected provider protocol. Conversion settings remain available here.</div>'}${converted}</section>${providerUnlistedSection(w)}${providerModelSyncSettings(w)}${providerAdmissionSettings(w)}${providerScheduledMessageSettings(w)}<label class="checkbox-field provider-enabled"><input type="checkbox" data-wizard="provider-edit-enabled" ${w.enabled?'checked':''}><span><strong>Enabled</strong><small>New requests may use this provider when its route is eligible.</small></span></label></div><div class="modal-foot"><button class="btn" data-action="close-overlay">Cancel</button><button class="btn primary" data-action="${modal.type==='add-provider'?'provider-create':'provider-save'}" data-id="${esc(modal.providerId||'')}">${modal.type==='add-provider'?'Create Provider':'Save Changes'}</button></div></div></div>`;
}
function addProviderModal(){const w=state.wizard.provider||newProviderEditor();state.wizard.provider=w;return w.type==='cliproxy-codex'?legacyAddProviderModal():providerEditorModal(w,{type:'add-provider'})}
function legacyAddProviderModal(){
  const w=state.wizard.provider||newCodexProviderEditor(); state.wizard.provider=w;
  const authMethod=w.authMethod||'OAuth',authFileName=w.authFileName||'';
  const selected=new Set(Array.isArray(w.models)?w.models:[]),filter=String(w.modelFilter||'').trim().toLowerCase(),visible=(w.modelOptions||[]).filter(model=>!filter||model.toLowerCase().includes(filter));
  const modelRows=(w.modelOptions||[]).map(model=>`<label class="provider-model-option" data-provider-model-row data-search="${esc(model.toLowerCase())}" ${filter&&!model.toLowerCase().includes(filter)?'hidden':''}><input type="checkbox" data-wizard="provider-model-option" value="${esc(model)}" ${selected.has(model)?'checked':''}><span>${esc(model)}</span></label>`).join('');
  const picker=`<div class="field full provider-model-picker"><div class="provider-model-picker-head"><div><label>Upstream Models</label><div class="hint">Available Codex models before sign-in; account-specific availability is verified after OAuth.</div></div><button class="btn small" data-action="provider-model-discover" ${w.modelsLoading?'disabled':''}>${w.modelsLoading?'Loading…':w.modelsLoaded?'Refresh':'Load models'}</button></div>${w.modelsLoading?'<div class="provider-model-empty">Loading the Codex model catalog…</div>':w.modelsError?`<div class="notice red"><strong>Model discovery failed</strong><span>${esc(w.modelsError)}</span></div>`:w.modelsLoaded?`<div class="provider-model-filter"><input class="input" data-wizard="provider-model-filter" value="${esc(w.modelFilter||'')}" placeholder="Filter models by keyword"><span data-provider-model-visible>${visible.length} shown</span></div><div class="provider-model-actions"><span><strong data-provider-model-selected>${selected.size}</strong> selected</span><div><button class="btn small" data-action="provider-model-select-filtered">Select shown</button><button class="btn small" data-action="provider-model-clear">Clear</button></div></div><div class="provider-model-options">${modelRows||'<div class="provider-model-empty">No models match this keyword.</div>'}</div>`:'<div class="provider-model-empty">Ferry will load the Codex catalog automatically.</div>'}</div>`;
  const authSetup=`<div class="field full"><label>Account authentication</label><div class="provider-auth-methods"><button type="button" class="choice ${authMethod==='OAuth'?'active':''}" data-action="provider-auth-method" data-id="OAuth"><strong>Sign in with Codex</strong><small>Use the browser OAuth flow after creation.</small></button><button type="button" class="choice ${authMethod==='Auth File'?'active':''}" data-action="provider-auth-method" data-id="Auth File"><strong>Import auth.json</strong><small>Use an existing Codex CLI session without retaining the uploaded file.</small></button></div></div>${authMethod==='Auth File'?`<div class="field full auth-json-file-field"><label>Codex auth.json</label><input type="file" accept=".json,application/json" data-wizard="provider-auth-file"><span class="hint">${authFileName?`Selected: ${esc(authFileName)}`:'Choose $CODEX_HOME/auth.json (maximum 128 KiB).'}</span></div>`:''}`;
  const config=`<div class="form-grid"><div class="field full"><label>Provider Name</label><input data-wizard="provider-name" value="${esc(w.name)}" placeholder="e.g. Codex Personal"></div><div class="field full"><label>Base URL</label><input data-wizard="provider-base-url" value="${esc(w.baseUrl)}"></div>${authSetup}<div class="field full"><label>Codex account label</label><input data-wizard="provider-account" value="${esc(w.account)}" placeholder="personal"></div>${picker}<div class="notice green field full"><strong>GPT Image 2 supported</strong><span>Supported paid Codex accounts can proxy gpt-image-2 image generation and editing after authentication.</span></div><div class="field full">${providerModelSyncSettings(w)}</div><div class="field full">${providerAdmissionSettings(w)}</div><div class="field full">${providerScheduledMessageSettings(w)}</div><div class="notice green field full"><strong>Credential isolation</strong><span>${authMethod==='Auth File'?'Ferry extracts only the required OAuth token fields into its protected local credential store; the raw file is not retained.':'The Provider is created disabled until Codex sign-in completes.'}</span></div></div>`;
  const review=`<div class="stack"><div class="summary-chip"><strong>${esc(w.name||'Codex Provider')}</strong><small>Provider</small></div><div class="summary-chip"><strong>${esc(w.account||'personal')}</strong><small>Codex OAuth account</small></div><div class="summary-chip"><strong>${authMethod==='Auth File'?esc(authFileName||'auth.json'):'Browser OAuth'}</strong><small>Authentication</small></div><div class="summary-chip"><strong>${esc((w.models||[]).join(', '))}</strong><small>Confirmed Upstream Models</small></div><div class="summary-chip"><strong>${esc(providerModelSyncInterval(w.modelSyncInterval)==='30m'?'Every 30 minutes':providerModelSyncInterval(w.modelSyncInterval)==='1h'?'Every hour':'Off')}</strong><small>Automatic model sync</small></div><div class="summary-chip"><strong>${w.concurrencyOverride?`${esc(w.concurrency.maxConcurrent||'Unlimited')} max · ${w.concurrency.queueWhenFull?'Wait':'Fail immediately'}`:'Global defaults'}</strong><small>Admission policy</small></div><div class="summary-chip"><strong>${w.scheduledMessage?.enabled?`${esc(w.scheduledMessage.upstreamModel)} · Every 5 hours`:'Disabled'}</strong><small>Automatic message</small></div><div class="notice"><strong>${authMethod==='Auth File'?'Ready to import':'OAuth is the next step'}</strong><span>${authMethod==='Auth File'?'The connection is enabled after the server validates and stores the imported credential.':'After creation, complete Codex sign-in before this Provider can receive traffic.'}</span></div></div>`;
  return `<div class="modal-backdrop provider-editor-backdrop" data-action="close-overlay"><div class="modal provider-codex-create-modal" data-modal-stop><div class="modal-head"><div><h2>Add Provider</h2><div class="cell-sub">Choose an API configuration or a dedicated Codex OAuth flow.</div></div><button class="btn icon ghost" data-action="close-overlay">×</button></div><div class="modal-body">${providerEntrySwitch('cliproxy-codex')}<div class="stepper provider-oauth-stepper"><div class="step ${w.step!==3?'active':''}"><span>1</span>Configuration</div><div class="step-line"></div><div class="step ${w.step===3?'active':''}"><span>2</span>Review</div></div>${w.step===3?review:config}</div><div class="modal-foot"><button class="btn" data-action="close-overlay">Cancel</button>${w.step===3?'<button class="btn" data-action="provider-prev">Back</button>':''}<button class="btn primary" data-action="provider-next">${w.step===3?(authMethod==='Auth File'?'Create & Import':'Create & Sign In'):'Review'}</button></div></div></div>`;
}

function addConnectionModal(providerId){
  const provider=providerDataSync(providerId).provider,codex=provider?.raw?.type==='cliproxy-codex';
  const w=state.wizard.connection||{step:1,type:codex?'OAuth':'API Key',account:'codex-new',models:'gpt-5.6-sol',protocol:'openai-responses',secret:'',credentialRef:'',authFile:null,authFileName:''}; state.wizard.connection=w;
  const credentialField=w.type==='API Key'?`<div class="field full"><label>API Key / Token</label><input type="password" autocomplete="new-password" data-wizard="connection-secret" value="${esc(w.secret)}"></div>`:w.type==='Import'?`<div class="field full"><label>Credential Reference</label><input data-wizard="connection-credential-ref" value="${esc(w.credentialRef)}" placeholder="store:existing-name"></div>`:w.type==='Auth File'?`<div class="field full auth-json-file-field"><label>Codex auth.json</label><input type="file" accept=".json,application/json" data-wizard="connection-auth-file"><span class="hint">${w.authFileName?`Selected: ${esc(w.authFileName)}`:'Choose $CODEX_HOME/auth.json (maximum 128 KiB).'}</span></div>`:'';
  const choices=`<div class="stack">${codex?`<button class="choice ${w.type==='OAuth'?'active':''}" data-action="connection-type" data-id="OAuth"><strong>Sign in with Codex</strong><small>Create the connection, then complete OAuth callback.</small></button><button class="choice ${w.type==='Auth File'?'active':''}" data-action="connection-type" data-id="Auth File"><strong>Import auth.json</strong><small>Import an existing Codex CLI session; the raw file is not retained.</small></button>`:''}<button class="choice ${w.type==='API Key'?'active':''}" data-action="connection-type" data-id="API Key"><strong>API Key / Token</strong><small>Store a new secret in SQLite without echoing it.</small></button><button class="choice ${w.type==='Import'?'active':''}" data-action="connection-type" data-id="Import"><strong>Existing Credential</strong><small>Reference an existing store:, env:, or oauth: credential.</small></button></div>`;
  return `<div class="modal-backdrop" data-action="close-overlay"><div class="modal small" data-modal-stop><div class="modal-head"><div><h2>Add Connection</h2><div class="cell-sub">${esc(provider?.name||providerId)}</div></div><button class="btn icon ghost" data-action="close-overlay">×</button></div><div class="modal-body"><div class="stepper"><div class="step ${w.step===1?'active':''}"><span>1</span>Connection Type</div><div class="step-line"></div><div class="step ${w.step===2?'active':''}"><span>2</span>Configure</div><div class="step-line"></div><div class="step ${w.step===3?'active':''}"><span>3</span>Review</div></div>${w.step===1?choices:w.step===2?`<div class="form-grid"><div class="field full"><label>Connection Identity</label><input data-wizard="connection-account" value="${esc(w.account)}"></div><div class="field full"><label>Upstream Models</label><input data-wizard="connection-models" value="${esc(w.models)}" placeholder="model-a, model-b"></div><div class="field full"><label>Protocol</label><select data-wizard="connection-protocol"><option value="openai-chat" ${w.protocol==='openai-chat'?'selected':''}>openai-chat</option><option value="openai-responses" ${w.protocol==='openai-responses'?'selected':''}>openai-responses</option><option value="anthropic" ${w.protocol==='anthropic'?'selected':''}>anthropic</option></select></div>${credentialField}<div class="notice green field full"><strong>Draft validation</strong><span>The server validates the configuration before applying it. Imported OAuth token fields go only to the protected local credential store.</span></div></div>`:`<div class="stack"><div class="summary-chip"><strong>${esc(w.type)}</strong><small>Authentication</small></div><div class="summary-chip"><strong>${esc(w.account)}</strong><small>Identity</small></div>${w.type==='Auth File'?`<div class="summary-chip"><strong>${esc(w.authFileName||'auth.json')}</strong><small>Credential file</small></div>`:''}<div class="summary-chip"><strong>${esc(w.models)}</strong><small>Upstream models</small></div><div class="notice"><strong>Validated apply</strong><span>The connection is enabled after its configuration and credential are accepted.</span></div></div>`}</div><div class="modal-foot"><button class="btn" data-action="close-overlay">Cancel</button>${w.step>1?`<button class="btn" data-action="connection-prev">Back</button>`:''}<button class="btn primary" data-action="connection-next" data-provider="${esc(providerId)}">${w.step===3?(w.type==='Auth File'?'Import & Add':'Add Connection'):'Next'}</button></div></div></div>`;
}

function oauthCompleteModal(modal){return `<div class="modal-backdrop"><div class="modal small" data-modal-stop><div class="modal-head"><div><h2>Complete Codex sign-in</h2><div class="cell-sub">The connection exists but remains unauthenticated until callback completion.</div></div></div><div class="modal-body"><a class="btn primary" href="${esc(modal.authorizeUrl)}" target="_blank" rel="noopener noreferrer">Open authorization page ↗</a><div class="field" style="margin-top:16px"><label>Callback URL</label><input data-wizard="oauth-callback" value="${esc(state.wizard.oauthCallback||'')}" placeholder="Paste the final browser URL here"></div><div class="notice orange" style="margin-top:12px"><strong>Do not close this step</strong><span>Paste the complete callback URL after authorizing.</span></div></div><div class="modal-foot"><button class="btn" data-action="close-overlay">Finish later</button><button class="btn primary" data-action="oauth-complete" data-provider="${esc(modal.providerId)}" data-id="${esc(modal.connectionId)}">Complete sign-in</button></div></div></div>`}
function oauthDeviceModal(modal){
  const feedback=modal.error?`<div class="notice red"><strong>Device sign-in failed</strong><span>${esc(modal.error)}</span></div>`:`<div class="notice"><strong>Waiting for authorization</strong><span>This window closes automatically once ${esc(modal.userCode||'the code')} is approved.</span></div>`;
  return `<div class="modal-backdrop"><div class="modal small" data-modal-stop><div class="modal-head"><div><h2>Complete Codex device sign-in</h2><div class="cell-sub">Authorize from any browser; Ferry finishes the login without a callback URL.</div></div></div><div class="modal-body"><a class="btn primary" href="${esc(modal.verificationUrl)}" target="_blank" rel="noopener noreferrer">Open verification page ↗</a><div class="field" style="margin-top:16px"><label>Device code</label><pre class="secret-reveal mono">${esc(modal.userCode)}</pre></div>${feedback}</div><div class="modal-foot"><button class="btn" data-action="oauth-device-cancel" data-provider="${esc(modal.providerId)}" data-connection="${esc(modal.connectionId)}">Cancel sign-in</button></div></div></div>`;
}

function createKeyModal(){const w=state.wizard.key||{name:'',description:'',models:'',protocols:'',expiresAt:'',rateLimitRPM:'',monthlyBudgetUSD:'',exactOnly:false,submitting:false};state.wizard.key=w;return `<div class="modal-backdrop" data-action="close-overlay"><div class="modal small" data-modal-stop><div class="modal-head"><div><h2>Create API Key</h2><div class="cell-sub">The full key remains available to authenticated administrators.</div></div><button class="btn icon ghost" data-action="close-overlay" ${w.submitting?'disabled':''}>×</button></div><div class="modal-body"><div class="form-grid"><div class="field full"><label>Name</label><input data-wizard="key-name" value="${esc(w.name)}" placeholder="e.g. staging-agent" ${w.submitting?'disabled':''}></div><div class="field full"><label>Description</label><input data-wizard="key-description" value="${esc(w.description)}" placeholder="Who or what uses this key" ${w.submitting?'disabled':''}></div><div class="field full"><label>Allowed models (comma separated, blank = all)</label><input data-wizard="key-models" value="${esc(w.models)}" ${w.submitting?'disabled':''}></div><div class="field full"><label>Allowed protocols (comma separated, blank = all)</label><input data-wizard="key-protocols" value="${esc(w.protocols)}" placeholder="openai-chat, openai-responses" ${w.submitting?'disabled':''}></div><div class="field"><label>Expires at</label><input type="datetime-local" data-wizard="key-expires" value="${esc(w.expiresAt)}" ${w.submitting?'disabled':''}></div><div class="field"><label>Rate limit (RPM)</label><input type="number" min="0" data-wizard="key-rate" value="${esc(w.rateLimitRPM)}" ${w.submitting?'disabled':''}></div><div class="field full"><label>Monthly budget (USD)</label><input type="number" min="0" step="0.01" data-wizard="key-budget" value="${esc(w.monthlyBudgetUSD)}" ${w.submitting?'disabled':''}></div><label class="checkbox-field field full"><input type="checkbox" data-wizard="key-exact-only" ${w.exactOnly?'checked':''} ${w.submitting?'disabled':''}><span><strong>Exact compatibility only</strong><small>Reject safe mappings and cross-protocol conversion before any upstream attempt.</small></span></label><div class="notice field full"><strong>Least privilege</strong><span>Model, protocol, compatibility, expiry, rate, and budget policies are enforced by the data-plane Scheduler.</span></div></div></div><div class="modal-foot"><button class="btn" data-action="close-overlay" ${w.submitting?'disabled':''}>Cancel</button><button class="btn primary key-create-button" data-action="key-create-submit" ${w.submitting?'disabled':''}>${w.submitting?'<span class="button-spinner"></span> Creating…':'Create Key'}</button></div></div></div>`}
function keyRevealModal(modal){return `<div class="modal-backdrop"><div class="modal small" data-modal-stop><div class="modal-head"><div><h2>${modal.existing?'API Key':'API Key created'}</h2><div class="cell-sub">Reveal and copy remain available from the API Keys page.</div></div></div><div class="modal-body"><div class="notice"><strong>Administrator-visible secret</strong><span>Keep this value out of logs, screenshots and source control.</span></div><div class="summary-chip key-reveal-value" style="margin-top:12px"><strong class="mono">${esc(modal.key)}</strong><small>${esc(modal.name)}</small></div></div><div class="modal-foot"><button class="btn" data-action="copy-revealed-key">Copy</button><button class="btn primary" data-action="close-overlay">Done</button></div></div></div>`}
function confirmRevokeModal(keyId){const key=state.apiKeys.find(k=>k.id===keyId);return `<div class="modal-backdrop" data-action="close-overlay"><div class="modal small" data-modal-stop><div class="modal-head"><h2>Revoke API Key?</h2></div><div class="modal-body"><div class="notice red"><strong>${esc(key?.name||keyId)}</strong><span>Requests using this key will fail immediately. This action is intentionally separate from editing scope.</span></div></div><div class="modal-foot"><button class="btn" data-action="close-overlay">Cancel</button><button class="btn danger" data-action="revoke-confirm" data-id="${esc(keyId)}">Revoke Now</button></div></div></div>`}
function addModelModal(){return modelFormModal({mode:'create'})}

function modelFormModal(modal){const w=state.wizard.model||{id:'',name:'',description:'',enabled:false,exactOnly:false,firstOutputTimeoutSeconds:0},creating=modal.mode==='create';state.wizard.model=w;return `<div class="modal-backdrop" data-action="close-overlay"><div class="modal small" data-modal-stop><div class="modal-head"><div><h2>${creating?'Add Logical Model':'Edit Logical Model'}</h2><div class="cell-sub">Changes are validated and applied as an immutable revision.</div></div><button class="btn icon ghost" data-action="close-overlay">×</button></div><div class="modal-body form-grid"><div class="field full"><label>Model ID</label><input data-wizard="model-id" value="${esc(w.id)}" ${creating?'':'disabled'}></div><div class="field full"><label>Display name</label><input data-wizard="model-name" value="${esc(w.name)}"></div><div class="field full"><label>Description</label><textarea data-wizard="model-description">${esc(w.description)}</textarea></div><div class="field full"><label for="model-first-output-timeout">${nt('First output timeout (seconds)','首输出等待上限（秒）')}</label><input id="model-first-output-timeout" type="number" min="0" max="7200" step="1" data-wizard="model-first-output-timeout" value="${esc(w.firstOutputTimeoutSeconds??0)}" aria-describedby="model-first-output-timeout-hint"><span id="model-first-output-timeout-hint" class="hint">${nt('0 disables this limit for this model; 1–7200 seconds starts after each attempt gets a concurrency slot. The limit ends at the first text, reasoning, or tool output; output already in progress may continue.','0 关闭此模型的限制；1–7200 秒从每次尝试取得并发名额后开始计算。首个文本、推理或工具输出后停止计时，已开始输出的长流可正常继续。')}</span></div><label class="checkbox-field field full ${creating?'model-create-disabled':''}"><input type="checkbox" data-wizard="model-enabled" ${creating?'disabled':w.enabled?'checked':''}><span><strong>${creating?'Created disabled':'Enabled'}</strong><small>${creating?'Save the model, configure at least one provider route, then enable it.':'Requires at least one valid provider route.'}</small></span></label><label class="checkbox-field field full"><input type="checkbox" data-wizard="model-exact-only" ${w.exactOnly?'checked':''}><span><strong>Exact compatibility only</strong><small>Reject safe mappings and cross-protocol conversion before any upstream attempt.</small></span></label>${creating?'<div class="notice field full"><strong>Safe creation</strong><span>The model will be saved now without receiving traffic. Add routing from its workspace before enabling it.</span></div>':''}</div><div class="modal-foot"><button class="btn" data-action="close-overlay">Cancel</button>${creating?'':`<button class="btn danger" data-action="delete-model" data-id="${esc(w.id)}">Delete</button>`}<button class="btn primary" data-action="model-save" data-mode="${modal.mode}">Save</button></div></div></div>`}

const overrideProtocolOptions=[['openai-chat','OpenAI Chat'],['openai-responses','OpenAI Responses'],['anthropic','Anthropic'],['openai-images','OpenAI Images']];
const overrideWeekdayOptions=[['mon','Mon'],['tue','Tue'],['wed','Wed'],['thu','Thu'],['fri','Fri'],['sat','Sat'],['sun','Sun']];
const overrideCapabilityOptions=[['text','Text'],['images','Images'],['stream','Streaming'],['tools','Tools'],['parallel_tools','Parallel tools'],['reasoning','Reasoning'],['structured_output','Structured output'],['vision','Vision'],['priority','Fast (priority)']];
const overrideTimezoneOptions=[['','Use Ferry runtime timezone (recommended)'],['Asia/Shanghai','China · Asia/Shanghai (UTC+08:00)'],['Asia/Tokyo','Japan · Asia/Tokyo (UTC+09:00)'],['UTC','UTC'],['America/Los_Angeles','US Pacific · America/Los_Angeles'],['America/New_York','US Eastern · America/New_York'],['Europe/London','United Kingdom · Europe/London'],['Europe/Berlin','Central Europe · Europe/Berlin'],['Australia/Sydney','Australia · Australia/Sydney']];
const overrideRecoveryOptions=[['connect_failure','Connection failed'],['rate_limit','Rate limited'],['provider_5xx','Provider server error'],['quota_exhausted','Quota exhausted'],['ttft_timeout','First-token timeout'],['stream_broken','Stream interrupted'],['bad_response','Invalid provider response']];
function overrideRouteLabel(route){return `${route.provider||route.provider_id} / ${route.model||route.upstream_model}`}
function overrideFormModal(modal){
  const w=state.wizard.override;if(!w)return'';const required=w.required||{},defaults=w.defaultRoutes||[],choices=w.routeChoices||defaults,custom=w.customRoutes||[];
  const callerConfigured=Boolean(w.callers.trim()),protocolConfigured=Boolean(w.protocols?.length),scheduleConfigured=Boolean(w.weekdays?.length||w.start||w.end),requirementsConfigured=Boolean(overrideCapabilityOptions.some(([value])=>required[value])||Number(required.min_context||0)||Number(required.min_output||0));
  const groupState=(name,configured)=>`<span class="condition-group-state ${configured?'configured':''}" data-condition-state="${name}">${configured?'Configured · must match':'Not selected · group passes'}</span>`;
  const timezoneOptions=overrideTimezoneOptions.some(([value])=>value===w.timezone)?overrideTimezoneOptions:[...overrideTimezoneOptions,[w.timezone,`Current setting · ${w.timezone}`]];
  const adjust=defaults.map((route,index)=>`<div class="override-route-choice"><span><strong>${esc(route.provider||route.id)}</strong><small>${esc(route.model)}</small></span><select class="select" data-action="override-adjust" data-index="${index}"><option value="normal" ${w.adjustments[index]==='normal'?'selected':''}>Keep order</option><option value="prefer" ${w.adjustments[index]==='prefer'?'selected':''}>Prefer first</option><option value="avoid" ${w.adjustments[index]==='avoid'?'selected':''}>Avoid</option></select></div>`).join('');
  const customRows=custom.map((route,index)=>`<div class="override-route-choice"><span class="route-priority">${index+1}</span><span><strong>${esc(route.provider||route.id)}</strong><small>${esc(route.model)}</small></span><div class="row-actions"><button class="btn icon small" data-action="override-route-up" data-index="${index}" ${index===0?'disabled':''}>${icon('up')}</button><button class="btn icon small" data-action="override-route-down" data-index="${index}" ${index===custom.length-1?'disabled':''}>${icon('down')}</button><button class="btn icon small danger" data-action="override-route-remove" data-index="${index}">${icon('trash')}</button></div>${index<custom.length-1?`<details class="override-route-recovery"><summary>Advance to route ${index+2} on…</summary><div class="override-check-grid">${overrideRecoveryOptions.map(([value,label])=>`<label><input type="checkbox" data-action="override-route-recover" data-index="${index}" data-failure="${value}" ${(route.recoverOn||[]).includes(value)?'checked':''}> ${label}</label>`).join('')}</div></details>`:'<small class="override-route-final">Final route · no recovery progression</small>'}</div>`).join('');
  const customKeys=new Set(custom.map(route=>`${route.id}\u0000${route.model}`)),available=choices.map((route,index)=>({route,index})).filter(({route})=>!customKeys.has(`${route.id}\u0000${route.model}`));
  const actionEditor=w.mode==='custom_route'?`<div class="override-route-list">${customRows||'<div class="empty compact-empty">Choose at least one route.</div>'}</div><div class="routing-add-row"><select class="select" data-action="override-route-select"><option value="">Select a Provider / upstream model…</option>${available.map(({route,index})=>`<option value="${index}" ${String(w.customRouteChoice)===String(index)?'selected':''}>${esc(overrideRouteLabel(route))}</option>`).join('')}</select><button class="btn" data-action="override-route-add" ${w.customRouteChoice===''||w.customRouteChoice===undefined?'disabled':''}>${icon('plus')} Add route</button></div><p class="hint">A custom route may use any configured Provider supply and replaces the default only when this rule matches. Each non-final step has its own explicit operational recovery conditions. Compatibility failures detected before response commit advance automatically.</p>`:`<div class="override-route-list">${adjust||'<div class="empty compact-empty">Configure the model default route first.</div>'}</div><p class="hint">Prefer moves selected steps ahead while retaining their relative order. Avoid removes selected steps; at least one default step must remain.</p>`;
  const conditionEditor=`<section><div class="routing-section-head"><div><h3>When this request matches</h3><p>Every condition group below must pass. A group with no selection adds no restriction and passes automatically.</p></div></div><div class="condition-logic-notice"><strong>How groups combine</strong><span><b>Between groups:</b> AND — Caller, Protocol, Schedule, and Request requirements must all pass.</span><span><b>Inside a group:</b> Caller, protocol, and weekday selections use ANY; required capabilities use ALL.</span></div><div class="condition-groups">
    <section class="condition-group"><div class="condition-group-head"><div><h4>Caller</h4><p>Any listed caller or API Key ID may match.</p></div>${groupState('caller',callerConfigured)}</div><div class="field"><label>Caller / API Key IDs (comma separated)</label><input data-wizard="override-callers" value="${esc(w.callers)}" placeholder="Leave blank for any caller"></div></section>
    <section class="condition-group"><div class="condition-group-head"><div><h4>Client protocol</h4><p>A request may use any one of the selected protocols.</p></div>${groupState('protocol',protocolConfigured)}</div><div class="override-check-grid">${overrideProtocolOptions.map(([value,label])=>`<label><input type="checkbox" data-action="override-protocol" value="${value}" ${(w.protocols||[]).includes(value)?'checked':''}> ${label}</label>`).join('')}</div></section>
    <section class="condition-group"><div class="condition-group-head"><div><h4>Schedule</h4><p>Selected weekdays and the time window are combined with AND. Leave either one blank to allow any day or any time.</p></div>${groupState('schedule',scheduleConfigured)}</div><div class="form-grid"><div class="field full"><label>Weekdays (none = any day)</label><div class="override-check-grid weekdays">${overrideWeekdayOptions.map(([value,label])=>`<label><input type="checkbox" data-action="override-weekday" value="${value}" ${(w.weekdays||[]).includes(value)?'checked':''}> ${label}</label>`).join('')}</div></div><div class="field"><label>Timezone context</label><select data-wizard="override-timezone">${timezoneOptions.map(([value,label])=>`<option value="${esc(value)}" ${w.timezone===value?'selected':''}>${esc(label)}</option>`).join('')}</select><small>Keep the recommended runtime timezone unless this schedule follows a different region.</small></div><div class="field"><label>Time window (blank = any time)</label><div class="override-time-window"><input type="time" data-wizard="override-start" value="${esc(w.start)}"><span>to</span><input type="time" data-wizard="override-end" value="${esc(w.end)}"></div></div></div></section>
    <section class="condition-group"><div class="condition-group-head"><div><h4>Request requirements</h4><p>The request must satisfy every selected capability and every non-zero token minimum.</p></div>${groupState('requirements',requirementsConfigured)}</div><div class="form-grid"><div class="field full"><label>Required capabilities (none = no capability restriction)</label><div class="override-check-grid">${overrideCapabilityOptions.map(([value,label])=>`<label><input type="checkbox" data-action="override-capability" value="${value}" ${required[value]?'checked':''}> ${label}</label>`).join('')}</div></div><div class="field"><label>Minimum context tokens (0 = no minimum)</label><input type="number" min="0" step="1" data-wizard="override-min-context" value="${esc(required.min_context||0)}"></div><div class="field"><label>Minimum output tokens (0 = no minimum)</label><input type="number" min="0" step="1" data-wizard="override-min-output" value="${esc(required.min_output||0)}"></div></div></section>
  </div></section>`;
  return `<div class="modal-backdrop" data-action="close-overlay"><div class="modal override-editor-modal" data-modal-stop><div class="modal-head"><div><h2>${modal.overrideId?'Edit':'Add'} Conditional Rule</h2><div class="cell-sub">Rules are checked from top to bottom; the first enabled rule whose conditions all match is applied.</div></div><button class="btn icon ghost" data-action="close-overlay">×</button></div><div class="modal-body override-editor-body"><section class="form-grid"><div class="field"><label>ID</label><input data-wizard="override-id" value="${esc(w.id)}" ${modal.overrideId?'disabled':''}></div><div class="field"><label>Name</label><input data-wizard="override-name" value="${esc(w.name)}"></div><label class="checkbox-field field full"><input type="checkbox" data-wizard="override-enabled" ${w.enabled?'checked':''}><span><strong>Enabled</strong><small>Disabled rules keep their position but never match.</small></span></label></section><div class="divider"></div>${conditionEditor}<div class="divider"></div><section><div class="routing-section-head"><div><h3>Then adjust routing</h3><p>Change the reviewed default route or replace it with an ordered custom route.</p></div><select class="select" data-action="override-mode"><option value="adjust_default" ${w.mode==='adjust_default'?'selected':''}>Adjust default route</option><option value="custom_route" ${w.mode==='custom_route'?'selected':''}>Use custom route</option></select></div>${actionEditor}</section></div><div class="modal-foot"><button class="btn" data-action="close-overlay">Cancel</button><button class="btn primary" data-action="override-save" data-model="${esc(modal.modelId)}" data-id="${esc(modal.overrideId||'')}">Save Conditional Rule</button></div></div></div>`;
}

function simulationRoute(route){return (route?.steps||[]).map((step,index)=>`<div class="simulation-route-step"><span class="route-priority">${index+1}</span><span><strong>${esc(step.provider_id)}</strong><small>${esc(step.upstream_model)}</small></span></div>`).join('')||'<span class="cell-sub">No route steps</span>'}
function simulationModal(modal){
  const w=state.wizard.simulation||{},r=modal.result;
  if(modal.loading)return `<div class="modal-backdrop"><div class="modal simulation-modal" data-modal-stop><div class="modal-head"><div><h2>Route Simulation</h2><div class="cell-sub">${esc(modal.modelId)} · read-only planner preview</div></div></div><div class="modal-body"><div class="empty"><span class="button-spinner"></span><strong>Evaluating the same planner used for live requests…</strong><span>Matching conditional rules and collecting candidate evidence.</span></div></div><div class="modal-foot"><button class="btn primary" disabled>Running Simulation…</button></div></div></div>`;
  if(!r)return `<div class="modal-backdrop" data-action="close-overlay"><div class="modal simulation-modal" data-modal-stop><div class="modal-head"><div><h2>Route Simulation</h2><div class="cell-sub">${esc(modal.modelId)} · evaluate request matching and eligibility without sending upstream traffic</div></div><button class="btn icon ghost" data-action="close-overlay">×</button></div><div class="modal-body form-grid"><div class="field"><label>Caller / API Key ID</label><input data-wizard="simulation-caller" value="${esc(w.caller)}" placeholder="production-key"></div><div class="field"><label>Client protocol</label><select data-wizard="simulation-protocol">${overrideProtocolOptions.map(([value,label])=>`<option value="${value}" ${w.protocol===value?'selected':''}>${label}</option>`).join('')}</select></div><div class="field"><label>Simulated date and time</label><input type="datetime-local" data-wizard="simulation-at" value="${esc(w.at)}"></div><label class="checkbox-field field"><input type="checkbox" data-wizard="simulation-stream" ${w.stream?'checked':''}><span><strong>Streaming request</strong><small>Adds the stream capability requirement.</small></span></label><div class="field full"><label>Required request capabilities</label><div class="override-check-grid">${overrideCapabilityOptions.map(([value,label])=>`<label><input type="checkbox" data-action="simulation-capability" value="${value}" ${w.required?.[value]?'checked':''}> ${label}</label>`).join('')}</div></div><div class="field"><label>Minimum context tokens</label><input type="number" min="0" step="1" data-wizard="simulation-min-context" value="${esc(w.required?.min_context||0)}"></div><div class="field"><label>Minimum output tokens</label><input type="number" min="0" step="1" data-wizard="simulation-min-output" value="${esc(w.required?.min_output||0)}"></div><div class="notice field full"><strong>Exact planner preview</strong><span>The selected time is sent as RFC3339 and evaluated in each conditional rule's configured timezone. Runtime health, quota and capability evidence remain read-only.</span></div></div><div class="modal-foot"><button class="btn" data-action="close-overlay">Cancel</button><button class="btn primary" data-action="simulation-run" data-model="${esc(modal.modelId)}">Run Simulation</button></div></div></div>`;
  const failure=r.planning_failure,expected=r.expected_selection||{},matched=r.matched_override||'Default route';
  return `<div class="modal-backdrop" data-action="close-overlay"><div class="modal simulation-modal" data-modal-stop><div class="modal-head"><div><h2>Route Simulation</h2><div class="cell-sub">${esc(modal.modelId)} · ${esc(new Date(r.simulated_at||Date.now()).toLocaleString())}</div></div><button class="btn icon ghost" data-action="close-overlay">×</button></div><div class="modal-body">${r.previewing_disabled_model?'<div class="notice"><strong>Disabled model preview</strong><span>This route was simulated without enabling client traffic.</span></div>':''}${failure?`<div class="notice red section"><strong>No eligible route</strong><span>${esc(failure.message||failure.type||'The planner could not select a Provider.')}</span></div>`:''}<div class="grid-equal section"><div class="summary-chip"><strong>${esc(matched)}</strong><small>Matched Conditional Rule</small></div><div class="summary-chip"><strong>${esc(expected.provider_id||'No eligible provider')}</strong><small>${esc(expected.connection_id||'—')} · ${esc(expected.upstream_model||'—')}</small></div></div><div class="simulation-route-grid"><section><h3>Default route</h3>${simulationRoute(r.default_route)}</section><section><h3>Effective route</h3>${simulationRoute(r.effective_route)}</section></div><section class="section"><div class="routing-section-head"><div><h3>Connection candidates</h3><p>Rank and exclusion evidence from the same planner used for live requests.</p></div></div><div class="stack">${(r.connection_candidates||[]).map(c=>`<div class="split-event"><div><strong>#${esc(c.rank||'—')} · ${esc(c.provider_id||'candidate')} / ${esc(c.connection_id||'—')}</strong><div class="cell-sub">${esc(c.upstream_model||'—')} · ${esc(c.exclusion_reason||'Eligible')}</div></div>${badge(c.eligible?'Eligible':'Excluded')}</div>`).join('')||'<div class="empty compact-empty"><strong>No candidates</strong>The effective route produced no connection candidates.</div>'}</div></section></div><div class="modal-foot"><button class="btn" data-action="simulation-reset" data-model="${esc(modal.modelId)}">Change Inputs</button><button class="btn primary" data-action="close-overlay">Done</button></div></div></div>`;
}

function legacyProviderFormModal(modal){
  const w=state.wizard.providerEdit,hasCredential=Boolean(w.connectionId),configured=providerEditModelNames(w),selected=new Set(configured),filter=String(w.modelFilter||'').trim().toLowerCase(),visible=(w.modelOptions||[]).filter(model=>!filter||model.toLowerCase().includes(filter));
  const configuredModels=configured.map(model=>`<span class="provider-edit-model-chip"><span>${esc(model)}</span><button type="button" data-action="provider-edit-model-remove" data-model="${esc(model)}" aria-label="Remove ${esc(model)}">×</button></span>`).join('');
  const catalogModels=(w.modelOptions||[]).map(model=>`<button type="button" class="provider-edit-model-option ${selected.has(model)?'selected':''}" data-action="provider-edit-model-toggle" data-model="${esc(model)}" data-provider-edit-model-row data-search="${esc(model.toLowerCase())}" ${filter&&!model.toLowerCase().includes(filter)?'hidden':''}><span class="provider-edit-model-check">${selected.has(model)?'✓':'＋'}</span><span>${esc(model)}</span></button>`).join('');
  const catalog=w.modelsLoading?'<div class="provider-model-empty">Loading models from the Provider…</div>':w.modelsError?`<div class="notice red"><strong>Model catalog unavailable</strong><span>${esc(w.modelsError)}</span></div>`:w.modelsLoaded?`<div class="provider-edit-model-filter"><input class="input" data-wizard="provider-edit-model-filter" value="${esc(w.modelFilter||'')}" placeholder="Filter models"><span data-provider-edit-model-visible>${visible.length} shown</span><button type="button" class="btn small" data-action="provider-edit-model-select-all" ${visible.length?'':'disabled'}>Select all</button><button type="button" class="btn small" data-action="provider-edit-model-deselect-all" ${configured.length?'':'disabled'}>Deselect all</button></div><div class="provider-edit-model-options">${catalogModels||'<div class="provider-model-empty">No models match this keyword.</div>'}</div>`:'<div class="provider-model-empty">The upstream catalog loads automatically when this editor opens.</div>';
  const modelEditor=`<div class="field full provider-edit-models"><label>Upstream models</label><div class="provider-edit-model-stack"><section class="provider-edit-model-panel"><div class="provider-edit-model-panel-head"><div><strong>Configured models</strong><span>Type a model name or select one from the catalog below.</span></div><span>${configured.length} configured</span></div><div class="provider-edit-model-input"><input aria-label="Upstream model name" data-wizard="provider-edit-model-input" value="${esc(w.modelInput||'')}" placeholder="Enter a model name, then press Enter"><button type="button" class="btn" data-action="provider-edit-model-add">Add</button></div><div class="provider-edit-model-chips">${configuredModels||'<span class="provider-edit-model-empty">No models configured.</span>'}</div></section><section class="provider-edit-model-panel"><div class="provider-edit-model-panel-head"><div><strong>Available from Provider</strong><span>Fetched directly from this Provider using its current credential.</span></div><button type="button" class="btn small" data-action="provider-edit-model-discover" ${w.modelsLoading?'disabled':''}>${w.modelsLoading?'Loading…':'Refresh'}</button></div>${catalog}</section></div><span class="hint">Selected catalog models are highlighted in green and added to the configured list. Existing capabilities are preserved for unchanged models.</span></div>`;
  return `<div class="modal-backdrop" data-action="close-overlay"><div class="modal provider-edit-modal" data-modal-stop><div class="modal-head"><div><h2>Edit Provider</h2><div class="cell-sub">Edit the endpoint, credential identity, and upstream model catalog, then save.</div></div><button class="btn icon ghost" data-action="close-overlay">×</button></div><div class="modal-body form-grid"><div class="field"><label>Name</label><input data-wizard="provider-edit-name" value="${esc(w.name)}"></div><div class="field provider-type-field"><label>Provider type</label><div class="provider-type-readonly">${esc(w.typeLabel||w.type)}</div></div><div class="field full"><label>Base URL</label><input data-wizard="provider-edit-url" value="${esc(w.baseUrl)}" placeholder="https://api.example.com/v1"></div>${hasCredential?`<div class="field"><label>Credential name</label><input data-wizard="provider-edit-identity" value="${esc(w.identity)}"></div><div class="field"><label>Protocol</label><select data-wizard="provider-edit-protocol">${['openai-chat','openai-responses','anthropic'].map(protocol=>`<option value="${protocol}" ${w.protocol===protocol?'selected':''}>${protocol}</option>`).join('')}</select></div>${modelEditor}`:'<div class="notice orange field full"><strong>No credential configured</strong><span>Add a connection before enabling this provider for traffic.</span></div>'}<label class="checkbox-field field full"><input type="checkbox" data-wizard="provider-edit-enabled" ${w.enabled?'checked':''}><span><strong>Enabled</strong><small>New requests may use this provider when its route is eligible.</small></span></label></div><div class="modal-foot"><button class="btn" data-action="close-overlay">Cancel</button><button class="btn primary" data-action="provider-save" data-id="${esc(modal.providerId)}">Save Changes</button></div></div></div>`
}

function connectionFormModal(modal){const w=state.wizard.connectionEdit;return `<div class="modal-backdrop" data-action="close-overlay"><div class="modal small" data-modal-stop><div class="modal-head"><h2>Edit Connection</h2><button class="btn icon ghost" data-action="close-overlay">×</button></div><div class="modal-body form-grid"><div class="field full"><label>Identity</label><input data-wizard="connection-edit-identity" value="${esc(w.identity)}"></div><div class="field full"><label>Credential reference</label><input data-wizard="connection-edit-credential" value="${esc(w.credentialRef)}"></div><div class="field full"><label>Upstream models</label><input data-wizard="connection-edit-models" value="${esc(w.models)}"></div><div class="field full"><label>Protocol</label><select data-wizard="connection-edit-protocol">${['openai-chat','openai-responses','anthropic'].map(x=>`<option ${w.protocol===x?'selected':''}>${x}</option>`).join('')}</select></div><div class="field full"><label>Capabilities</label><label><input type="checkbox" data-wizard="connection-edit-stream" ${w.stream?'checked':''}> Streaming</label> <label><input type="checkbox" data-wizard="connection-edit-tools" ${w.tools?'checked':''}> Tools</label></div></div><div class="modal-foot"><button class="btn" data-action="close-overlay">Cancel</button><button class="btn primary" data-action="connection-save" data-provider="${esc(modal.providerId)}" data-id="${esc(modal.connectionId)}">Save</button></div></div></div>`}

function revisionDetailModal(modal){const d=modal.detail||{},diff=d.diff||{};return `<div class="modal-backdrop" data-action="close-overlay"><div class="modal" data-modal-stop><div class="modal-head"><div><h2>Revision #${esc(d.revision)}</h2><div class="cell-sub">${esc(d.metadata?.actor||'system')} · ${esc(d.metadata?.source||'system')}</div></div><button class="btn icon ghost" data-action="close-overlay">×</button></div><div class="modal-body"><div class="notice"><strong>${esc(diff.summary||d.metadata?.summary||'Configuration revision')}</strong><span>${esc((diff.resources||[]).join(', ')||'No resource-level changes recorded.')}</span></div>${['added','changed','removed'].map(kind=>`<section class="section"><h3>${kind[0].toUpperCase()+kind.slice(1)}</h3><pre class="diff-block">${esc(JSON.stringify(diff[kind]||{},null,2))}</pre></section>`).join('')}</div><div class="modal-foot"><button class="btn" data-action="close-overlay">Close</button><button class="btn primary" data-action="revision-restore" data-id="${esc(d.revision)}">Restore Draft → Validate → Review → Apply</button></div></div></div>`}

function keyPolicyModal(modal){const w=state.wizard.keyPolicy;return `<div class="modal-backdrop" data-action="close-overlay"><div class="modal small" data-modal-stop><div class="modal-head"><div><h2>Edit API Key Access & Limits</h2><div class="cell-sub">${esc(w.name)} · client permissions and usage limits</div></div><button class="btn icon ghost" data-action="close-overlay">×</button></div><div class="modal-body"><div class="notice"><strong>Not a routing policy</strong><span>These settings only restrict what this API key may call and consume. They do not change Provider or Logical Model routing.</span></div><div class="form-grid section"><div class="field full"><label>Description</label><input data-wizard="policy-description" value="${esc(w.description)}" placeholder="Who or what uses this key"></div><div class="field full"><label>Models this key may use</label><input data-wizard="policy-models" value="${esc(w.models)}" placeholder="Blank allows all models"><span class="hint">Comma-separated Logical Model IDs. Leave blank for all.</span></div><div class="field full"><label>API protocols this key may use</label><input data-wizard="policy-protocols" value="${esc(w.protocols)}" placeholder="Blank allows all protocols"><span class="hint">For example: openai-chat, openai-responses.</span></div><div class="field"><label>Expiration (optional)</label><input type="datetime-local" data-wizard="policy-expires" value="${esc(w.expiresAt)}"></div><div class="field"><label>Requests per minute</label><input type="number" min="0" data-wizard="policy-rate" value="${esc(w.rate)}" placeholder="0 = unlimited"></div><div class="field full"><label>Monthly spend limit (USD)</label><input type="number" min="0" step="0.01" data-wizard="policy-budget" value="${esc(w.budget)}" placeholder="0 = unlimited"></div><label class="checkbox-field field full"><input type="checkbox" data-wizard="policy-exact-only" ${w.exactOnly?'checked':''}><span><strong>Exact compatibility only</strong><small>Reject safe mappings and cross-protocol conversion before any upstream attempt.</small></span></label></div></div><div class="modal-foot"><button class="btn" data-action="close-overlay">Cancel</button><button class="btn primary" data-action="key-policy-save" data-id="${esc(modal.keyId)}">Save Changes</button></div></div></div>`}
