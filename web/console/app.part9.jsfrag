<div class="divider"></div><div class="review-conversation-grid"><span>New requests<strong>Use route order in revision #${r.revision}</strong></span><span>Existing conversations<strong>${r.conversationStrategy==='migrate'?'Move on their next request':'Keep their current eligible route'}</strong></span><span>In-flight requests<strong>Finish on their current revision</strong></span></div><div class="notice routing-review-notice"><strong>A new configuration revision will be created.</strong><span>Only the checked recovery failures or no eligible connection advance to the next route. Client request errors stop immediately.</span></div></div><div class="modal-foot"><button class="btn" data-action="back-to-routing">Back</button><button class="btn primary" data-action="routing-apply" data-model="${esc(r.modelId)}">Apply Changes</button></div></div></div>`}

const providerProtocolMeta=[
  {id:'openai-chat',label:'OpenAI Chat',path:'/chat/completions',convertible:true},
