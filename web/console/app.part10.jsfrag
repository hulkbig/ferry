  if(action==='toggle-model'){try{const data=await ensureModel(el.dataset.id),model=data.model,nextEnabled=el.dataset.enable==='true';if(!nextEnabled&&!confirmConsole(`Disable logical model ${model.name||model.id}?\n\nNew requests for this model will stop routing. Existing conversation bindings may migrate or fail, while in-flight requests finish on their current revision.`))return;await adapter.updateModel(el.dataset.id,{enabled:nextEnabled});state.models=await adapter.getModels(state.overviewWindow);state.modelCache.delete(el.dataset.id);showToast(`Logical model ${nextEnabled?'enabled':'disabled'}`);render();}catch(e){showToast(e.message,'error')}return;}
  if(action==='model-save'){const w=state.wizard.model;if(!w.id.trim()){showToast('Model ID is required','error');return;}const firstOutputTimeoutSeconds=Number(w.firstOutputTimeoutSeconds);if(String(w.firstOutputTimeoutSeconds??'').trim()===''||!Number.isInteger(firstOutputTimeoutSeconds)||firstOutputTimeoutSeconds<0||firstOutputTimeoutSeconds>7200){showToast(nt('First output timeout must be an integer from 0 to 7200 seconds (0 disables it).','首输出等待上限须为 0 至 7200 秒的整数（0 关闭）。'),'error');return;}try{if(el.dataset.mode==='create')await adapter.createModel({id:w.id,display_name:w.name,description:w.description,first_output_timeout_seconds:firstOutputTimeoutSeconds,enabled:false,default_route:{steps:[]}});else await adapter.updateModel(w.id,{display_name:w.name,description:w.description,enabled:w.enabled,first_output_timeout_seconds:firstOutputTimeoutSeconds});state.models=await adapter.getModels(state.overviewWindow);state.modelCache.delete(w.id);closeOverlay();showToast(el.dataset.mode==='create'?'Model created disabled — configure routing before enabling':'Model revision applied');location.hash=resourceHash('models',w.id);render()}catch(e){showToast(e.message,'error')}return;}
  if(action==='delete-model'){try{const data=await ensureModel(el.dataset.id),m=data.model,routes=data.routes||[],overrides=data.overrides||[];if(!confirmConsole(`Delete logical model ${m.name||m.id}?\n\nFerry will automatically disable it and remove ${routes.length} route step${routes.length===1?'':'s'} and ${overrides.length} conditional rule${overrides.length===1?'':'s'}. Existing conversation bindings will be dropped; in-flight requests finish on their current revision. This cannot be undone except by restoring a previous revision.`))return;await adapter.deleteModel(el.dataset.id);state.models=await adapter.getModels(state.overviewWindow);state.modelCache.delete(el.dataset.id);closeOverlay();location.hash='#/models';render();showToast('Logical model deleted')}catch(e){showToast(e.message,'error')}return;}
  if(action==='add-override'){const data=await ensureModel(el.dataset.model);state.wizard.override=newOverrideWizard(data);state.modal={type:'override-form',modelId:el.dataset.model};renderPortal();return;}
  if(action==='edit-override'){const data=await ensureModel(el.dataset.model),o=data.overrides.find(x=>x.id===el.dataset.id)?.raw||data.overrides.find(x=>x.id===el.dataset.id)||{};state.wizard.override=newOverrideWizard(data,o);state.modal={type:'override-form',modelId:el.dataset.model,overrideId:el.dataset.id};renderPortal();return;}
  if(action==='override-route-up'||action==='override-route-down'){const i=Number(el.dataset.index),dir=action==='override-route-up'?-1:1;swap(state.wizard.override.customRoutes,i,i+dir);renderPortal();return;}
  if(action==='override-route-remove'){state.wizard.override.customRoutes.splice(Number(el.dataset.index),1);renderPortal();return;}
  if(action==='override-route-add'){const w=state.wizard.override,index=Number(w.customRouteChoice),route=w.routeChoices[index];if(!route){showToast('Select a route step first','error');return;}if(w.customRoutes.some(item=>overrideRouteKey(item)===overrideRouteKey(route))){showToast('That route is already in the custom route','error');return;}w.customRoutes.push(JSON.parse(JSON.stringify(route)));w.customRouteChoice='';renderPortal();return;}
  if(action==='override-up'||action==='override-down'){try{const data=await ensureModel(el.dataset.model),items=(data.overrides||[]).map(item=>JSON.parse(JSON.stringify(item.raw||item))),index=Number(el.dataset.index),next=index+(action==='override-up'?-1:1);if(index<0||next<0||next>=items.length)return;swap(items,index,next);await adapter.updateModel(el.dataset.model,{overrides:items});state.modelCache.delete(el.dataset.model);showToast('Conditional rule order applied');await loadAndRenderModel(el.dataset.model)}catch(e){showToast(e.message,'error')}return;}
  if(action==='override-save'){
    const w=state.wizard.override,id=w.id.trim(),name=w.name.trim();if(!id){showToast('Conditional rule ID is required','error');return;}if(!name){showToast('Conditional rule name is required','error');return;}if(Boolean(w.start)!==Boolean(w.end)){showToast('Set both the start and end time, or leave both blank','error');return;}
    const required={...w.required,min_context:Number(w.required?.min_context||0),min_output:Number(w.required?.min_output||0)},callers=[...new Set(w.callers.split(',').map(value=>value.trim()).filter(Boolean))];
    const input={id,name,enabled:Boolean(w.enabled),callers,protocols:[...(w.protocols||[])],weekdays:[...(w.weekdays||[])],timezone:w.timezone.trim(),...(w.start&&w.end?{time_window:{start:w.start,end:w.end}}:{}),required_capabilities:required,mode:w.mode};
    if(w.mode==='custom_route'){if(!w.customRoutes.length){showToast('A custom route needs at least one route step','error');return;}input.route={steps:w.customRoutes.map((route,index)=>index<w.customRoutes.length-1?overrideRouteStep(route,{recovery:true}):overrideRouteStep({...route,recoverOn:[]},{recovery:true}))};}
    else{input.prefer=w.defaultRoutes.filter((_,index)=>w.adjustments[index]==='prefer').map(route=>overrideRouteStep(route));input.avoid=w.defaultRoutes.filter((_,index)=>w.adjustments[index]==='avoid').map(route=>overrideRouteStep(route));if(!input.prefer.length&&!input.avoid.length){showToast('Choose at least one Prefer or Avoid action','error');return;}if(input.avoid.length>=w.defaultRoutes.length){showToast('Avoid cannot remove every default route step','error');return;}}
    try{if(el.dataset.id)await adapter.updateOverride(el.dataset.model,el.dataset.id,input);else await adapter.createOverride(el.dataset.model,input);state.modelCache.delete(el.dataset.model);closeOverlay();showToast('Conditional rule applied');await loadAndRenderModel(el.dataset.model)}catch(e){showToast(e.message,'error')}return;
  }
  if(action==='delete-override'){if(!confirmConsole('Delete this conditional rule and apply a new revision?'))return;try{await adapter.deleteOverride(el.dataset.model,el.dataset.id);state.modelCache.delete(el.dataset.model);showToast('Conditional rule deleted');await loadAndRenderModel(el.dataset.model)}catch(e){showToast(e.message,'error')}return;}
  if(action==='simulate-model'){const now=new Date(),local=new Date(now.getTime()-now.getTimezoneOffset()*60000).toISOString().slice(0,16);state.wizard.simulation={caller:'',protocol:'openai-chat',stream:false,at:local,required:{}};state.modal={type:'simulation',modelId:el.dataset.id};renderPortal();return;}
  if(action==='simulation-run'){const w=state.wizard.simulation;try{const at=w.at?new Date(w.at):null;if(at&&Number.isNaN(at.getTime()))throw new Error('Choose a valid simulation date and time');const required={...w.required,min_context:Number(w.required?.min_context||0),min_output:Number(w.required?.min_output||0)};state.modal={type:'simulation',modelId:el.dataset.model,loading:true};renderPortal();state.modal={type:'simulation',modelId:el.dataset.model,result:await adapter.simulateModel(el.dataset.model,{caller_id:w.caller.trim(),protocol:w.protocol,stream:Boolean(w.stream),...(at?{at:at.toISOString()}:{}),required_capabilities:required})};renderPortal()}catch(e){state.modal={type:'simulation',modelId:el.dataset.model};renderPortal();showToast(e.message,'error')}return;}
  if(action==='simulation-reset'){state.modal={type:'simulation',modelId:el.dataset.model};renderPortal();return;}
  if(action==='edit-provider'){const data=await ensureProvider(el.dataset.id),raw=data.provider.raw,connection=data.connections?.[0],firstModel=connection?.models?.[0],connectionCatalog=connectionModels(connection),providerCatalog=data.provider.upstreamModels||[];state.wizard.providerEdit={name:raw.name||data.provider.name,type:raw.type||(data.provider.logo==='codex'?'cliproxy-codex':'custom'),typeLabel:data.provider.type||raw.type||'Custom',baseUrl:raw.base_url||'',enabled:data.provider.enabled!==false,connectionId:connection?.id||'',connectionCount:data.connections?.length||0,identity:connection?.account||'',credentialType:connection?.type||'',credentialRef:connection?.raw?.credential_ref||'',models:(connectionCatalog.length?connectionCatalog:providerCatalog).join('\n'),modelSpecs:connection?.models||[],protocol:firstModel?.protocols?.[0]||'openai-chat',modelInput:'',modelOptions:[],modelFilter:'',modelsLoading:false,modelsLoaded:false,modelsError:''};state.modal={type:'provider-form',providerId:el.dataset.id};renderPortal();if(connection&&providerEditModelDiscoveryReady(state.wizard.providerEdit))await discoverProviderEditModels();return;}
  if(action==='provider-edit-model-discover'){await discoverProviderEditModels();return;}
  if(action==='provider-edit-model-add'){const w=state.wizard.providerEdit;if(!String(w.modelInput||'').trim()){showToast('Enter at least one model name','error');return;}addProviderEditModelNames(w,w.modelInput);renderPortal();return;}
  if(action==='provider-edit-model-remove'){const w=state.wizard.providerEdit;setProviderEditModelNames(w,providerEditModelNames(w).filter(model=>model!==el.dataset.model));renderPortal();return;}
  if(action==='provider-edit-model-toggle'){const w=state.wizard.providerEdit,models=providerEditModelNames(w),selected=models.includes(el.dataset.model);setProviderEditModelNames(w,selected?models.filter(model=>model!==el.dataset.model):[...models,el.dataset.model]);renderPortal();return;}
  if(action==='provider-edit-model-select-all'||action==='provider-edit-model-deselect-all'){const w=state.wizard.providerEdit,filter=String(w.modelFilter||'').trim().toLowerCase(),visible=(w.modelOptions||[]).filter(model=>!filter||model.toLowerCase().includes(filter));if(!visible.length)return;let configured=providerEditModelNames(w);if(action==='provider-edit-model-select-all')configured=[...new Set([...configured,...visible])];else configured=configured.filter(model=>!visible.includes(model));setProviderEditModelNames(w,configured);renderPortal();return;}
  if(action==='provider-save'){const w=state.wizard.providerEdit;if(!w.name.trim()){showToast('Provider name is required','error');return;}if(!/^https?:\/\//i.test(w.baseUrl)){showToast('An absolute HTTP(S) Base URL is required','error');return;}const models=providerEditModels(w);if(w.connectionId&&!models.length){showToast('At least one upstream model is required','error');return;}try{await adapter.updateProvider(el.dataset.id,{name:w.name.trim(),base_url:w.baseUrl.trim(),enabled:w.enabled});if(w.connectionId)await adapter.updateConnection(el.dataset.id,w.connectionId,{identity:w.identity.trim(),models});state.providerCache.delete(el.dataset.id);closeOverlay();showToast('Provider configuration saved');await refreshProviderResources(el.dataset.id)}catch(e){showToast(e.message,'error')}return;}
  if(action==='delete-provider'){
    try{const data=await ensureProvider(el.dataset.id),p=data.provider,models=providerModels(p);const modelList=models.join(', ')||'none';if(!confirmConsole(`Delete provider ${p.name}?\n\nFerry will automatically disable it, delete its endpoint and credential configuration, and detach it from these Logical Model routes: ${modelList}. Models left without a default route will be disabled, and existing conversations will migrate or fail if no route remains. In-flight requests finish on their current revision.`))return;await adapter.deleteProvider(el.dataset.id);state.providerCache.delete(el.dataset.id);state.modelCache.clear();state.providers=await adapter.getProviders();state.models=await adapter.getModels(state.overviewWindow);location.hash='#/providers';showToast('Provider and dependent route references deleted');render();}catch(e){showToast(e.message,'error')}return;
  }
  if(action==='provider-requests'){await openReportRequests({...nextRequestWindow(),...nextScope({provider:el.dataset.id})});return;}
  if(action==='copy-debug'){const request=state.requestCache.get(el.dataset.id),value=request?.debug?.[el.dataset.side];try{await navigator.clipboard.writeText(prettyDebug(value));showToast(`Debug ${el.dataset.side} copied`)}catch{showToast('Copy failed','error')}return;}
  if(action==='revision-detail'){try{state.modal={type:'revision-detail',detail:await adapter.getRevision(el.dataset.id)};renderPortal()}catch(e){showToast(e.message,'error')}return;}
  if(action==='revision-restore'){if(!confirmConsole(`Restore revision #${el.dataset.id}? The server will validate, review, and apply it as a new immutable revision.`))return;try{const result=await adapter.restoreRevision(el.dataset.id);state.revisions=await adapter.getRevisions();closeOverlay();showToast(`Revision #${result.revision} restored`);await boot()}catch(e){showToast(e.message,'error')}return;}
});

setInterval(()=>{if(currentRoute().section==='settings'&&!state.pricingRefreshing)refreshPricingStatus()},30000);
