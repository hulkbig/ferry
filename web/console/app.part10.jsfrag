
function showToast(message,type='success',options={}){let t=document.querySelector('.toast');if(!t){t=document.createElement('div');t.className='toast';document.body.appendChild(t)}const title=options.title||(type==='error'?'Action failed':'Completed'),detail=options.detail||message;t.replaceChildren();const copy=document.createElement('div');copy.className='toast-copy';const heading=document.createElement('strong');heading.textContent=title;const body=document.createElement('span');body.textContent=detail;copy.append(heading,body);const actions=document.createElement('div');actions.className='toast-actions';if(type==='error'){const copyButton=document.createElement('button');copyButton.type='button';copyButton.textContent='Copy details';copyButton.addEventListener('click',()=>copyText(detail).then(()=>{copyButton.textContent=translatedConsoleText('Copied')}));actions.append(copyButton)}const close=document.createElement('button');close.type='button';close.setAttribute('aria-label','Close notification');close.textContent='×';close.addEventListener('click',()=>t.classList.remove('show'));actions.append(close);t.append(copy,actions);localizeDOM(t);t.className=`toast ${type}`;t.setAttribute('role',type==='error'?'alert':'status');requestAnimationFrame(()=>t.classList.add('show'));clearTimeout(showToast.timer);if(type!=='error')showToast.timer=setTimeout(()=>t.classList.remove('show'),6000)}
async function copyText(value){if(navigator.clipboard?.writeText){await navigator.clipboard.writeText(value);return;}const input=document.createElement('textarea');input.value=value;input.setAttribute('readonly','');input.style.position='fixed';input.style.opacity='0';document.body.appendChild(input);input.select();const copied=document.execCommand('copy');input.remove();if(!copied)throw new Error('Copy is not available in this browser')}
async function runConnectionTest(providerId,connectionId){
  const key=connectionTestKey(providerId,connectionId),current=state.connectionTests.get(key);if(current?.loading)return current.promise;
  const test={loading:true,startedAt:Date.now(),model:'Selected upstream model',result:null,error:'',promise:null};state.connectionTests.set(key,test);render();
  test.promise=(async()=>{
    let providerLoaded=false,result;
    try{const data=await ensureProvider(providerId),connection=data.connections.find(item=>item.id===connectionId);providerLoaded=true;test.model=connection?.models?.[0]?.upstream_model||test.model;result=await adapter.testConnection(providerId,connectionId)}
    catch(error){test.error=error.message;result={ok:false,failure:{message:error.message}}}
    test.result=result;
    if(providerLoaded){state.providerCache.delete(providerId);try{await refreshProviderResources(providerId)}catch(error){showToast(error.message,'error',{title:'Provider status refresh failed'})}}
    const model=test.model;
    const detail=result.ok?`Validated ${result.tested_model||model} over ${result.protocol||'its native protocol'} in ${result.latency_ms}ms.`:`${result.failure?.message||'Connection validation failed.'} Tested ${result.tested_model||model}${result.protocol?` over ${result.protocol}`:''}.`;
    showToast(detail,result.ok?'success':'error',{title:result.ok?'Connection test passed':'Connection test failed'});return result;
  })().finally(()=>{test.loading=false;test.promise=null;render()});
  return test.promise;
}
async function refreshApiKeysInBackground(){try{state.apiKeys=await adapter.getApiKeys();render()}catch(error){showToast(`API key list refresh failed: ${error.message}`,'error')}}
async function revealManagedApiKey(id,{copy=false}={}){try{const result=await adapter.revealApiKey(id);if(copy){await copyText(result.key);showToast('API key copied');return;}const item=state.apiKeys.find(key=>key.id===id);state.modal={type:'key-reveal',key:result.key,name:result.name||item?.name||id,existing:true};renderPortal()}catch(error){showToast(error.message,'error')}}
let requestAutoTimer;
function configureRequestAutoRefresh(){clearInterval(requestAutoTimer);if(state.requestAutoRefresh)requestAutoTimer=setInterval(()=>{if(state.auth?.authenticated&&currentRoute().section==='requests'&&!state.requestLoading&&!state.requestExporting&&!document.activeElement?.matches('input,select,textarea')){const id=currentRoute().id;if(id)loadAndRenderRequest(id);else reloadRequests()}},3000)}
function csvCell(value){const text=String(value??''),safe=typeof value==='string'&&/^\s*[=+\-@]/u.test(text)?`'${text}`:text;return `"${safe.replaceAll('"','""')}"`}
function requestExportRow(item){
  const raw=item.raw||item,usage=raw.usage||{};
  return {id:raw.id??item.id,timestamp:raw.timestamp??item.timestamp??item.time,logical_model_id:raw.logical_model_id??item.logicalModel??item.model,conversation_id:raw.conversation_id??item.conversation,caller:raw.caller??item.apiKey,provider_id:raw.provider_id??item.providerId,connection_id:raw.connection_id??item.connectionId,upstream_model:raw.upstream_model??item.upstreamModel,response_model:raw.response_model??item.responseModel??'',service_tier:raw.service_tier??item.serviceTier??'',response_service_tier:raw.response_service_tier??item.responseServiceTier??'',outcome:raw.outcome??(item.canceled?'CANCELED':item.failed?'FAILED':item.recovered?'RECOVERED_SUCCESS':'DIRECT_SUCCESS'),status:raw.status??(item.canceled?'canceled':item.failed?'failed':'success'),failure_type:raw.failure_type??'',failure_message:raw.failure_message??item.failureMessage??'',protocol:raw.protocol??item.protocol??'',stream:raw.stream??item.stream,ttft_ms:raw.ttft_ms??'',duration_ms:raw.duration_ms??'',attempts:raw.attempts??item.attempts,runtime_revision:raw.runtime_revision??'',input_tokens:usage.input_tokens??item.inputTokens??'',output_tokens:usage.output_tokens??item.outputTokens??'',cache_read_tokens:usage.cache_read_tokens??item.cacheReadTokens??'',cache_write_tokens:usage.cache_write_tokens??item.cacheWriteTokens??'',reasoning_tokens:usage.reasoning_tokens??item.reasoningTokens??'',connection_rebind_count:raw.connection_rebind_count??item.connectionRebinds??'',provider_fallback_count:raw.provider_fallback_count??item.providerFallbacks??'',conversation_migration_count:raw.conversation_migration_count??'',recovery_added_latency_ms:raw.recovery_added_latency_ms??''};
}
function exportRows(rows,format,name){const clean=JSON.parse(JSON.stringify(rows||[]));let body,type,ext;if(format==='csv'){const flat=clean.map(requestExportRow),headers=Object.keys(flat[0]||requestExportRow({}));body=`\uFEFF${[headers.map(csvCell).join(','),...flat.map(row=>headers.map(key=>csvCell(row[key])).join(','))].join('\r\n')}`;type='text/csv;charset=utf-8';ext='csv'}else{body=JSON.stringify(clean,null,2);type='application/json';ext='json'}const url=URL.createObjectURL(new Blob([body],{type})),a=document.createElement('a');a.href=url;a.download=`${name}-${new Date().toISOString().slice(0,10)}.${ext}`;a.click();setTimeout(()=>URL.revokeObjectURL(url),0)}
async function exportRequests(format){
  if(state.requestExporting)return;state.requestExporting=true;render();
  try{
    const filters=requestFilters({limit:1000,offset:0}),to=filters.to?new Date(filters.to):new Date(),windowMS={'15m':900000,'1h':3600000,'24h':86400000,'168h':604800000,'720h':2592000000}[filters.window]||900000;
    filters.to=to.toISOString();if(!filters.from)filters.from=new Date(to.getTime()-windowMS).toISOString();
    const rows=[],seenIDs=new Set();let offset=0,reportedTotal=null;
    do{const page=await adapter.getRequests({...filters,limit:1000,offset}),pageTotal=Number(page.total??page.length);if(!Number.isSafeInteger(pageTotal)||pageTotal<0)throw new Error('The request ledger returned an invalid total. Retry the export.');if(reportedTotal===null)reportedTotal=pageTotal;else if(pageTotal!==reportedTotal)throw new Error('The request ledger changed during export. Retry to capture one complete result set.');for(const item of page){const id=item.raw?.id??item.id;if(!id)throw new Error('A request has no stable ID. Retry the export.');if(seenIDs.has(id))throw new Error('The request ledger changed during export and repeated a request. Retry to capture one complete result set.');seenIDs.add(id);rows.push(item)}offset+=page.length;if(!page.length)break;}while(offset<reportedTotal);
    if(rows.length!==reportedTotal)throw new Error(`The request ledger changed during export (${rows.length} of ${reportedTotal} rows collected). Retry to capture one complete result set.`);
    const exact=rows.map(item=>item.raw?JSON.parse(JSON.stringify(item.raw)):requestExportRow(item));
    if(format==='csv')exportRows(rows,'csv','ferry-requests');else exportRows({schema_version:1,exported_at:new Date().toISOString(),filters:{...filters,limit:undefined,offset:undefined},reported_total:reportedTotal??0,exported_count:exact.length,requests:exact},'json','ferry-requests');
    showToast(`Exported ${exact.length} matching request${exact.length===1?'':'s'}`);
  }catch(error){showToast(`Request export failed: ${error.message}`,'error')}
  finally{state.requestExporting=false;render()}
}

function swap(arr,a,b){const tmp=arr[a];arr[a]=arr[b];arr[b]=tmp;}
function closeOverlay(){if(state.modal?.type==='codex-usage-reset-confirm'){dismissCodexUsageReset();return;}stopOAuthDeviceWatch();state.drawer=null;state.modal=null;state.routingReview=null;state.routingValidationErrors=null;renderPortal();}
let oauthDeviceTimer=null,oauthDeviceGeneration=0;
function stopOAuthDeviceWatch(){oauthDeviceGeneration++;if(oauthDeviceTimer){clearInterval(oauthDeviceTimer);oauthDeviceTimer=null;}}
function startOAuthDeviceWatch(providerId,connectionId){
  stopOAuthDeviceWatch();
  const generation=oauthDeviceGeneration,interval=Math.max(3,Number(state.modal?.intervalSeconds)||5)*1000;
  const tick=async()=>{
    if(oauthDeviceGeneration!==generation||state.modal?.type!=='oauth-device')return stopOAuthDeviceWatch();
    try{
      const status=await adapter.getConnectionOAuthStatus(providerId,connectionId);
      if(oauthDeviceGeneration!==generation||state.modal?.type!=='oauth-device')return;
      if(status.login&&status.login.status==='failed'){state.modal.error=status.login.error||'Codex device authorization failed.';renderPortal();return;}
      if(!status.login){
        stopOAuthDeviceWatch();
        closeOverlay();
        showToast('Codex sign-in completed');
        invalidateProviderCodexUsage(providerId,connectionId);
        try{await refreshProviderResources(providerId);}catch(e){}
        await loadSharedCodexUsage(providerId,connectionId,{refresh:true});
        return;
      }
      state.modal.userCode=status.login.userCode||state.modal.userCode;
      state.modal.verificationUrl=status.login.verificationUrl||state.modal.verificationUrl;
    }catch(e){/* transient poll failures keep the watch; the server expires the attempt */}
  };
  oauthDeviceTimer=setInterval(tick,interval);
}
async function refreshProviderResources(providerId){
  state.providerCache.delete(providerId);
  state.providers=await adapter.getProviders();
  state.models=await adapter.getModels(state.overviewWindow);
  state.modelCache.clear();
  const route=currentRoute();
  if(route.section==='providers'&&route.id===providerId) state.providerCache.set(providerId,await adapter.getProvider(providerId));
  render();
}
function connectionImpactText(provider,connection){
  const models=providerModels(provider), upstream=connectionModels(connection);
  const routeText=models.length?`Logical model routes affected: ${models.join(', ')}.`:'No logical model route currently references this provider.';
  const supplyText=upstream.length?` Upstream supply: ${upstream.join(', ')}.`:'';
  return `${routeText}${supplyText} ${connection.conversations||0} active conversation bindings may be affected.`;
}
function overrideRouteKey(route){return `${route.id||route.provider_id}\u0000${route.model||route.upstream_model}`}
function overrideUIRoute(step,data){const id=step.id||step.provider_id,model=step.model||step.upstream_model,known=(data.routes||[]).find(route=>route.id===id&&route.model===model),provider=state.providers.find(item=>item.id===id),recovery=Object.hasOwn(step,'recover_on')?step.recover_on:Object.hasOwn(step,'recoverOn')?step.recoverOn:[];return {id,provider:known?.provider||provider?.name||id,model,status:known?.status||provider?.status||'Unknown',recoverOn:[...(recovery||[])]}}
function newOverrideWizard(data,raw={}){
  const defaults=normalizeRoutingRoutes(data.routes||[]),preferred=new Set((raw.prefer||[]).map(overrideRouteKey)),avoided=new Set((raw.avoid||[]).map(overrideRouteKey));
  const adjustments=defaults.map(route=>preferred.has(overrideRouteKey(route))?'prefer':avoided.has(overrideRouteKey(route))?'avoid':'normal');
  const customRoutes=(raw.route?.steps||[]).map(step=>overrideUIRoute(step,data)),routeChoices=[],seen=new Set(),addChoice=route=>{const key=overrideRouteKey(route);if(route.id&&route.model&&!seen.has(key)){seen.add(key);routeChoices.push(route)}};defaults.forEach(route=>addChoice(JSON.parse(JSON.stringify(route))));customRoutes.forEach(route=>addChoice(JSON.parse(JSON.stringify(route))));for(const provider of state.providers){const catalog=provider.raw?.model_catalog?.map(item=>item.upstream_model)||provider.upstreamModels||[];for(const model of catalog)addChoice({id:provider.id,provider:provider.name,model,status:provider.status,serving:0,recoverOn:[]});}
  return {id:raw.id||'',name:raw.name||'',enabled:raw.enabled??true,callers:(raw.callers||[]).join(', '),protocols:[...(raw.protocols||[])],weekdays:[...(raw.weekdays||[])],timezone:raw.timezone||'',start:raw.time_window?.start||'',end:raw.time_window?.end||'',required:{...(raw.required_capabilities||{})},mode:raw.mode||'adjust_default',defaultRoutes:defaults,routeChoices,adjustments,customRoutes,customRouteChoice:''};
}
function overrideRouteStep(route,{recovery=false}={}){return {provider_id:route.id,upstream_model:route.model,...(recovery?{recover_on:[...(route.recoverOn||[])]}:{})}}
function providerEditModelNames(w){return [...new Set(String(w?.models||'').split(/[\n,]/).map(value=>value.trim()).filter(Boolean))]}
function setProviderEditModelNames(w,names){w.models=[...new Set((names||[]).map(value=>String(value).trim()).filter(Boolean))].join('\n')}
function addProviderEditModelNames(w,values){setProviderEditModelNames(w,[...providerEditModelNames(w),...String(values||'').split(/[\n,]/)]);w.modelInput=''}
function providerEditModels(w){const names=providerEditModelNames(w),existing=new Map((w.modelSpecs||[]).map(model=>[model.upstream_model,model]));return names.map(upstreamModel=>{const current=existing.get(upstreamModel);return {upstream_model:upstreamModel,protocols:[w.protocol],capabilities:providerNormalizedModelCapabilities(w.protocol,upstreamModel,current?.capabilities||{text:true,stream:true,tools:true}),...(current?.plan_id?{plan_id:current.plan_id}:{})}})}
function providerModelDiscoveryReady(w){return w?.type==='cliproxy-codex'||(/^https?:\/\//i.test(w?.baseUrl||'')&&((w.authType==='Existing Credential'&&Boolean(w.credentialRef))||(w.authType!=='Existing Credential'&&Boolean(w.secret))))}
async function discoverProviderModels(){const w=state.wizard.provider;if(!w||w.modelsLoading)return;if(!providerModelDiscoveryReady(w)){showToast('Complete Base URL and credential before loading models','error');return;}w.modelsLoading=true;w.modelsError='';renderPortal();try{const models=await adapter.discoverProviderModels({type:w.type,baseUrl:w.baseUrl,protocol:w.protocol,secret:w.secret,credentialRef:w.credentialRef});w.modelOptions=[...new Set(models.map(model=>String(model).trim()).filter(Boolean))];w.models=(w.models||[]).filter(model=>w.modelOptions.includes(model));w.modelsLoaded=true;if(!w.modelOptions.length)w.modelsError='The upstream returned no models.';}catch(error){w.modelOptions=[];w.models=[];w.modelsLoaded=false;w.modelsError=error.message||'Unable to load models.';}finally{w.modelsLoading=false;renderPortal()}}
function updateProviderModelFilterUI(){const w=state.wizard.provider,q=String(w?.modelFilter||'').trim().toLowerCase();let visible=0;portal.querySelectorAll('[data-provider-model-row]').forEach(row=>{const matches=!q||String(row.dataset.search||'').includes(q);row.hidden=!matches;if(matches)visible++});const counter=portal.querySelector('[data-provider-model-visible]');if(counter)counter.textContent=`${visible} shown`}
function providerEditModelDiscoveryReady(w){return w?.type==='cliproxy-codex'||(/^https?:\/\//i.test(w?.baseUrl||'')&&(Boolean(w.credentialRef)||demoMode))}
async function discoverProviderEditModels(){const w=state.wizard.providerEdit;if(!w||w.modelsLoading)return;if(!providerEditModelDiscoveryReady(w)){w.modelsError='A configured credential is required to load the upstream catalog.';w.modelsLoaded=false;renderPortal();return;}w.modelsLoading=true;w.modelsError='';renderPortal();try{const models=await adapter.discoverProviderModels({type:w.type,baseUrl:w.baseUrl,protocol:w.protocol,credentialRef:w.credentialRef});if(state.wizard.providerEdit!==w)return;w.modelOptions=[...new Set(models.map(model=>String(model).trim()).filter(Boolean))];w.modelsLoaded=true;if(!w.modelOptions.length)w.modelsError='The upstream returned no models.';}catch(error){if(state.wizard.providerEdit!==w)return;w.modelOptions=[];w.modelsLoaded=false;w.modelsError=error.message||'Unable to load models.';}finally{if(state.wizard.providerEdit===w){w.modelsLoading=false;renderPortal()}}}
function updateProviderEditModelFilterUI(){const w=state.wizard.providerEdit,q=String(w?.modelFilter||'').trim().toLowerCase();let visible=0;portal.querySelectorAll('[data-provider-edit-model-row]').forEach(row=>{const matches=!q||String(row.dataset.search||'').includes(q);row.hidden=!matches;if(matches)visible++});const counter=portal.querySelector('[data-provider-edit-model-visible]');if(counter)counter.textContent=`${visible} shown`}

async function refreshManagementSecurity(){
  const [tokens,events]=await Promise.all([adapter.getManagementTokens(),adapter.getSecurityEvents()]);
  state.managementTokens=tokens;state.securityEvents=events;
}

app.addEventListener('click', async (event) => {
  const el=event.target.closest('[data-action]');
  if(!el) return;
  const action=el.dataset.action;
  if(action==='publish-codex-version'){
    if(state.codexVersionPublishing)return;
    const version=String(state.codexVersionDraft??state.settings?.codex_client_version??'').trim();
    if(version&&!/^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)(-[0-9A-Za-z]+([.-][0-9A-Za-z]+)*)?$/.test(version)){showToast('Enter a semantic version, or leave blank to use the automatic or bundled version.','error');return;}
    const options={codex_auto_update:state.codexAutoUpdateDraft??state.settings?.codex_auto_update??false,codex_release_channel:state.codexReleaseChannelDraft??state.settings?.codex_release_channel??'stable'};
    const effective=version||(options.codex_auto_update?translatedConsoleText('Automatic GitHub updates')+' / '+options.codex_release_channel:state.settings?.codex_auto_version||state.settings?.codex_default_client_version||'0.153.0');
    if(!confirm(translatedConsoleText('Publish Codex client version')+' '+effective+'? '+translatedConsoleText('Existing models and custom routes will be retained.')))return;
    state.codexVersionPublishing=true;render();
    try{state.settings=await adapter.publishCodexClientVersion(version,state.settings?.revision||0,options);state.codexVersionDraft=undefined;state.codexAutoUpdateDraft=undefined;state.codexReleaseChannelDraft=undefined;showToast('Codex client version published');}
    catch(error){if(error.status===409){try{state.settings=await adapter.getSettings()}catch{}}showToast(error.message,'error');}
    finally{state.codexVersionPublishing=false;render();}return;
  }
  if(action.startsWith('codex-usage-reset-')){await handleCodexUsageResetAction(action,el);return;}
  if(action==='backup-save'){el.disabled=true;try{await saveBackupPolicy(el.closest('[data-backup-settings]'));showToast('Backup policy saved');render()}catch(error){showToast(error.message,'error');el.disabled=false}return;}

  if(action==='show-request-cost'){const request=requestDataSync(el.dataset.id);if(request){state.modal={type:'request-cost',request};renderPortal()}return;}
  if(action==='reload'){location.reload();return;}
  if(action==='logout'){try{await adapter.logout();clearCodexUsageResetState();state.modal=null;state.auth={initialized:true,authenticated:false,username:state.auth?.username};render();}catch(e){showToast(e.message,'error')}return;}
  if(action==='change-password'){state.modal={type:'change-password'};renderPortal();return;}
  if(action==='create-management-token'){state.modal={type:'create-management-token'};renderPortal();return;}
  if(action==='management-token-edit'){const token=state.managementTokens.find(item=>item.id===el.dataset.id);if(!token){showToast('Management token not found','error');return;}state.modal={type:'edit-management-token',token};renderPortal();return;}
  if(action==='copy-skill-install'){try{await copyText(ferrySkillInstallPrompt());showToast('Copied to clipboard')}catch(e){showToast(e.message||'Copy failed','error')}return;}
  if(action==='copy-management-token'){try{await copyText(state.modal?.secret||'');showToast('Management token copied')}catch(e){showToast(e.message||'Copy failed','error')}return;}
  if(action==='management-token-toggle'){try{await adapter.updateManagementToken(el.dataset.id,{enabled:el.dataset.enabled==='true'});await refreshManagementSecurity();showToast(`Management token ${el.dataset.enabled==='true'?'enabled':'disabled'}`);render();}catch(e){showToast(e.message,'error');render()}return;}
  if(action==='management-token-rotate'){if(!confirmConsole('Rotate this management token? The current value stops working immediately.'))return;try{const current=state.managementTokens.find(token=>token.id===el.dataset.id),result=await adapter.rotateManagementToken(el.dataset.id);await refreshManagementSecurity();state.modal={type:'management-token-reveal',secret:result.secret,name:current?.name||el.dataset.id,rotated:true};renderPortal();showToast('Management token rotated')}catch(e){showToast(e.message,'error')}return;}
  if(action==='management-token-revoke'){if(!confirmConsole('Permanently revoke this management token? Any Skill using it will immediately lose access.'))return;try{await adapter.revokeManagementToken(el.dataset.id);await refreshManagementSecurity();showToast('Management token revoked');render();}catch(e){showToast(e.message,'error')}return;}
  if(action==='management-token-delete'){if(!confirmConsole('Delete this revoked management token metadata?'))return;try{await adapter.deleteManagementToken(el.dataset.id);await refreshManagementSecurity();showToast('Management token deleted');render();}catch(e){showToast(e.message,'error')}return;}
  if(action==='mobile-menu'){state.mobileNav=!state.mobileNav;render();return;}
  if(action==='refresh'){await boot();showToast('Runtime view refreshed');return;}
  if(action==='goto-models'){location.hash='#/models';return;}
  if(action==='open-model'){location.hash=resourceHash('models',el.dataset.id);return;}
  if(action==='open-provider'){location.hash=`#/providers/${el.dataset.id}`;return;}
  if(action==='open-request'){location.hash=`#/requests/${el.dataset.id}`;return;}
  if(action==='open-conversation-trail'){const conversationId=el.dataset.conversation,currentRequestId=el.dataset.id;if(!conversationId||conversationId==='—')return;state.drawer={type:'conversation',conversationId,currentRequestId,error:''};renderPortal();try{await loadConversationRequests(conversationId,{force:true})}catch{}return;}
  if(action==='conversation-request'){await inspectConversationRequest(el.dataset.id);return;}
  if(action==='conversation-step'){const drawer=state.drawer;if(!drawer||drawer.type!=='conversation')return;const list=state.conversationCache.get(drawer.conversationId)||[],index=list.findIndex(item=>item.id===drawer.currentRequestId),next=list[index+Number(el.dataset.direction||0)];if(next)await inspectConversationRequest(next.id);return;}
  if(action==='conversation-view-all'){clearReportFilters();const conversationId=el.dataset.conversation;Object.assign(state,{requestSearch:'',requestConversation:conversationId,requestFilter:'all',requestWindow:'720h',requestModel:'',requestProvider:'',requestApiKey:'',requestConnection:'',requestFailureType:'',requestStatus:'',requestRevision:'',requestFrom:'',requestTo:'',requestOffset:0});closeOverlay();location.hash='#/requests';await reloadRequests();return;}
  if(action==='requests-page'){location.hash='#/requests';return;}
  if(action==='request-search-submit'){forgetReportLocation();state.requestOffset=0;await reloadRequests();return;}
  if(action==='request-page'){state.requestOffset=Number(el.dataset.offset||0);await reloadRequests();return;}
  if(action==='request-clear'){clearReportFilters();Object.assign(state,{requestSearch:'',requestConversation:'',requestFilter:'all',requestModel:'',requestProvider:'',requestApiKey:'',requestConnection:'',requestFailureType:'',requestStatus:'',requestRevision:'',requestFrom:'',requestTo:'',requestOffset:0});await reloadRequests();return;}
  if(action==='request-auto'){state.requestAutoRefresh=el.checked;configureRequestAutoRefresh();render();return;}
  if(action==='request-export'){await exportRequests(el.dataset.format==='csv'?'csv':'json');return;}
  if(action==='billing-export'){if(!state.billing.reconciliation){showToast('Reconciliation export requires recorded API usage','error');return;}exportRows(state.billing.reconciliation, 'json','ferry-usage-reconciliation');return;}
  if(action==='billing-tab'){location.hash='#/billing';return;}
  if(action==='insights-toggle'){state.insightsOpen=!state.insightsOpen;render();return;}
  if(action==='insights-link'){state.insightsOpen=false;render();return;}
  if(action==='alerts-open'){try{const envelope=await adapter.getAlerts();state.alerts=envelope.alerts||[];state.alertUnread=Number(envelope.unread||0);state.drawer={type:'alerts'};renderPortal();render();}catch(e){showToast(e.message,'error')}return;}
